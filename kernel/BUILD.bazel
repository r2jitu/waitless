load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "types_rs",
    srcs = ["types.rs"],
    crate_name = "kernel_types",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "mmu_rs",
    srcs = ["mmu.rs"],
    crate_name = "kernel_mmu",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "exceptions_rs",
    srcs = ["exceptions.rs"],
    crate_name = "kernel_exceptions",
    edition = "2024",
    deps = [":fdt_rs", ":serial_rs"],
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "fdt_rs",
    srcs = ["fdt.rs"],
    crate_name = "kernel_fdt",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "serial_rs",
    srcs = ["serial.rs"],
    crate_name = "kernel_serial",
    edition = "2024",
    deps = [":fdt_rs"],
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "mm_rs",
    srcs = ["mm.rs"],
    crate_name = "kernel_mm",
    edition = "2024",
    deps = [":serial_rs", ":types_rs"],
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# Compiler-required memory intrinsics (memcpy, memset, etc.)
rust_static_library(
    name = "libc_rs",
    srcs = ["libc.rs"],
    crate_name = "kernel_libc",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# Wrap libc_rs as cc_library for linking into cc_binary
cc_library(
    name = "libc",
    deps = [":libc_rs"],
    alwayslink = True,  # memcpy etc. must not be stripped
)

cc_library(
    name = "boot",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/boot.S"],
        "//bazel/platforms:aarch64": ["aarch64/boot.S"],
        "//conditions:default": ["x86_64/boot.S"],
    }),
)

# Limine boot entry point (Rust): declares Limine requests in
# .limine_requests section and calls kernel_boot_from_bootinfo.
rust_static_library(
    name = "limine_entry_rs",
    srcs = ["limine_entry.rs"],
    crate_name = "limine_entry",
    edition = "2024",
    deps = [":types_rs", ":fdt_rs", ":mmu_rs"],
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# x86_64 SSE enable stub (ASM) — called before Rust limine_entry_cpp().
cc_library(
    name = "limine_boot_asm",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/limine_boot.S"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "limine_entry",
    deps = [":limine_entry_rs", ":limine_boot_asm"],
    alwayslink = True,  # Limine requests must not be stripped by linker
)

# x86_64 arch initialization (GDT + IDT) in Rust + assembly ISR stubs.
# The Rust code (gdt.rs, idt.rs) is compiled as a rust_library.
# The ISR stub assembly (idt_stubs.S) is compiled as a cc_library.
rust_library(
    name = "x86_init_rs",
    srcs = ["x86_64/x86_init.rs"] + select({
        "//bazel/platforms:x86_64": ["x86_64/gdt.rs", "x86_64/idt.rs"],
        "//conditions:default": [],
    }),
    crate_name = "x86_init",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"],
)

# ISR stub assembly — provides isr_stub_table and isr_common.
cc_library(
    name = "idt_stubs",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/idt_stubs.S"],
        "//conditions:default": [],
    }),
    alwayslink = True,  # ISR stubs must not be stripped
)

rust_static_library(
    name = "entry_rs",
    srcs = ["entry.rs"],
    crate_name = "kernel_entry",
    edition = "2024",
    deps = [
        ":types_rs",
        ":serial_rs",
        ":mm_rs",
        ":fdt_rs",
        ":mmu_rs",
        ":exceptions_rs",
        ":x86_init_rs",
        "//drivers:drivers_rs",
        "//net:stack_rs",
        "//uni:unikernel",
    ],
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "entry",
    deps = [
        ":limine_entry",
        ":idt_stubs",
        ":libc",
    ],
)
