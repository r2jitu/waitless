load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "arch_h",
    hdrs = ["arch.h"] + select({
        "//bazel/platforms:aarch64": [
            "aarch64/arch.h",
            "aarch64/timer.h",
        ],
        "//bazel/platforms:x86_64": [
            "x86_64/arch.h",
        ],
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

cc_library(
    name = "fdt",
    hdrs = select({
        "//bazel/platforms:aarch64": ["aarch64/fdt.h"],
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

cc_library(
    name = "mmu",
    hdrs = select({
        "//bazel/platforms:aarch64": ["aarch64/mmu.h"],
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

rust_library(
    name = "mmu_rs",
    srcs = ["mmu.rs"],
    crate_name = "kernel_mmu",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "exceptions_rs",
    srcs = ["exceptions.rs"],
    crate_name = "kernel_exceptions",
    edition = "2024",
    deps = [":fdt_rs", ":serial_rs"],
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "fdt_rs",
    srcs = ["fdt.rs"],
    crate_name = "kernel_fdt",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "serial_rs",
    srcs = ["serial.rs"],
    crate_name = "kernel_serial",
    edition = "2024",
    deps = [":fdt_rs"],
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

rust_library(
    name = "mm_rs",
    srcs = ["mm.rs"],
    crate_name = "kernel_mm",
    edition = "2024",
    deps = [":serial_rs"],
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "boot_info",
    hdrs = ["boot_info.h"],
    copts = ["-I."],
)

cc_library(
    name = "core",
    srcs = [
        "libc.cc",
        "serial_printf.cc",
    ],
    hdrs = [
        "serial.h",
        "mm.h",
        "panic.h",
    ] + select({
        "//bazel/platforms:x86_64": ["x86_64/serial.h"],
        "//conditions:default": [],
    }),
    deps = [":arch_h", ":boot_info", ":fdt"],
    copts = ["-I."],
)

cc_library(
    name = "arch_init",
    srcs = select({
        "//bazel/platforms:x86_64": [
            "x86_64/gdt.cc",
            "x86_64/idt.cc",
        ],
        "//bazel/platforms:aarch64": [],
        "//conditions:default": [
            "x86_64/gdt.cc",
            "x86_64/idt.cc",
        ],
    }),
    hdrs = select({
        "//bazel/platforms:x86_64": [
            "x86_64/gdt.h",
            "x86_64/idt.h",
        ],
        "//bazel/platforms:aarch64": ["aarch64/exceptions.h"],
        "//conditions:default": [
            "x86_64/gdt.h",
            "x86_64/idt.h",
        ],
    }),
    deps = select({
        "//bazel/platforms:aarch64": [],
        "//conditions:default": [":core", ":fdt"],
    }),
    copts = ["-I."],
)

cc_library(
    name = "boot",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/boot.S"],
        "//bazel/platforms:aarch64": ["aarch64/boot.S"],
        "//conditions:default": ["x86_64/boot.S"],
    }),
)

cc_library(
    name = "limine_proto",
    hdrs = ["limine.h"],
    copts = ["-I."],
)

cc_library(
    name = "limine_entry",
    srcs = ["limine_entry.cc"] + select({
        "//bazel/platforms:x86_64": ["x86_64/limine_boot.S"],
        "//conditions:default": [],
    }),
    deps = [":boot_info", ":limine_proto", ":fdt"] + select({
        "//bazel/platforms:aarch64": [":mmu"],
        "//conditions:default": [],
    }),
    alwayslink = True,  # Limine requests must not be stripped by linker
    copts = ["-I."],
)

rust_static_library(
    name = "entry_rs",
    srcs = ["entry.rs"],
    crate_name = "kernel_entry",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# C++ wrappers for arch_shutdown, gdt_init, idt_init etc.
# Temporary — will be removed when gdt.cc/idt.cc are migrated to Rust.
cc_library(
    name = "entry_ffi",
    srcs = ["entry_ffi.cc"],
    deps = [":arch_h", ":arch_init"],
    copts = ["-I."],
)

cc_library(
    name = "entry",
    deps = [
        ":entry_ffi",
        ":limine_entry",
    ],
)
