load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "kernel",
    srcs = [
        "exceptions.rs",
        "fdt.rs",
        "lib.rs",
        "mm.rs",
        "mmu.rs",
        "serial.rs",
        "types.rs",
    ] + select({
        "//bazel/platforms:x86_64": [
            "x86_64/gdt.rs",
            "x86_64/idt.rs",
            "x86_64/mod.rs",
        ],
        "//conditions:default": [],
    }),
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)
