load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "kernel",
    crate_name = "uni_kernel",
    srcs = [
        "src/cpu.rs",
        "src/cpu_info.rs",
        "src/deque.rs",
        "src/diag.rs",
        "src/eventloop.rs",
        "src/runtime.rs",
        "src/lib.rs",
        "src/mm.rs",
        "src/mmio.rs",
        "src/once.rs",
        "src/percpu.rs",
        "src/rng.rs",
        "src/rx_inbox.rs",
        "src/serial.rs",
        "src/spsc.rs",
        "src/sync.rs",
        "src/time.rs",
        "src/timer.rs",
        "src/types.rs",
    ] + select({
        "//bazel/platforms:x86_64": [
            "src/x86_64/acpi.rs",
            "src/x86_64/apic.rs",
            "src/x86_64/boot_args.rs",
            "src/x86_64/gdt.rs",
            "src/x86_64/idt.rs",
            "src/x86_64/mod.rs",
            "src/x86_64/smp.rs",
        ],
        "//bazel/platforms:aarch64": [
            "src/aarch64/exceptions.rs",
            "src/aarch64/fdt.rs",
            "src/aarch64/mmu.rs",
            "src/aarch64/mod.rs",
            "src/aarch64/smp.rs",
        ],
        "//conditions:default": [],
    }),
    crate_root = "src/lib.rs",
    # Unikernel-only: links against MMU / APIC / IDT / boot-section
    # code that only makes sense under a bare-metal target. Host
    # compilation hits mach-o-unfriendly `#[link_section = ".boot_bss"]`
    # annotations. The rust_tests below are independent — they
    # `srcs = [...]` specific files directly and don't depend on this
    # library.
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        "//uni-iobuf",
        "//uni-runtime",
        "//uni-worker",
        "//uni-platform",
        "//util/atomic_fn",
        "//util/tagged_treiber",
        "@crates//:getrandom",
        "@crates//:sha2",
        "@crates//:talc",
    ] + select({
        "//bazel/platforms:aarch64": ["@crates//:fdt"],
        "//conditions:default": [],
    }),
)

# Host-native unit tests for lock-free data structures. panic=unwind
# is supplied via `.bazelrc`'s `test --extra_rustc_flag=-Cpanic=unwind`
# — see that file for the full explanation.
rust_test(
    name = "deque_test",
    size = "small",
    srcs = ["src/deque.rs"],
    crate_root = "src/deque.rs",
)

rust_test(
    name = "spsc_test",
    size = "small",
    srcs = ["src/spsc.rs"],
    crate_root = "src/spsc.rs",
)

rust_test(
    name = "sync_test",
    size = "small",
    srcs = ["src/sync.rs"],
    crate_root = "src/sync.rs",
)

# `rx_inbox.rs` is generic and `core`-only — its one dependency is
# the shared `tagged_treiber` Treiber-stack crate (itself zero-dep
# `core`) — so the cross-core inbox + tagged free-list get a real
# multi-threaded host stress test (the kernel library itself is
# `os:none` and not host-buildable).
rust_test(
    name = "rx_inbox_test",
    size = "small",
    srcs = ["src/rx_inbox.rs"],
    crate_root = "src/rx_inbox.rs",
    deps = ["//util/tagged_treiber"],
)

# timer_test moved to //uni-worker:timer_test — the wheel now lives
# there so both backends can share it.
