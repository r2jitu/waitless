load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "kernel",
    srcs = [
        "lib.rs",
        "types.rs",
        "serial.rs",
        "mm.rs",
        "fdt.rs",
        "mmu.rs",
        "exceptions.rs",
    ] + select({
        "//bazel/platforms:x86_64": ["x86_64/mod.rs", "x86_64/gdt.rs", "x86_64/idt.rs"],
        "//conditions:default": [],
    }),
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

# Kernel entry point + limine boot + memory intrinsics.
# Single rust_static_library — one panic handler, one link unit.
rust_static_library(
    name = "entry",
    srcs = ["entry.rs", "libc.rs", "limine_entry.rs"],
    deps = [
        ":kernel",
        "//drivers",
        "//net:stack",
        "//uni",
    ],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

cc_library(
    name = "boot",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/boot.S"],
        "//bazel/platforms:aarch64": ["aarch64/boot.S"],
        "//conditions:default": ["x86_64/boot.S"],
    }),
)

cc_library(
    name = "limine_boot_asm",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/limine_boot.S"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "idt_stubs",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/idt_stubs.S"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

# Assembly + Rust entry aggregate (linked by cc_binary in unikernel.bzl).
# alwayslink ensures Limine request sections and memcpy aren't stripped.
cc_library(
    name = "entry_asm",
    deps = [":limine_boot_asm", ":idt_stubs"],
    alwayslink = True,
)
