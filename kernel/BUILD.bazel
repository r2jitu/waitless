load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "kernel",
    srcs = [
        "bump.rs",
        "cpu.rs",
        "deque.rs",
        "eventloop.rs",
        "lib.rs",
        "mmio.rs",
        "once.rs",
        "percpu.rs",
        "rng.rs",
        "spsc.rs",
        "sync.rs",
        "timer.rs",
        "mm.rs",
        "serial.rs",
        "time.rs",
        "types.rs",
    ] + select({
        "//bazel/platforms:x86_64": [
            "x86_64/acpi.rs",
            "x86_64/apic.rs",
            "x86_64/gdt.rs",
            "x86_64/idt.rs",
            "x86_64/mod.rs",
            "x86_64/smp.rs",
        ],
        "//bazel/platforms:aarch64": [
            "aarch64/exceptions.rs",
            "aarch64/fdt.rs",
            "aarch64/mod.rs",
            "aarch64/mmu.rs",
            "aarch64/smp.rs",
        ],
        "//conditions:default": [],
    }),
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    # Unikernel-only: links against MMU / APIC / IDT / boot-section
    # code that only makes sense under a bare-metal target. Host
    # compilation hits mach-o-unfriendly `#[link_section = ".boot_bss"]`
    # annotations. The rust_tests below are independent — they
    # `srcs = [...]` specific files directly and don't depend on this
    # library.
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        "//util/atomic_fn",
        "@crates//:chacha20",
        "@crates//:getrandom",
        "@crates//:sha2",
        "@crates//:talc",
    ] + select({
        "//bazel/platforms:aarch64": ["@crates//:fdt"],
        "//conditions:default": [],
    }),
)

# Host-native unit tests for lock-free data structures. panic=unwind
# is supplied via `.bazelrc`'s `test --extra_rustc_flag=-Cpanic=unwind`
# — see that file for the full explanation.
rust_test(
    name = "deque_test",
    srcs = ["deque.rs"],
    crate_root = "deque.rs",
    size = "small",
)

rust_test(
    name = "bump_test",
    srcs = ["bump.rs"],
    crate_root = "bump.rs",
    size = "small",
)

rust_test(
    name = "spsc_test",
    srcs = ["spsc.rs"],
    crate_root = "spsc.rs",
    size = "small",
)

rust_test(
    name = "once_test",
    srcs = ["once.rs"],
    crate_root = "once.rs",
    size = "small",
)

rust_test(
    name = "sync_test",
    srcs = ["sync.rs"],
    crate_root = "sync.rs",
    size = "small",
)

rust_test(
    name = "timer_test",
    srcs = ["timer.rs"],
    crate_root = "timer.rs",
    size = "small",
)
