load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

# Unified kernel library — types, serial, mm, fdt, mmu, exceptions, x86_64 init.
rust_library(
    name = "kernel_rs",
    srcs = [
        "lib.rs",
        "types.rs",
        "serial.rs",
        "mm.rs",
        "fdt.rs",
        "mmu.rs",
        "exceptions.rs",
    ] + select({
        "//bazel/platforms:x86_64": ["x86_64/mod.rs", "x86_64/gdt.rs", "x86_64/idt.rs"],
        "//conditions:default": [],
    }),
    crate_name = "kernel",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

# Compiler-required memory intrinsics (memcpy, memset, etc.)
rust_static_library(
    name = "libc_rs",
    srcs = ["libc.rs"],
    crate_name = "kernel_libc",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

cc_library(
    name = "libc",
    deps = [":libc_rs"],
    alwayslink = True,
)

cc_library(
    name = "boot",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/boot.S"],
        "//bazel/platforms:aarch64": ["aarch64/boot.S"],
        "//conditions:default": ["x86_64/boot.S"],
    }),
)

rust_static_library(
    name = "limine_entry_rs",
    srcs = ["limine_entry.rs"],
    crate_name = "limine_entry",
    deps = [":kernel_rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

cc_library(
    name = "limine_boot_asm",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/limine_boot.S"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "limine_entry",
    deps = [":limine_entry_rs", ":limine_boot_asm"],
    alwayslink = True,
)

cc_library(
    name = "idt_stubs",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/idt_stubs.S"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

rust_static_library(
    name = "entry_rs",
    srcs = ["entry.rs"],
    crate_name = "kernel_entry",
    deps = [
        ":kernel_rs",
        "//drivers:drivers_rs",
        "//net:stack_rs",
        "//uni:uni",
    ],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

cc_library(
    name = "entry",
    deps = [
        ":limine_entry",
        ":idt_stubs",
        ":libc",
    ],
)
