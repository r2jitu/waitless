load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "kernel",
    srcs = [
        "lib.rs",
        "types.rs",
        "serial.rs",
        "mm.rs",
        "fdt.rs",
        "mmu.rs",
        "exceptions.rs",
    ] + select({
        "//bazel/platforms:x86_64": ["x86_64/mod.rs", "x86_64/gdt.rs", "x86_64/idt.rs"],
        "//conditions:default": [],
    }),
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

# Kernel entry: Rust init code + Limine boot + memory intrinsics + ASM stubs.
# Single target for unikernel.bzl to depend on.

rust_static_library(
    name = "entry_rs",
    srcs = ["entry.rs", "libc.rs", "limine_entry.rs"],
    crate_root = "entry.rs",
    deps = [":kernel", "//drivers", "//net", "//uni"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    visibility = ["//visibility:private"],
)

cc_library(
    name = "entry",
    deps = [
        ":entry_rs",
        ":boot",
        ":limine_boot_asm",
        ":idt_stubs",
    ],
    alwayslink = True,
)

cc_library(
    name = "boot",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/boot.S"],
        "//bazel/platforms:aarch64": ["aarch64/boot.S"],
        "//conditions:default": ["x86_64/boot.S"],
    }),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "limine_boot_asm",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/limine_boot.S"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "idt_stubs",
    srcs = select({
        "//bazel/platforms:x86_64": ["x86_64/idt_stubs.S"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
)
