load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "arch_h",
    hdrs = ["arch.h"] + select({
        "//bazel/platforms:aarch64": [
            "aarch64/arch.h",
            "aarch64/timer.h",
        ],
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

cc_library(
    name = "fdt",
    srcs = select({
        "//bazel/platforms:aarch64": ["fdt.cc"],
        "//conditions:default": [],
    }),
    hdrs = ["fdt.h"],
    copts = ["-I."],
)

cc_library(
    name = "mmu",
    srcs = select({
        "//bazel/platforms:aarch64": ["aarch64/mmu.cc"],
        "//conditions:default": [],
    }),
    hdrs = select({
        "//bazel/platforms:aarch64": ["aarch64/mmu.h"],
        "//conditions:default": [],
    }),
    deps = select({
        "//bazel/platforms:aarch64": [":boot"],  # boot_l1_table in boot.S
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

cc_library(
    name = "core",
    srcs = [
        "mm.cc",
        "libc.cc",
    ] + select({
        "//bazel/platforms:x86_64": ["serial.cc"],
        "//bazel/platforms:aarch64": ["aarch64/serial.cc"],
        "//conditions:default": ["serial.cc"],
    }),
    hdrs = [
        "serial.h",
        "mm.h",
        "panic.h",
    ],
    deps = [":arch_h", ":fdt"] + select({
        "//bazel/platforms:aarch64": [
            "//drivers:virtio_console",
            "//drivers:virtio_pci",
        ],
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

cc_library(
    name = "arch_init",
    srcs = select({
        "//bazel/platforms:x86_64": [
            "gdt.cc",
            "idt.cc",
        ],
        "//bazel/platforms:aarch64": ["aarch64/exceptions.cc"],
        "//conditions:default": [
            "gdt.cc",
            "idt.cc",
        ],
    }),
    hdrs = select({
        "//bazel/platforms:x86_64": [
            "gdt.h",
            "idt.h",
        ],
        "//bazel/platforms:aarch64": ["aarch64/exceptions.h"],
        "//conditions:default": [
            "gdt.h",
            "idt.h",
        ],
    }),
    deps = [":core", ":fdt"],
    copts = ["-I."],
)

cc_library(
    name = "boot",
    srcs = select({
        "//bazel/platforms:x86_64": ["boot.S"],
        "//bazel/platforms:aarch64": ["aarch64/boot.S"],
        "//conditions:default": ["boot.S"],
    }),
)

cc_library(
    name = "entry",
    srcs = ["entry.cc"],
    deps = [
        ":core",
        ":arch_init",
        ":fdt",
        "//drivers:pci",
        "//drivers:virtio_net",
        "//net",
    ] + select({
        "//bazel/platforms:aarch64": [":mmu"],
        "//conditions:default": [],
    }),
    copts = [
        "-I.",
        "-Iinclude",
    ],
)
