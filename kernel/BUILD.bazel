load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/rules:rust.bzl", "HOST_TEST_RUSTC_FLAGS", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "kernel",
    srcs = [
        "bump.rs",
        "deque.rs",
        "eventloop.rs",
        "lib.rs",
        "mmio.rs",
        "once.rs",
        "percpu.rs",
        "rng.rs",
        "spsc.rs",
        "sync.rs",
        "timer.rs",
        "mm.rs",
        "serial.rs",
        "time.rs",
        "types.rs",
    ] + select({
        "//bazel/platforms:x86_64": [
            "x86_64/acpi.rs",
            "x86_64/apic.rs",
            "x86_64/gdt.rs",
            "x86_64/idt.rs",
            "x86_64/mod.rs",
            "x86_64/smp.rs",
        ],
        "//bazel/platforms:aarch64": [
            "aarch64/exceptions.rs",
            "aarch64/fdt.rs",
            "aarch64/mod.rs",
            "aarch64/mmu.rs",
            "aarch64/smp.rs",
        ],
        "//conditions:default": [],
    }),
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//util/atomic_fn",
        "@crates//:chacha20",
        "@crates//:getrandom",
        "@crates//:sha2",
        "@crates//:talc",
    ] + select({
        "//bazel/platforms:aarch64": ["@crates//:fdt"],
        "//conditions:default": [],
    }),
)

# Host-native unit tests for lock-free data structures.
rust_test(
    name = "deque_test",
    srcs = ["deque.rs"],
    crate_root = "deque.rs",
    rustc_flags = HOST_TEST_RUSTC_FLAGS,
)

rust_test(
    name = "bump_test",
    srcs = ["bump.rs"],
    crate_root = "bump.rs",
    rustc_flags = HOST_TEST_RUSTC_FLAGS,
)

rust_test(
    name = "spsc_test",
    srcs = ["spsc.rs"],
    crate_root = "spsc.rs",
    rustc_flags = HOST_TEST_RUSTC_FLAGS,
)

rust_test(
    name = "once_test",
    srcs = ["once.rs"],
    crate_root = "once.rs",
    rustc_flags = HOST_TEST_RUSTC_FLAGS,
)

rust_test(
    name = "sync_test",
    srcs = ["sync.rs"],
    crate_root = "sync.rs",
    rustc_flags = HOST_TEST_RUSTC_FLAGS,
)

rust_test(
    name = "timer_test",
    srcs = ["timer.rs"],
    crate_root = "timer.rs",
    rustc_flags = HOST_TEST_RUSTC_FLAGS,
)
