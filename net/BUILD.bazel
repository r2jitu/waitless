load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Pure networking types (byte-order helpers, IP/MAC addresses, checksums).
# No hardware or kernel dependencies — can be compiled for the host toolchain.
cc_library(
    name = "types",
    srcs = ["types.cc"],
    hdrs = ["types.h"],
    copts = ["-I.", "-Iinclude"],
)

# Bare-metal network stack: Ethernet, ARP, IPv4, TCP, DHCP.
# Depends on kernel/serial, kernel/mm, and the virtio-net driver.
# Compiled only for unikernel targets.
cc_library(
    name = "stack",
    srcs = [
        "ethernet.cc",
        "arp.cc",
        "ipv4.cc",
        "tcp.cc",
        "dhcp.cc",
    ],
    hdrs = [
        "types.h",
        "ethernet.h",
        "arp.h",
        "ipv4.h",
        "tcp.h",
        "dhcp.h",
    ],
    deps = [
        ":types",
        "//kernel:core",
        "//drivers:virtio_net",
    ],
    copts = [
        "-I.",
        "-Iinclude",
    ],
)

# HTTP/1.1 server (Rust): request parsing, routing, event loop.
# Calls uni:: functions via FFI (symbols resolved at link time from
# uni/ffi.cc + either uni/unikernel.cc or uni/native.cc).
rust_library(
    name = "http_rs",
    srcs = ["http.rs"],
    crate_name = "http",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# Convenience alias: the full network library (stack only — HTTP is now Rust).
# Used by unikernel_binary() in bazel/rules/unikernel.bzl.
cc_library(
    name = "net",
    deps = [
        ":stack",
    ],
)
