# ── TLS 1.3 crypto ──────────────────────────────────────────────────
#
# Thin byte-slice AEAD wrapper over the audited RustCrypto
# `chacha20poly1305` crate. Lets downstream callers (`//net:tls`,
# future `//net:quic`) use a simple `[u8; 32]` / `[u8; 12]` API
# without dealing with `generic-array` types. The upstream crate
# handles constant-timeness and correctness — we're just reshaping
# the interface.
#
# The SIMD intrinsics in `chacha20poly1305` / `poly1305` / `chacha20`
# compile cleanly on bare-metal x86_64 because of the per-crate
# `-Ctarget-feature=-soft-float,+sse2,+avx2,...` annotation in
# MODULE.bazel — see the big comment there.

rust_library(
    name = "tls_crypto",
    srcs = ["src/tls_crypto.rs"],
    crate_features = select({
        "//bazel/rules:tests_need_std_on": ["std"],
        "//conditions:default": [],
    }),
    crate_name = "net_tls_crypto",
    crate_root = "src/tls_crypto.rs",
    deps = [
        "@crates//:chacha20poly1305",
    ],
)

# Host-native unit tests for the AEAD seal/open round-trip. Pure
# bytes-in/bytes-out, no kernel deps. Same `std` feature trick as
# `//util/atomic_fn`: the crate flips to std + panic=unwind under
# the `test` verb so libtest's harness links.
rust_test(
    name = "tls_crypto_test",
    size = "small",
    crate = ":tls_crypto",
)

# TLS 1.3 handshake framing + ClientHello parser + ServerHello builder.
