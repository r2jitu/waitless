load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# ── Per-protocol crates (leaf → root) ────────────────────────────────────────

rust_library(
    name = "types",
    srcs = ["src/types.rs"],
    crate_name = "net_types",
    crate_root = "src/types.rs",
)

rust_test(
    name = "types_test",
    size = "small",
    crate = ":types",
)

# Safe `try_ref_from(&[u8]) -> Option<&Self>` for packed packet headers.
# Eliminates the dominant unsafe pattern in net/* (interpreting an inbound
# byte slice as `&PacketHeader`).
rust_library(
    name = "from_bytes",
    srcs = ["src/from_bytes.rs"],
    crate_name = "net_from_bytes",
    crate_root = "src/from_bytes.rs",
)

rust_test(
    name = "from_bytes_test",
    size = "small",
    crate = ":from_bytes",
)

# IP protocol dispatch registry — replaces hardcoded TCP/UDP match in
# `net::net_receive`. One acquire load + one indirect call per packet.
# Depends only on `//util:atomic_fn` (itself a zero-dep leaf crate),
# so `rust_test` still avoids the panic-strategy conflict that dep
# chains through `:types` or `//kernel` would otherwise trigger.
rust_library(
    name = "protocol",
    srcs = ["src/protocol.rs"],
    crate_name = "net_protocol",
    crate_root = "src/protocol.rs",
    deps = ["//util/atomic_fn"],
)

# `crate = ":protocol"` would rebuild `protocol` with `--test` but
# atomic_fn's dep doesn't get `--test`, so its `#![no_std]` stays
# on and rustc rejects linking a no_std/abort rlib into an unwind
# test binary. `srcs = ["src/protocol.rs"]` + a plain `:atomic_fn`
# dep side-steps it: under the `test` verb the
# `//bazel/rules:tests_need_std` flag flips to True, atomic_fn's
# `crate_features = select(...)` adds `std`, and the whole chain
# compiles as std + unwind. Production builds have the flag False
# and are still no_std + abort. No sibling target, no inline shim.
rust_test(
    name = "protocol_test",
    size = "small",
    srcs = ["src/protocol.rs"],
    crate_root = "src/protocol.rs",
    deps = ["//util/atomic_fn"],
)

# Protocol parsing tests — host-native, tests raw byte parsing for all protocols.
# No deps on bare-metal crates (panic=abort incompatible with test harness).
rust_test(
    name = "protocol_tests",
    size = "small",
    srcs = ["src/protocol_tests.rs"],
)

rust_library(
    name = "ethernet",
    srcs = ["src/ethernet.rs"],
    crate_name = "net_ethernet",
    crate_root = "src/ethernet.rs",
    deps = [
        ":from_bytes",
        ":types",
        "//drivers",
    ],
)

rust_library(
    name = "arp",
    srcs = ["src/arp.rs"],
    crate_name = "net_arp",
    crate_root = "src/arp.rs",
    deps = [
        ":ethernet",
        ":from_bytes",
        ":types",
        "//drivers",
        "//kernel",
    ],
)

rust_library(
    name = "ipv4",
    srcs = ["src/ipv4.rs"],
    crate_name = "net_ipv4",
    crate_root = "src/ipv4.rs",
    deps = [
        ":arp",
        ":ethernet",
        ":from_bytes",
        ":types",
        "//kernel",
    ],
)

rust_library(
    name = "tcp",
    srcs = ["src/tcp.rs"],
    crate_name = "net_tcp",
    crate_root = "src/tcp.rs",
    deps = [
        ":from_bytes",
        ":ipv4",
        ":types",
        "//kernel",
        "//uni-runtime",
        "@crates//:bitflags",
    ],
)

rust_library(
    name = "udp",
    srcs = ["src/udp.rs"],
    crate_name = "net_udp",
    crate_root = "src/udp.rs",
    deps = [
        ":from_bytes",
        ":ipv4",
        ":types",
        "//uni-runtime",
    ],
)

# TLS and QUIC moved out of //net to break the kitchen-sink
# pattern that was forming. Sans-io TLS primitives now live in
# //uni-tls (alongside the TLS-over-TCP server); sans-io QUIC
# primitives now live in //uni-quic (alongside the QUIC server).
# `//net` keeps its narrowed scope: L2-L4 network protocols and
# cross-cutting helpers.

rust_library(
    name = "dhcp",
    srcs = [
        "src/dhcp.rs",
        "src/dhcp_parse.rs",
    ],
    crate_name = "net_dhcp",
    crate_root = "src/dhcp.rs",
    deps = [
        ":arp",
        ":ethernet",
        ":from_bytes",
        ":ipv4",
        ":types",
        "//drivers",
        "//kernel",
        "//uni-runtime",
    ],
)

# Host-native unit tests for DHCP option TLV parsing + reply-header
# validation. Pure byte-slice logic, no kernel / driver / runtime
# deps — the real `dhcp_receive` in `dhcp.rs` calls into this
# module, so the tests exercise the actual production code. Pins
# behaviour for truncated options, missing End markers, unknown
# option codes, wrong XID, and bad magic cookies — all shapes we've
# seen on the wire (dnsmasq, busybox udhcpd, QEMU SLIRP).
rust_test(
    name = "dhcp_parse_test",
    size = "small",
    srcs = ["src/dhcp_parse.rs"],
    crate_root = "src/dhcp_parse.rs",
)

# ── Umbrella crate: full-stack dispatch + poll ───────────────────────────────

rust_library(
    name = "net",
    srcs = ["src/lib.rs"],
    crate_name = "uni_net_stack",
    deps = [
        ":arp",
        ":dhcp",
        ":ethernet",
        ":ipv4",
        ":protocol",
        ":tcp",
        ":types",
        ":udp",
        "//drivers",
        "//kernel",
        "//uni-runtime",
    ],
)
