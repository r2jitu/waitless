# ── TLS 1.3 crypto ──────────────────────────────────────────────────
#
# Thin byte-slice AEAD wrapper over the audited RustCrypto
# `chacha20poly1305` crate. Lets downstream callers (`//net:tls`,
# future `//net:quic`) use a simple `[u8; 32]` / `[u8; 12]` API
# without dealing with `generic-array` types. The upstream crate
# handles constant-timeness and correctness — we're just reshaping
# the interface.
#
# The SIMD intrinsics in `chacha20poly1305` / `poly1305` / `chacha20`
# compile cleanly on bare-metal x86_64 because of the per-crate
# `-Ctarget-feature=-soft-float,+sse2,+avx2,...` annotation in
# MODULE.bazel — see the big comment there.

rust_library(
    name = "tls_crypto",
    srcs = ["src/tls_crypto.rs"],
    crate_name = "net_tls_crypto",
    crate_root = "src/tls_crypto.rs",
    deps = [
        "@crates//:chacha20poly1305",
    ],
)

# NOTE: no tls_crypto_test — the upstream crate ships its own RFC 8439
# test vectors, and our wrapper's `rust_test` would hit the same
# panic-strategy conflict as //net:tls. Coverage lives in
# //apps/test_tls (bare-metal integration test).

# TLS 1.3 handshake framing + ClientHello parser + ServerHello builder.
# Pure byte-slice parsing/encoding with no external deps, so the host
# unit tests work without the panic-strategy conflict.
rust_library(
    name = "tls_handshake",
    srcs = ["src/tls_handshake.rs"],
    crate_name = "net_tls_handshake",
    crate_root = "src/tls_handshake.rs",
)

rust_test(
    name = "tls_handshake_test",
    size = "small",
    crate = ":tls_handshake",
)

# TLS 1.3 record layer: wraps plaintext records in TLSCiphertext using
# //net:tls's TrafficKey (AEAD seal/open with per-sequence nonce).
# Pure protocol logic — no I/O, no state beyond what the caller owns.
rust_library(
    name = "tls_record",
    srcs = ["src/tls_record.rs"],
    crate_name = "net_tls_record",
    crate_root = "src/tls_record.rs",
    deps = [
        ":tls",
        ":tls_crypto",
    ],
)

# NOTE: no tls_record_test — same panic-strategy conflict as //net:tls.
# Coverage will come from the end-to-end //apps/test_tls integration
# test once the server state machine lands.

# TLS 1.3 server-side handshake state machine. Ties together
# //net:tls_handshake (message framing), //net:tls_record (AEAD
# record layer), //net:tls (key schedule) and RustCrypto primitives
# (sha2 / hmac / p256) to drive a sans-io handshake from ClientHello
# to Established.
#
# Server auth uses ECDSA P-256 + SHA-256 (sig_scheme 0x0403). We
# previously used ed25519 (0x0807), which was simpler and faster,
# but Chromium-family browsers (Chrome, Arc, Edge, ...) don't
# advertise ed25519 in their TLS 1.3 signature_algorithms extension
# for server auth, so they reject our CertVerify with
# `illegal_parameter(47)` and show ERR_SSL_PROTOCOL_ERROR. ECDSA
# P-256 is the first scheme in every modern client's preference
# list and is also supported by LibreSSL (macOS system /usr/bin
# tooling), so test_hvf.sh no longer has to reject LibreSSL.
#
# To enable diagnostic tracing at runtime add `--cfg=tls_debug` to
# the rustc_flags of this target. When not set, the trace module
# in tls_server.rs compiles to no-op stubs with zero runtime cost.
rust_library(
    name = "tls_server",
    srcs = [
        "src/tls_server.rs",
        "src/tls_server_handlers.rs",
        "src/tls_server_keys.rs",
        "src/tls_server_profile.rs",
        "src/tls_server_trace.rs",
    ],
    crate_name = "net_tls_server",
    crate_root = "src/tls_server.rs",
    # `--check-cfg=cfg(tls_debug)` declares the custom cfg to rustc's
    # unexpected-cfg lint so that `#[cfg(tls_debug)]` doesn't warn
    # when the flag is absent (the common case). Project-wide
    # `-Dwarnings` would otherwise turn the warning into a build
    # failure. To actually enable tracing, add `"--cfg=tls_debug"`
    # to this list when debugging.
    #
    # Passing `--check-cfg` at all switches rustc into strict mode
    # where any undeclared cfg warns — so we also have to declare
    # `test` explicitly, since the `#[cfg(test)] mod tests { ... }`
    # block at the bottom of tls_server.rs is never built as a
    # rust_test target (no panic=unwind toolchain for it) but still
    # needs to be syntactically valid.
    rustc_flags = [
        "--check-cfg=cfg(tls_debug)",
        "--check-cfg=cfg(test)",
    ],
    # The kernel dep is bare-metal-only: the `#[cfg(tls_debug)]`
    # trace module uses `kernel::serial::puts` on `target_os="none"`
    # targets and `libc::write` on hosted targets. The rest of
    # tls_server has no kernel dependency, so the same source
    # compiles for native POSIX builds too and lets `//uni:uni`
    # drive the full TLS stack on both paths.
    deps = [
        ":tls",
        ":tls_crypto",
        ":tls_handshake",
        ":tls_record",
        "@crates//:getrandom",
        "@crates//:hmac",
        "@crates//:p256",
        "@crates//:sha2",
    ] + select({
        "//bazel/platforms:native": [],
        "//conditions:default": ["//kernel"],
    }),
)

# TLS 1.3 sans-io core: key schedule, HKDF-Expand-Label, transcript,
# X25519 wrapper, AEAD glue. Uses RustCrypto sha2/hmac/hkdf + our own
# tls_crypto for the record AEAD. Shared by the TLS-over-TCP server
# and (eventually) the QUIC stack.
rust_library(
    name = "tls",
    srcs = ["src/tls.rs"],
    crate_name = "net_tls",
    crate_root = "src/tls.rs",
    deps = [
        ":tls_crypto",
        "@crates//:hkdf",
        "@crates//:hmac",
        "@crates//:sha2",
        "@crates//:x25519-dalek",
    ],
)

# NOTE: no `tls_test` target. The RustCrypto deps (sha2, hmac, hkdf,
# x25519-dalek, curve25519-dalek, ...) are built with `-Cpanic=abort`
# via the global .bazelrc flag, which conflicts with the `unwind`
# strategy `rust_test`'s test harness requires. The same limitation
# applies to any future test on a crate with external deps (tcp, etc.)
# and is tracked as a separate follow-up. For now tls's correctness
# is covered by an in-kernel integration test (//apps/test_tls)
# that exercises the full key schedule via HTTP + serial.

rust_library(
    name = "dhcp",
    srcs = ["src/dhcp.rs"],
    crate_name = "net_dhcp",
    crate_root = "src/dhcp.rs",
    deps = [
        ":arp",
        ":ethernet",
        ":from_bytes",
        ":ipv4",
        ":types",
        "//drivers",
        "//kernel",
    ],
)

# ── Umbrella crate: full-stack dispatch + poll ───────────────────────────────

rust_library(
    name = "net",
    srcs = ["src/lib.rs"],
    crate_name = "uni_net_stack",
    deps = [
        ":arp",
        ":dhcp",
        ":ethernet",
        ":ipv4",
        ":protocol",
        ":tcp",
        ":types",
        ":udp",
        "//drivers",
        "//kernel",
    ],
)
