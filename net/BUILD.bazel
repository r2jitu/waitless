load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Rust network stack: Ethernet, ARP, IPv4, TCP, DHCP.
# Linked as rust_library — depends on kernel and driver crates directly.
# The #[no_mangle] extern "C" exports (uni_tcp_*, net_tcp_init, etc.)
# are available for C++ linking when included transitively via entry_rs.
rust_library(
    name = "stack_rs",
    srcs = ["stack.rs"],
    crate_name = "net_stack",
    edition = "2024",
    deps = [
        "//kernel:serial_rs",
        "//kernel:mm_rs",
        "//drivers:drivers_rs",
    ],
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# HTTP/1.1 server (Rust): request parsing, routing, event loop.
# Calls uni:: functions via FFI (symbols resolved at link time from
# uni/ffi_rs or uni/native.cc).
rust_library(
    name = "http_rs",
    srcs = ["http.rs"],
    crate_name = "http",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)
