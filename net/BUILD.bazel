package(default_visibility = ["//visibility:public"])

# Pure networking types (byte-order helpers, IP/MAC addresses, checksums).
# No hardware or kernel dependencies — can be compiled for the host toolchain
# and used in unit tests.
cc_library(
    name = "types",
    srcs = ["types.cc"],
    hdrs = ["types.h"],
    copts = ["-I.", "-Iinclude"],
)

cc_library(
    name = "net",
    srcs = [
        "ethernet.cc",
        "arp.cc",
        "ipv4.cc",
        "tcp.cc",
        "dhcp.cc",
        "http.cc",
    ],
    hdrs = [
        "types.h",
        "ethernet.h",
        "arp.h",
        "ipv4.h",
        "tcp.h",
        "dhcp.h",
        "http.h",
    ],
    deps = [
        ":types",
        "//kernel:core",
        "//drivers:virtio_net",
    ],
    copts = [
        "-I.",
        "-Iinclude",
    ],
)
