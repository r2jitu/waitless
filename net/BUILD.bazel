load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

# ── Per-protocol crates (leaf → root) ────────────────────────────────────────

rust_library(
    name = "types",
    srcs = ["types.rs"],
    crate_root = "types.rs",
    crate_name = "net_types",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

rust_test(
    name = "types_test",
    crate = ":types",
    rustc_flags = ["-Cpanic=unwind"],
)

# Safe `try_ref_from(&[u8]) -> Option<&Self>` for packed packet headers.
# Eliminates the dominant unsafe pattern in net/* (interpreting an inbound
# byte slice as `&PacketHeader`).
rust_library(
    name = "from_bytes",
    srcs = ["from_bytes.rs"],
    crate_root = "from_bytes.rs",
    crate_name = "net_from_bytes",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

rust_test(
    name = "from_bytes_test",
    crate = ":from_bytes",
    rustc_flags = ["-Cpanic=unwind"],
)

# Protocol parsing tests — host-native, tests raw byte parsing for all protocols.
# No deps on bare-metal crates (panic=abort incompatible with test harness).
rust_test(
    name = "protocol_tests",
    srcs = ["protocol_tests.rs"],
    rustc_flags = ["-Cpanic=unwind"],
)

rust_library(
    name = "ethernet",
    srcs = ["ethernet.rs"],
    crate_root = "ethernet.rs",
    crate_name = "net_ethernet",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        "//drivers",
    ],
)

rust_library(
    name = "arp",
    srcs = ["arp.rs"],
    crate_root = "arp.rs",
    crate_name = "net_arp",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ethernet",
        "//drivers",
    ],
)

rust_library(
    name = "ipv4",
    srcs = ["ipv4.rs"],
    crate_root = "ipv4.rs",
    crate_name = "net_ipv4",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ethernet",
        ":arp",
    ],
)

rust_library(
    name = "tcp",
    srcs = ["tcp.rs"],
    crate_root = "tcp.rs",
    crate_name = "net_tcp",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ipv4",
        "//kernel",
        "@crates//:bitflags",
    ],
)

rust_library(
    name = "udp",
    srcs = ["udp.rs"],
    crate_root = "udp.rs",
    crate_name = "net_udp",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ipv4",
    ],
)

rust_library(
    name = "dhcp",
    srcs = ["dhcp.rs"],
    crate_root = "dhcp.rs",
    crate_name = "net_dhcp",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ethernet",
        ":arp",
        ":ipv4",
        "//drivers",
        "//kernel",
    ],
)

# ── Umbrella crate: full-stack dispatch + poll ───────────────────────────────

rust_library(
    name = "net",
    srcs = ["lib.rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":types",
        ":ethernet",
        ":arp",
        ":ipv4",
        ":tcp",
        ":udp",
        ":dhcp",
        "//drivers",
        "//kernel",
    ],
)
