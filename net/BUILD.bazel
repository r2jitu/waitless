    srcs = ["src/tls_handshake.rs"],
    crate_name = "net_tls_handshake",
    crate_root = "src/tls_handshake.rs",
)

rust_test(
    name = "tls_handshake_test",
    size = "small",
    crate = ":tls_handshake",
)

# QUIC wire-format primitives (RFC 9000 §16-17): VARINT codec,
# long/short-header packet parsing, packet-number truncation /
# reconstruction. Pure protocol layer — first plank for `//net:quic`.
# Phase 3c.
rust_library(
    name = "quic_wire",
    srcs = ["src/quic_wire.rs"],
    crate_features = select({
        "//bazel/rules:tests_need_std_on": ["std"],
        "//conditions:default": [],
    }),
    crate_name = "net_quic_wire",
    crate_root = "src/quic_wire.rs",
)

rust_test(
    name = "quic_wire_test",
    size = "small",
    crate = ":quic_wire",
)

# QUIC packet protection (RFC 9001): Initial-keys derivation
# (§5.2), AEAD seal/open (§5.3), header protection (§5.4).
# Combines `//net:tls`'s HKDF-Expand-Label with AES-128-GCM and
# ChaCha20-Poly1305. Phase 3c.
rust_library(
    name = "quic_crypto",
    srcs = ["src/quic_crypto.rs"],
    crate_features = select({
        "//bazel/rules:tests_need_std_on": ["std"],
        "//conditions:default": [],
    }),
    crate_name = "net_quic_crypto",
    crate_root = "src/quic_crypto.rs",
    deps = [
        ":tls",
        ":tls_crypto",
        "@crates//:aes-gcm",
        "@crates//:chacha20",
        "@crates//:hmac",
        "@crates//:sha2",
    ],
)

rust_test(
    name = "quic_crypto_test",
    size = "small",
    crate = ":quic_crypto",
)

# QUIC frame codec (RFC 9000 §19): PADDING/PING/ACK/CRYPTO/STREAM/
# CONNECTION_CLOSE/HANDSHAKE_DONE. Pure protocol layer; consumes
# decrypted packet payloads from `quic_crypto`. Phase 3c.
rust_library(
    name = "quic_frame",
    srcs = ["src/quic_frame.rs"],
    crate_features = select({
        "//bazel/rules:tests_need_std_on": ["std"],
        "//conditions:default": [],
    }),
    crate_name = "net_quic_frame",
    crate_root = "src/quic_frame.rs",
    deps = [":quic_wire"],
)

rust_test(
    name = "quic_frame_test",
    size = "small",
    crate = ":quic_frame",
)

# TLS 1.3 record layer: wraps plaintext records in TLSCiphertext using
# //net:tls's TrafficKey (AEAD seal/open with per-sequence nonce).
# Pure protocol logic — no I/O, no state beyond what the caller owns.
rust_library(
    name = "tls_record",
    srcs = ["src/tls_record.rs"],
    crate_features = select({
        "//bazel/rules:tests_need_std_on": ["std"],
        "//conditions:default": [],
    }),
    crate_name = "net_tls_record",
    crate_root = "src/tls_record.rs",
    deps = [
        ":tls",
        ":tls_crypto",
    ],
)

# Host-native unit tests for record-layer framing + AEAD seal/open
# round-trip. Same `std` feature trick as `:tls_crypto_test`.
rust_test(
    name = "tls_record_test",
    size = "small",
    crate = ":tls_record",
)

# The TLS 1.3 server-side handshake state machine moved out of
# //net into //uni-tls — it's TLS-over-TCP-specific server logic
# and never composed cleanly with the lower-level primitives that
# QUIC will reuse from this package.

# TLS 1.3 sans-io core: key schedule, HKDF-Expand-Label, transcript,
# X25519 wrapper, AEAD glue. Uses RustCrypto sha2/hmac/hkdf + our own
# tls_crypto for the record AEAD. Shared by the TLS-over-TCP server
# and (eventually) the QUIC stack.
rust_library(
    name = "tls",
    srcs = ["src/tls.rs"],
    crate_features = select({
        "//bazel/rules:tests_need_std_on": ["std"],
        "//conditions:default": [],
    }),
    crate_name = "net_tls",
    crate_root = "src/tls.rs",
    deps = [
        ":tls_crypto",
        "@crates//:hkdf",
        "@crates//:hmac",
        "@crates//:sha2",
        "@crates//:x25519-dalek",
    ],
)

# Host-native unit tests for the key schedule, HKDF-Expand-Label,
# transcript hashing, and X25519 wrapper. Same `std` feature
# trick as `:tls_crypto_test` — flips this crate to std under the
# `test` verb so libtest's panic=unwind harness can link past the
# RustCrypto deps' no_std requirement.
rust_test(
    name = "tls_test",
    size = "small",
    crate = ":tls",
)

