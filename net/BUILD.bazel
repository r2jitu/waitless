load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

# ── Per-protocol crates (leaf → root) ────────────────────────────────────────

rust_library(
    name = "types",
    srcs = ["types.rs"],
    crate_root = "types.rs",
    crate_name = "net_types",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

rust_test(
    name = "types_test",
    crate = ":types",
    rustc_flags = ["-Cpanic=unwind"],
)

# Safe `try_ref_from(&[u8]) -> Option<&Self>` for packed packet headers.
# Eliminates the dominant unsafe pattern in net/* (interpreting an inbound
# byte slice as `&PacketHeader`).
rust_library(
    name = "from_bytes",
    srcs = ["from_bytes.rs"],
    crate_root = "from_bytes.rs",
    crate_name = "net_from_bytes",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

rust_test(
    name = "from_bytes_test",
    crate = ":from_bytes",
    rustc_flags = ["-Cpanic=unwind"],
)

# Protocol parsing tests — host-native, tests raw byte parsing for all protocols.
# No deps on bare-metal crates (panic=abort incompatible with test harness).
rust_test(
    name = "protocol_tests",
    srcs = ["protocol_tests.rs"],
    rustc_flags = ["-Cpanic=unwind"],
)

rust_library(
    name = "ethernet",
    srcs = ["ethernet.rs"],
    crate_root = "ethernet.rs",
    crate_name = "net_ethernet",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        "//drivers",
    ],
)

rust_library(
    name = "arp",
    srcs = ["arp.rs"],
    crate_root = "arp.rs",
    crate_name = "net_arp",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ethernet",
        "//drivers",
        "//kernel",
    ],
)

rust_library(
    name = "ipv4",
    srcs = ["ipv4.rs"],
    crate_root = "ipv4.rs",
    crate_name = "net_ipv4",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ethernet",
        ":arp",
        "//kernel",
    ],
)

rust_library(
    name = "tcp",
    srcs = ["tcp.rs"],
    crate_root = "tcp.rs",
    crate_name = "net_tcp",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ipv4",
        "//kernel",
        "@crates//:bitflags",
    ],
)

rust_library(
    name = "udp",
    srcs = ["udp.rs"],
    crate_root = "udp.rs",
    crate_name = "net_udp",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ipv4",
        "//kernel",
    ],
)

# ── TLS 1.3 crypto ──────────────────────────────────────────────────
#
# Hand-rolled ChaCha20 + Poly1305 + AEAD_CHACHA20_POLY1305 (RFC 8439).
# Written in-tree rather than using the `chacha20poly1305` crate because
# the latter's cpufeatures-gated SIMD path doesn't compile on our
# bare-metal `x86_64-unknown-none` target. See Cargo.toml for the full
# investigation. This is ~500 lines of pure, portable Rust; the host-
# native unit test runs the RFC 8439 test vectors.

rust_library(
    name = "tls_crypto",
    srcs = ["tls_crypto.rs"],
    crate_root = "tls_crypto.rs",
    crate_name = "net_tls_crypto",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

rust_test(
    name = "tls_crypto_test",
    crate = ":tls_crypto",
    rustc_flags = ["-Cpanic=unwind"],
)

# TLS 1.3 handshake framing + ClientHello parser + ServerHello builder.
# Pure byte-slice parsing/encoding with no external deps, so the host
# unit tests work without the panic-strategy conflict.
rust_library(
    name = "tls_handshake",
    srcs = ["tls_handshake.rs"],
    crate_root = "tls_handshake.rs",
    crate_name = "net_tls_handshake",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

rust_test(
    name = "tls_handshake_test",
    crate = ":tls_handshake",
    rustc_flags = ["-Cpanic=unwind"],
)

# TLS 1.3 sans-io core: key schedule, HKDF-Expand-Label, transcript,
# X25519 wrapper, AEAD glue. Uses RustCrypto sha2/hmac/hkdf + our own
# tls_crypto for the record AEAD. Shared by the TLS-over-TCP server
# and (eventually) the QUIC stack.
rust_library(
    name = "tls",
    srcs = ["tls.rs"],
    crate_root = "tls.rs",
    crate_name = "net_tls",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":tls_crypto",
        "@crates//:hkdf",
        "@crates//:hmac",
        "@crates//:sha2",
        "@crates//:x25519-dalek",
    ],
)

# NOTE: no `tls_test` target. The RustCrypto deps (sha2, hmac, hkdf,
# x25519-dalek, curve25519-dalek, ...) are built with `-Cpanic=abort`
# via the global .bazelrc flag, which conflicts with the `unwind`
# strategy `rust_test`'s test harness requires. The same limitation
# applies to any future test on a crate with external deps (tcp, etc.)
# and is tracked as a separate follow-up. For now tls's correctness
# is covered by an in-kernel integration test (//apps/test_tls)
# that exercises the full key schedule via HTTP + serial.

rust_library(
    name = "dhcp",
    srcs = ["dhcp.rs"],
    crate_root = "dhcp.rs",
    crate_name = "net_dhcp",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":from_bytes",
        ":types",
        ":ethernet",
        ":arp",
        ":ipv4",
        "//drivers",
        "//kernel",
    ],
)

# ── Umbrella crate: full-stack dispatch + poll ───────────────────────────────

rust_library(
    name = "net",
    srcs = ["lib.rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        ":types",
        ":ethernet",
        ":arp",
        ":ipv4",
        ":tcp",
        ":udp",
        ":dhcp",
        "//drivers",
        "//kernel",
    ],
)
