load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# ── Per-protocol crates (leaf → root) ────────────────────────────────────────

rust_library(
    name = "types",
    srcs = ["src/types.rs"],
    crate_name = "net_types",
    crate_root = "src/types.rs",
)

rust_test(
    name = "types_test",
    size = "small",
    crate = ":types",
)

# RFC 1071 internet checksum + the L4 (TCP/UDP/ICMPv6) pseudo-header
# checksums. Pure arithmetic leaf — carved out of `:types` so the
# checksum math is a crate with one job.
rust_library(
    name = "checksum",
    srcs = ["src/checksum.rs"],
    crate_name = "net_checksum",
    crate_root = "src/checksum.rs",
    deps = [
        ":types",
    ],
)

rust_test(
    name = "checksum_test",
    size = "small",
    crate = ":checksum",
)

# Safe `try_ref_from(&[u8]) -> Option<&Self>` for packed packet headers.
# Eliminates the dominant unsafe pattern in net/* (interpreting an inbound
# byte slice as `&PacketHeader`).
rust_library(
    name = "from_bytes",
    srcs = ["src/from_bytes.rs"],
    crate_name = "net_from_bytes",
    crate_root = "src/from_bytes.rs",
)

rust_test(
    name = "from_bytes_test",
    size = "small",
    crate = ":from_bytes",
)

# Protocol parsing tests — host-native, tests raw byte parsing for all protocols.
# No deps on bare-metal crates (panic=abort incompatible with test harness).
rust_test(
    name = "protocol_tests",
    size = "small",
    srcs = ["src/protocol_tests.rs"],
)

# Ethernet wire format — parse + header build. Pure leaf (no driver
# dep), host-testable. The os:none send path is `:eth_tx`.
rust_library(
    name = "ethernet",
    srcs = ["src/ethernet.rs"],
    crate_name = "net_ethernet",
    crate_root = "src/ethernet.rs",
    deps = [
        ":from_bytes",
        ":types",
    ],
)

rust_test(
    name = "ethernet_test",
    size = "small",
    crate = ":ethernet",
)

# Ethernet send path — NIC MAC init + frame TX. Split from
# `:ethernet` so the parse side carries no NIC dependency. Host-
# buildable: its NIC dep is the host-buildable `//drivers:nic`
# dispatch crate, not the os:none `//drivers` umbrella.
rust_library(
    name = "eth_tx",
    srcs = ["src/eth_tx.rs"],
    crate_name = "net_eth_tx",
    crate_root = "src/eth_tx.rs",
    deps = [
        ":ethernet",
        ":types",
        "//drivers:nic",
    ],
)

rust_library(
    name = "arp",
    srcs = ["src/arp.rs"],
    crate_name = "net_arp",
    crate_root = "src/arp.rs",
    deps = [
        ":eth_tx",
        ":ethernet",
        ":from_bytes",
        ":types",
        "//drivers:nic",
        "//kernel/core",
        "//uni-iobuf",
    ],
)

# IPv4 wire format — parse + header build. Pure leaf: `ipv4_parse`
# / `same_subnet` are pure; `fill_header` / `next_ip_id` use only
# `kernel_core` (the per-core IP-ID counter). Host-testable.
rust_library(
    name = "ipv4",
    srcs = ["src/ipv4.rs"],
    crate_name = "net_ipv4",
    crate_root = "src/ipv4.rs",
    deps = [
        ":checksum",
        ":from_bytes",
        ":types",
        "//kernel/core",
    ],
)

rust_test(
    name = "ipv4_test",
    size = "small",
    crate = ":ipv4",
)

# IPv6 wire-format primitives — pure parse/build/checksum (no
# Ethernet send wiring, no kernel dep). The umbrella `:net` crate
# bridges this to `ethernet_send` + the NDP MAC resolver. Keeping
# this leaf testable host-natively means the os:none-only deps
# (drivers / kernel) don't pull in via the test target.
rust_library(
    name = "ipv6",
    srcs = ["src/ipv6.rs"],
    crate_name = "net_ipv6",
    crate_root = "src/ipv6.rs",
    deps = [
        ":from_bytes",
        ":types",
    ],
)

rust_test(
    name = "ipv6_test",
    size = "small",
    crate = ":ipv6",
)

# ICMPv6 + NDP wire format. Pure parse/build, no kernel dep —
# host-testable like `:ipv6`. The umbrella `:net` crate dispatches
# inbound ICMPv6 packets here and ships outbound replies through
# `ethernet_send`.
rust_library(
    name = "icmpv6",
    srcs = ["src/icmpv6.rs"],
    crate_name = "net_icmpv6",
    crate_root = "src/icmpv6.rs",
    deps = [
        ":checksum",
        ":types",
    ],
)

rust_test(
    name = "icmpv6_test",
    size = "small",
    crate = ":icmpv6",
)

# NDP MAC cache. Mirrors `:arp`. Host-testable — its only non-leaf
# dep is `kernel_core` (the host-buildable `Spinlock`); `ndp_test`
# covers the cache logic (lookup / FIFO eviction / learn guards).
rust_library(
    name = "ndp",
    srcs = ["src/ndp.rs"],
    crate_name = "net_ndp",
    crate_root = "src/ndp.rs",
    deps = [
        ":types",
        "//kernel/core",
    ],
)

rust_test(
    name = "ndp_test",
    size = "small",
    crate = ":ndp",
)

# Destination-MAC resolution dispatcher. Thin layer over `arp` +
# `ndp` that picks the right resolver based on the destination
# IP family. Used by `tcp` and `udp`'s unified L2/L3/L4 frame
# builders so they don't carry duplicate copies of the same
# 10-line dispatch.
rust_library(
    name = "dst_mac",
    srcs = ["src/dst_mac.rs"],
    crate_name = "net_dst_mac",
    crate_root = "src/dst_mac.rs",
    deps = [
        ":arp",
        ":ndp",
        ":types",
    ],
)

# Outbound IPv6 helper — combines the wire-format builder with
# NDP MAC resolution and ethernet_send. Mirrors `ipv4_send`'s
# place in the dependency graph: TCP / UDP / the umbrella
# receive-path reply code link against this rather than wiring
# raw `ethernet_send` themselves. On NDP cache miss it issues an
# active Neighbor Solicitation (deps `:icmpv6` for the NS
# builder).
rust_library(
    name = "ipv6_send",
    srcs = ["src/ipv6_send.rs"],
    crate_name = "net_ipv6_send",
    crate_root = "src/ipv6_send.rs",
    deps = [
        ":eth_tx",
        ":ethernet",
        ":icmpv6",
        ":ipv6",
        ":ndp",
        ":types",
    ],
)

rust_library(
    name = "tcp",
    srcs = ["src/tcp.rs"],
    crate_name = "net_tcp",
    crate_root = "src/tcp.rs",
    deps = [
        ":checksum",
        ":dst_mac",
        ":ethernet",
        ":from_bytes",
        ":ipv4",
        ":ipv6",
        ":ipv6_send",
        ":types",
        "//drivers:nic",
        "//kernel/core",
        "//uni-iobuf",
        "//uni-net:driver",
        "//uni-runtime",
        "//uni-worker",
        "@crates//:bitflags",
    ],
)

# Host-native TCP conformance harness — drives scripted segments into
# `tcp_receive` against a mock `NicOps` that captures TX frames.
rust_test(
    name = "tcp_test",
    size = "small",
    crate = ":tcp",
)

rust_library(
    name = "udp",
    srcs = ["src/udp.rs"],
    crate_name = "net_udp",
    crate_root = "src/udp.rs",
    deps = [
        ":checksum",
        ":dst_mac",
        ":ethernet",
        ":from_bytes",
        ":ipv4",
        ":ipv6",
        ":ipv6_send",
        ":types",
        "//drivers:nic",
        "//uni-iobuf",
        "//uni-net:driver",
        "//uni-runtime",
    ],
)

# TLS and QUIC moved out of //net to break the kitchen-sink
# pattern that was forming. Sans-io TLS primitives now live in
# //uni-tls (alongside the TLS-over-TCP server); sans-io QUIC
# primitives now live in //uni-quic (alongside the QUIC server).
# `//net` keeps its narrowed scope: L2-L4 network protocols and
# cross-cutting helpers.

rust_library(
    name = "dhcp",
    srcs = [
        "src/dhcp.rs",
        "src/dhcp_parse.rs",
    ],
    crate_name = "net_dhcp",
    crate_root = "src/dhcp.rs",
    deps = [
        ":arp",
        ":ethernet",
        ":from_bytes",
        ":ipv4",
        ":types",
        "//kernel",
        "//uni-runtime",
    ],
)

# Host-native unit tests for DHCP option TLV parsing + reply-header
# validation. Pure byte-slice logic, no kernel / driver / runtime
# deps — the real `dhcp_receive` in `dhcp.rs` calls into this
# module, so the tests exercise the actual production code. Pins
# behaviour for truncated options, missing End markers, unknown
# option codes, wrong XID, and bad magic cookies — all shapes we've
# seen on the wire (dnsmasq, busybox udhcpd, QEMU SLIRP).
rust_test(
    name = "dhcp_parse_test",
    size = "small",
    srcs = ["src/dhcp_parse.rs"],
    crate_root = "src/dhcp_parse.rs",
)

# RX classify stage + Tier-2 flow distribution. Pure leaf — depends
# only on the wire-format leaves — so the classify verdict logic and
# the flow hash are host-unit-testable. `uni_net_stack`'s `rx` module
# is the os:none shell that supplies the IPv6 accept-list + delivers.
rust_library(
    name = "net_rx",
    srcs = ["src/classify.rs"],
    crate_name = "net_rx",
    crate_root = "src/classify.rs",
    deps = [
        ":ethernet",
        ":ipv4",
        ":ipv6",
        ":types",
    ],
)

rust_test(
    name = "net_rx_test",
    size = "small",
    crate = ":net_rx",
)

# ── Umbrella crate: full-stack dispatch + poll ───────────────────────────────

rust_library(
    name = "net",
    srcs = [
        "src/ipv6_nd.rs",
        "src/lib.rs",
        "src/rx.rs",
        "src/sched.rs",
    ],
    crate_name = "uni_net_stack",
    crate_root = "src/lib.rs",
    deps = [
        ":arp",
        ":dhcp",
        ":eth_tx",
        ":ethernet",
        ":icmpv6",
        ":ipv4",
        ":ipv6",
        ":ipv6_send",
        ":ndp",
        ":net_rx",
        ":tcp",
        ":types",
        ":udp",
        "//drivers:nic",
        "//kernel",
        "//uni-iobuf",
        "//uni-runtime",
    ],
)
