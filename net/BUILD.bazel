load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Pure networking types (byte-order helpers, IP/MAC addresses, checksums).
# No hardware or kernel dependencies — can be compiled for the host toolchain.
cc_library(
    name = "types",
    srcs = ["types.cc"],
    hdrs = ["types.h"],
    copts = ["-I.", "-Iinclude"],
)

# Bare-metal network stack: Ethernet, ARP, IPv4, TCP, DHCP.
# Depends on kernel/serial, kernel/mm, and the virtio-net driver.
# Compiled only for unikernel targets.
cc_library(
    name = "stack",
    srcs = [
        "ethernet.cc",
        "arp.cc",
        "ipv4.cc",
        "tcp.cc",
        "dhcp.cc",
    ],
    hdrs = [
        "types.h",
        "ethernet.h",
        "arp.h",
        "ipv4.h",
        "tcp.h",
        "dhcp.h",
    ],
    deps = [
        ":types",
        "//kernel:core",
        "//drivers:virtio_net",
    ],
    copts = [
        "-I.",
        "-Iinclude",
    ],
)

# HTTP/1.1 server: request parsing, routing, event loop.
# Depends only on the platform interface — not on the bare-metal stack.
# Compiles for both unikernel and native targets.
cc_library(
    name = "http",
    srcs = ["http.cc"],
    hdrs = ["http.h"],
    deps = [
        "//uni:uni",
    ],
    copts = [
        "-I.",
        "-Iinclude",
    ],
)

# C-linkage FFI bridge for the HTTP server (used by Rust apps).
# Exposes a dispatch callback interface so Rust can handle HTTP requests
# without directly interacting with the C++ Server class.
cc_library(
    name = "http_ffi",
    srcs = ["http_ffi.cc"],
    deps = [
        ":http",
        "//uni:uni",
    ],
    copts = [
        "-I.",
        "-Iinclude",
    ],
)

# Convenience alias: the full network library (stack + HTTP).
# Used by unikernel_binary() in bazel/rules/unikernel.bzl.
cc_library(
    name = "net",
    deps = [
        ":stack",
        ":http",
    ],
)
