load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "net",
    srcs = [
        "arp.rs",
        "dhcp.rs",
        "ethernet.rs",
        "ipv4.rs",
        "lib.rs",
        "tcp.rs",
        "types.rs",
    ],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//drivers",
        "//kernel",
    ],
)
