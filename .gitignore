# Bazel — convenience symlinks at the repo root (bazel-bin, bazel-out,
# bazel-testlogs, bazel-<module-name>, and per-worktree/agent variants).
# The leading `/` anchors to the root so it can't catch nested paths.
/bazel-*
.bazel/
.bazelrc.local

# OS
.DS_Store

# Editors
*.swp
*.swo
.idea/

# VS Code: commit shareable settings (rust-analyzer wiring), ignore
# everything else (per-user launch.json, tasks.json, debug state).
.vscode/*
!.vscode/settings.json

# Claude Code
.claude/

# Generated by rules_rust for rust-analyzer
rust-project.json

# Cached artifacts
.cache/
bench/webserver_native
__pycache__/

# Cargo standalone build artefacts (under tools/hvf-runner). The
# bazel build goes through crate_universe and writes elsewhere.
target/
