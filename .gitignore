# Bazel build outputs (symlinks created by Bazel in the project root)
bazel-bin
bazel-out
bazel-testlogs
bazel-unikernel

# Bazel cache and user-specific files
.bazel/
user.bazelrc

# Machine-local Bazel config (generated by setup-dev.sh)
.bazelrc.local

# macOS metadata
.DS_Store

# Claude Code
.claude/

# Editor artifacts
*.swp
*.swo
.vscode/
.idea/

# Compiled binaries
*.o
*.elf
*.iso

# Manually-compiled run-vz binary (superseded by bazel build //scripts:run_vz)
scripts/run-vz

# Cached Limine bootloader binaries (downloaded by make-limine-iso.sh)
.cache/
bazel-agent-*
bench/webserver_native
