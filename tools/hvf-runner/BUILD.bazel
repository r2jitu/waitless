load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "run-hvf.entitlements",
])

# Native HVF runner. Built as a host-tool aarch64 macOS binary (see
# `target_compatible_with`); the Hypervisor framework is pulled in
# via `#[link(name = "Hypervisor", kind = "framework")]` in
# `src/hvf.rs`, so no explicit `rustc_flags` are needed here.
# Cargo.toml is the source of truth for crate deps; @crates//:libc /
# @crates//:vm-fdt come from crate_universe (see MODULE.bazel) which
# reads the same file.
#
# This target is unsigned. Consumers should depend on `:run_hvf`
# below, which codesigns the binary with the Hypervisor entitlement
# (required by `hv_vm_create`). Internal name has an `_` so the
# genrule below can produce a file named `run-hvf` without colliding.
rust_binary(
    name = "run_hvf_unsigned",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    deps = [
        "@crates//:libc",
        "@crates//:vm-fdt",
    ],
)

# Codesigned binary — what consumers (bench.py, run-local.sh,
# test_hvf.sh, the `bazel run` wrapper) actually execute. Output
# path is `bazel-bin/tools/hvf-runner/run-hvf`, matching what every
# consumer already uses.
genrule(
    name = "run_hvf",
    srcs = [
        ":run_hvf_unsigned",
        "run-hvf.entitlements",
    ],
    outs = ["run-hvf"],
    cmd = " && ".join([
        "cp $(location :run_hvf_unsigned) $@",
        "chmod +w $@",
        "codesign --sign - --entitlements $(location run-hvf.entitlements) --force $@ 2>/dev/null",
    ]),
    executable = True,
)
