load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "run-hvf.entitlements",
])

# Native HVF runner. Built as a host-tool aarch64 macOS binary (see
# `target_compatible_with`); the Hypervisor framework is pulled in
# via `#[link(name = "Hypervisor", kind = "framework")]` in
# `src/hvf.rs`, so no explicit `rustc_flags` are needed here.
# Cargo.toml is the source of truth for crate deps; @crates//:libc /
# @crates//:vm-fdt come from crate_universe (see MODULE.bazel) which
# reads the same file.
#
# This target is unsigned. Consumers should depend on `:run_hvf`
# below, which codesigns the binary with the Hypervisor entitlement
# (required by `hv_vm_create`). Internal name has an `_` so the
# genrule below can produce a file named `run-hvf` without colliding.
rust_binary(
    name = "run_hvf_unsigned",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    target_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
    deps = [
        "@crates//:libc",
        "@crates//:vm-fdt",
    ],
)

# Codesigned binary — what consumers (bench.py, the `_hvf_variant`
# rule in //bazel/rules:variants.bzl) actually execute. Output path
# is `bazel-bin/tools/hvf-runner/run-hvf`.
#
# `run_hvf_unsigned` goes in `tools` (exec cfg), not `srcs` (target
# cfg), so it's built for the host platform regardless of what the
# outer build is targeting. Without this, target-cfg rules that
# depend on this genrule (e.g. a variant rule running under its
# aarch64_waitless transition) would drag the inner rust_binary
# onto the unikernel platform and fail its os:macos constraint.
# Host-native unit tests for the aarch64 MMIO instruction decoder.
# Pure-logic — given a 32-bit instruction word, return the
# `MmioAccess` shape (load/store, size, register, sign-extension).
# No HVF / libc deps, so the same source compiles fine under the
# `rust_test` panic=unwind harness on any host. The wrapper in
# //bazel/rules:rust.bzl handles host vs unikernel gating.
rust_test(
    name = "decoder_test",
    size = "small",
    srcs = ["src/decoder.rs"],
    crate_root = "src/decoder.rs",
)

genrule(
    name = "run_hvf",
    srcs = ["run-hvf.entitlements"],
    outs = ["run-hvf"],
    cmd = " && ".join([
        "cp $(execpath :run_hvf_unsigned) $@",
        "chmod +w $@",
        "codesign --sign - --entitlements $(location run-hvf.entitlements) --force $@ 2>/dev/null",
    ]),
    executable = True,
    tools = [":run_hvf_unsigned"],
)
