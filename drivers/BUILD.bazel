load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Rust device drivers: PCI, VirtIO PCI, Virtqueue, VirtIO-net.
rust_library(
    name = "drivers_rs",
    srcs = ["drivers.rs"],
    crate_name = "drivers",
    edition = "2024",
    deps = [
        "//kernel:kernel_rs",
    ],
    rustc_flags = ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)
