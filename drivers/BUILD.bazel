load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_static_library")

package(default_visibility = ["//visibility:public"])

# Rust device drivers: PCI, VirtIO PCI, Virtqueue, VirtIO-net.
# Exports driver_* extern "C" symbols consumed by drivers_ffi (for kernel calls)
# and by entry.cc / net_ffi.cc / uni/ffi.cc.
rust_static_library(
    name = "drivers_rs",
    srcs = ["drivers.rs"],
    crate_name = "drivers",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# C FFI bridge: exposes kernel functions to the Rust driver crate.
cc_library(
    name = "drivers_ffi",
    srcs = ["drivers_ffi.cc"],
    deps = [
        "//kernel:core",
        "//kernel:arch_h",
        "//kernel:arch_init",
    ] + select({
        "//bazel/platforms:aarch64": [
            "//kernel:fdt",
            "//kernel:mmu",
        ],
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

cc_library(
    name = "pci",
    srcs = ["pci.cc"],
    hdrs = ["pci.h"],
    # No dep on kernel:core (serial.h) to break a build cycle:
    # kernel:core → virtio_console → virtio_pci → pci.
    # pci.cc forward-declares serial::printf; linker resolves at link time.
    deps = ["//kernel:arch_h", "//kernel:fdt"] + select({
        "//bazel/platforms:aarch64": ["//kernel:mmu"],
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

cc_library(
    name = "virtio_pci",
    srcs = ["virtio_pci.cc"],
    hdrs = ["virtio_pci.h"],
    # Same cycle-breaking strategy as pci: no dep on kernel:core.
    deps = [":pci", "//kernel:arch_h"] + select({
        "//bazel/platforms:aarch64": ["//kernel:mmu"],
        "//conditions:default": [],
    }),
    copts = ["-I."],
)

cc_library(
    name = "virtio_console",
    srcs = ["virtio_console.cc"],
    hdrs = ["virtio_console.h"],
    # Deps kept minimal to avoid circular dependency:
    # kernel:core (aarch64/serial.cc) → drivers:virtio_console.
    deps = ["//kernel:arch_h", ":virtio_pci"],
    copts = ["-I."],
)
