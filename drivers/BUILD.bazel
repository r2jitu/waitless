load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Shared hardware-access layer: MMIO helpers, PCI enumeration, VirtIO
# transport, virtio-console. The NIC driver crates depend here; the
# NIC-dispatch layer is the sibling `:nic` crate.
rust_library(
    name = "drivers",
    srcs = [
        "src/lib.rs",
        "src/pci.rs",
        "src/virtio.rs",
        "src/virtio_console.rs",
    ],
    crate_name = "uni_drivers",
    crate_root = "src/lib.rs",
    deps = [
        "//kernel",
    ],
)

# NIC dispatch layer: thin wrappers over the `uni_net_driver`
# active-ops slot (`send`, `poll`, `acquire_tx_buf`, …). Standalone
# host-buildable crate — its only dependency is the host-buildable
# `//uni-net:driver` interface crate — so the TX-side net crates
# (`net_eth_tx`, `net_tcp`, …) can call the dispatchers without being
# dragged onto the os:none `:drivers` crate.
rust_library(
    name = "nic",
    srcs = ["src/nic.rs"],
    crate_name = "nic",
    crate_root = "src/nic.rs",
    deps = ["//uni-net:driver"],
)
