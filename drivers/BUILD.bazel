load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Shared hardware-access infra: MMIO helpers, PCI enumeration, VirtIO
# transport, virtio-console. NIC driver crates depend here.
rust_library(
    name = "infra",
    srcs = [
        "src/infra.rs",
        "src/pci.rs",
        "src/virtio.rs",
        "src/virtio_console.rs",
    ],
    crate_name = "drivers_infra",
    crate_root = "src/infra.rs",
    deps = [
        "//kernel",
    ],
)

# Outer umbrella: NIC dispatcher (trait-dispatched via
# `uni_net_driver::active_driver`) + `pub use drivers_infra::*`. Does
# NOT depend on specific NIC crates — apps pick their drivers via
# `unikernel_binary(drivers = [...])`.
rust_library(
    name = "drivers",
    srcs = [
        "src/lib.rs",
        "src/net.rs",
    ],
    crate_name = "uni_drivers",
    crate_root = "src/lib.rs",
    deps = [
        ":infra",
        "//kernel",
        "//uni-net:driver",
    ],
)
