load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# x86_64-unknown-none compiles with `+soft-float` baked in. AES-GCM
# inlines 128-bit vector ops (`__m128i`, pclmulqdq) into call sites,
# so any crate that calls into `aes-gcm` for AES-128-GCM packet
# protection also needs the SSE/AES/PCLMUL target features turned
# on. Same fix as the per-crate annotations in MODULE.bazel — applied
# here at the rust_library level so the x86 build of //uni-quic itself
# (and downstream crates that monomorphise its types) compiles.
_X86_CRYPTO_FLAG = "-Ctarget-feature=-soft-float,+sse,+sse2,+sse3,+ssse3,+sse4.1,+sse4.2,+avx,+avx2,+aes,+pclmulqdq,+fma,+bmi1,+bmi2"

# QUIC v1 protocol stack (RFC 9000 + RFC 9001).
#
# Owns the FULL QUIC implementation: sans-io wire-format primitives
# (`wire`, `frame`, `crypto`), the TLS 1.3 handshake driver wrapped
# over CRYPTO frames (`tls`), the per-connection state machine
# (`conn`), per-connection async inbox (`inbox`), and the UDP
# endpoint that routes datagrams to conn tasks (`endpoint`). Depends
# on `//uni-tls` for the sans-io TLS bits (`schedule`, `aead`,
# `handshake`) plus the cert / signing-key types reused across
# both protocols.
rust_library(
    name = "uni-quic",
    srcs = [
        "src/lib.rs",
        # Observability: per-reason atomic counters + the
        # `quic_drop!` / `quic_event!` macros that wrap every
        # silent-drop site so failures are visible to the operator.
        "src/diag.rs",
        # Sans-io QUIC primitives (formerly //net:quic_{wire,frame,crypto}).
        "src/crypto.rs",
        "src/frame.rs",
        "src/transport_params.rs",
        "src/wire.rs",
        # TLS-handshake-over-CRYPTO-frames driver + connection state
        # machine + async inbox + UDP endpoint + streams.
        "src/conn.rs",
        "src/endpoint.rs",
        "src/inbox.rs",
        "src/streams.rs",
        "src/tls.rs",
    ],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    crate_name = "uni_quic",
    rustc_flags = select({
        "@platforms//cpu:x86_64": [_X86_CRYPTO_FLAG],
        "//conditions:default": [],
    }),
    deps = [
        "//uni",
        "//uni-iobuf",
        "//uni-net:driver",
        "//uni-runtime",
        "//uni-tls",
        "@crates//:aes-gcm",
        "@crates//:getrandom",
        "@crates//:hmac",
        "@crates//:p256",
        "@crates//:sha2",
    ],
)

# Host-native unit tests for in-crate `mod tests` blocks (wire-format
# parsing, frame round-trips, AEAD seal/open, packet-number decode,
# slot-table allocator, end-to-end self handshake).
rust_test(
    name = "uni_quic_test",
    size = "small",
    crate = ":uni-quic",
)
