# Rust unikernel application placeholder.
#
# Rust integration approach:
#   - Use rules_rust (https://github.com/nickel-org/rules_rust) with a
#     custom no_std Rust toolchain targeting x86_64-unknown-none.
#   - The Rust application crate is compiled as a staticlib (crate_type = "staticlib")
#     which produces a .a archive compatible with lld linking.
#   - The Rust staticlib links against the C++ kernel runtime via FFI:
#       - Kernel services (serial output, memory allocation, network I/O)
#         are exposed as extern "C" functions from the C++ kernel:core library.
#       - The Rust crate declares these as extern "C" { fn ... } bindings.
#   - The final unikernel ELF is produced by a cc_binary that links:
#       1. kernel:boot (assembly entry point _start)
#       2. kernel:core, kernel:arch_init (C++ kernel runtime)
#       3. drivers:virtio_net (C++ device drivers)
#       4. net (C++ network stack)
#       5. The Rust staticlib (application logic)
#   - The linker script (bazel/toolchain/unikernel.ld) controls the final
#     memory layout identically to C++ unikernel applications.
#
# Example (not yet functional):
#
#   load("@rules_rust//rust:defs.bzl", "rust_library")
#   load("//bazel/rules:unikernel.bzl", "unikernel_binary")
#
#   rust_library(
#       name = "webserver_rust_lib",
#       srcs = ["src/main.rs"],
#       crate_type = "staticlib",
#       edition = "2021",
#       rustc_flags = [
#           "-C", "panic=abort",
#           "-C", "code-model=kernel",
#           "-C", "relocation-model=static",
#       ],
#   )
#
#   # Wrap in cc_binary to link with the C++ kernel runtime
#   unikernel_binary(
#       name = "webserver_rust",
#       srcs = [],
#       deps = [":webserver_rust_lib"],
#   )

package(default_visibility = ["//visibility:public"])
