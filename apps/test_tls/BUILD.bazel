load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "app",
    srcs = ["main.rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//kernel",
        "//uni",
        "//net:tls",
        "//net:tls_crypto",
    ],
)

unikernel_binary(
    name = "test_tls",
    app = ":app",
)

# TLS primitives smoke test — full handshake / AEAD stack inside
# a real guest boot. Default variant set (hvf + qemu_<arch>); the
# ISO boot path is already covered by :test_tls_iso as a runnable
# target even though it's skipped from the default test fan-out.
unikernel_app_test(
    name = "test",
    app_base = "test_tls",
    test_rule = py_test,
    srcs = ["test.py"],
    deps = ["//scripts:test_helpers"],
    tags = [
        "exclusive",
        "local",
    ],
    timeout = "long",
)
