load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "app",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    # No `//kernel` dep: the test used to hit `kernel::rng` directly,
    # which pinned the app to the unikernel platform; it now goes
    # through `uni::rng::fill_bytes` (platform-agnostic wrapper), so
    # the whole test runs natively too.
    deps = [
        "//uni",
        "//uni-tls",
    ],
)

unikernel_binary(
    name = "test_tls",
    app = ":app",
)

# TLS primitives smoke test. Uses `uni::rng::fill_bytes` (cfg-
# switched between kernel RNG on unikernel and getentropy(2) on
# native), so the same source runs under every variant in the
# default test set — no explicit `variants = [...]` needed. Native
# is the fastest runner (no VM boot) and catches regressions in
# the crypto routines orders of magnitude faster than HVF/QEMU.
unikernel_app_test(
    name = "test",
    timeout = "short",
    srcs = ["test.py"],
    app_base = "test_tls",
    tags = [
        "exclusive",
        "local",
    ],
    test_rule = py_test,
    deps = ["//scripts:test_helpers"],
)
