load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "app",
    srcs = ["main.rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//uni",
        "//kernel",
    ],
)

unikernel_binary(
    name = "test_smp",
    app = ":app",
)

# SMP boot + IPI test — QEMU-only (needs `-smp 4`; HVF's
# single-NUMA Hypervisor.framework path isn't wired up for this app).
unikernel_app_test(
    name = "test",
    app_base = "test_smp",
    test_rule = py_test,
    srcs = ["test.py"],
    deps = ["//scripts:test_helpers"],
    variants = ["qemu_aarch64", "qemu_x86_64"],
    tags = [
        "exclusive",
        "local",
    ],
    timeout = "long",
)
