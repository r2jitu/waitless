load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "app",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = [
        "//crates/kernel/sys",
        "//crates/uni/uni",
    ],
)

# Defaults to 4 vCPUs because the whole point of the test is
# exercising SMP startup + IPI delivery. Serial-log-only
# assertions → no port forwards needed (the default is `[]`).
unikernel_binary(
    name = "test_smp",
    app = ":app",
    # App depends on `//kernel` (SMP startup + IPI paths), which is
    # unikernel-only. Skip the `_native` target — it would fail with
    # a transitive `@platforms//os:none` incompatibility.
    build_native = False,
    cpus = 4,
)

# SMP boot + IPI test. Runs on HVF (real aarch64 hardware) + both
# QEMU TCG arches. Native is excluded: the test's core/IPI path
# goes through `kernel::*` which is unikernel-only.
unikernel_app_test(
    name = "test",
    timeout = "short",
    srcs = ["test.py"],
    app_base = "test_smp",
    tags = [
        "exclusive",
        "local",
    ],
    test_rule = py_test,
    variants = [
        "hvf",
        "qemu_aarch64",
        "qemu_x86_64",
    ],
    deps = ["//scripts:test_helpers"],
)
