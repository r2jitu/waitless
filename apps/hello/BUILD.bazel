load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "port_fwd", "unikernel_binary")

package(default_visibility = ["//visibility:public"])

# Minimal hello-world app — the shortest possible unikernel binary
# that still handles HTTP. Serves as the README's framework example;
# contrast with //apps/webserver for a richer demo (TLS, multiple
# routes, diagnostics).
rust_library(
    name = "app",
    srcs = ["main.rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//uni",
        "//uni-http:uni_http",
    ] + select({
        # NIC driver is bare-metal-only (`os:none`). On native the
        # app reaches the network through POSIX sockets via
        # `//uni-native`, so no driver crate is needed.
        #
        # virtio-net covers QEMU / HVF / default GCE. hello doesn't
        # target gVNIC instances, so it skips the gve crate; a
        # gVNIC-flavoured variant of this app would add
        # `//uni-driver-gve` instead.
        "//bazel/platforms:native": [],
        "//conditions:default": ["//uni-driver-virtio-net:uni_driver_virtio_net"],
    }),
)

# hello only serves plain HTTP, so the launcher only needs one
# forward — HTTPS + UDP echo forwards would just sit idle.
unikernel_binary(
    name = "hello",
    app = ":app",
    port_forwards = [
        port_fwd("tcp", guest = 80, host = 8080),
    ],
)
