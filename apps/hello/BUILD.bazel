load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:waitless.bzl", "port_fwd", "waitless_binary")

package(default_visibility = ["//visibility:public"])

# Minimal hello-world app — the shortest possible unikernel binary
# that still handles HTTP. Serves as the README's framework example;
# contrast with //apps/webserver for a richer demo (TLS, multiple
# routes, diagnostics).
rust_library(
    name = "app",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = [
        "//crates/proto/http",
        "//crates/waitless",
    ],
)

# hello only serves plain HTTP, so the launcher only needs one
# forward — HTTPS + UDP echo forwards would just sit idle.
# hello doesn't target gVNIC instances, so it skips the gve crate;
# a gVNIC-flavoured variant would add `//crates/drivers/gve` too.
waitless_binary(
    name = "hello",
    app = ":app",
    drivers = ["//crates/drivers/virtio-net"],
    port_forwards = [
        port_fwd(
            "tcp",
            guest = 80,
            host = 8080,
        ),
    ],
)
