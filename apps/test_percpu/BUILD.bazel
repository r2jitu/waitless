load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "app",
    srcs = ["main.rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//uni",
        "//kernel",
    ],
)

# Defaults to 4 vCPUs because the per-core state tests need them.
# Serial-log-only assertions → no port forwards needed.
unikernel_binary(
    name = "test_percpu",
    app = ":app",
    cpus = 4,
)

# Per-core state test. Runs on HVF (real aarch64 hardware) + both
# QEMU TCG arches. Native excluded (test exercises kernel::percpu).
unikernel_app_test(
    name = "test",
    app_base = "test_percpu",
    test_rule = py_test,
    srcs = ["test.py"],
    deps = ["//scripts:test_helpers"],
    variants = ["hvf", "qemu_aarch64", "qemu_x86_64"],
    tags = [
        "exclusive",
        "local",
    ],
    timeout = "short",
)
