load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "app",
    srcs = ["main.rs"],
    deps = [
        "//kernel",
        "//uni",
    ],
)

# Defaults to 4 vCPUs because the per-core state tests need them.
# Serial-log-only assertions → no port forwards needed.
unikernel_binary(
    name = "test_percpu",
    app = ":app",
    cpus = 4,
)

# Per-core state test. Runs on HVF (real aarch64 hardware) + both
# QEMU TCG arches. Native excluded (test exercises kernel::percpu).
unikernel_app_test(
    name = "test",
    timeout = "short",
    srcs = ["test.py"],
    app_base = "test_percpu",
    tags = [
        "exclusive",
        "local",
    ],
    test_rule = py_test,
    variants = [
        "hvf",
        "qemu_aarch64",
        "qemu_x86_64",
    ],
    deps = ["//scripts:test_helpers"],
)
