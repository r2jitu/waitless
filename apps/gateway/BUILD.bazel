load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:waitless.bzl", "port_fwd", "waitless_binary")

package(default_visibility = ["//visibility:public"])

# Reverse-proxy / API-gateway example — the canonical "my handler
# calls another service" shape, and the showcase for the client roles
# (`http::client::get`). The front door is plain HTTP; each request
# drives ONE outbound HTTP/1.1 GET to a backend and relays the result.
# Contrast //apps/hello (one static response) and //apps/webserver
# (TLS + h2/h3 + many routes).
#
# `http::client::get` lives in //crates/proto/http, and the runtime
# (`Net::up`, `timeout_us`, `IpAddr`) in //crates/waitless — same two
# deps as hello; no extra crate is needed for the outbound fetch.
rust_library(
    name = "app",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = [
        "//crates/proto/http",
        "//crates/waitless",
    ],
)

# Both NIC drivers, matching //apps/webserver: virtio-net covers
# QEMU / HVF / the default GCE image; gve covers GCE instances
# launched with --network-interface=nic-type=GVNIC (the bench VMs).
# gateway only serves plain HTTP, so a single :80 forward suffices.
waitless_binary(
    name = "gateway",
    app = ":app",
    drivers = [
        "//crates/drivers/virtio-net",
        "//crates/drivers/gve",
    ],
    port_forwards = [
        port_fwd(
            "tcp",
            guest = 80,
            host = 8080,
        ),
    ],
)
