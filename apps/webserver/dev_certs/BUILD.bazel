package(default_visibility = ["//visibility:public"])

# Pre-generated self-signed ECDSA P-256 dev cert. Loaded into unikernel
# binaries via include_bytes!() — see README.md for the regeneration
# story and the deferred-work entry in ROADMAP.md for the production
# cert + RNG path.
exports_files([
    "dev_cert.der",
    "dev_key.der",
    "dev_cert.pem",
    "dev_key.pem",
    # Empty placeholder — the dev cert is self-signed, so its chain
    # has no intermediate. The `app` rule's `tls_intermediate` alias
    # points here for the dev build; `main.rs` reads an empty slice
    # and emits a one-element (leaf-only) certificate chain.
    "no_intermediate.der",
])
