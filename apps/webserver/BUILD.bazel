load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:integration_test.bzl", "integration_data")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_variants")

package(default_visibility = ["//visibility:public"])

# Application library — pure business logic, no platform boilerplate.
rust_library(
    name = "app",
    srcs = ["main.rs"],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = ["//uni"],
)

unikernel_binary(
    name = "webserver",
    app = ":app",
)

# Per-runner variant targets. `bazel run :webserver_hvf` is a
# drop-in for `bazel run --config=hvf :webserver`; the former is
# preferred because it doesn't require a whole-build config flag
# (which would invalidate analysis cache when switching runners).
# See `//bazel/rules:variants.bzl`.
unikernel_variants(src = ":webserver")

# `integration_data` wraps `:webserver` under a one-hop Bazel transition
# that re-asserts `-Cpanic=abort` for the unikernel dep-graph. Without
# it, `bazel test`'s `-Cpanic=unwind` default (needed by the libtest
# harness) would propagate to the `data = [":webserver"]` subgraph and
# fail to compile the `#![no_std]` rlibs. See `integration_test.bzl`
# for the full rationale.
integration_data(
    name = "webserver_for_test",
    src = ":webserver",
)

# One test covers every runner: it lists :webserver (via the wrapper
# above) as a data dep, spawns it as a subprocess, and probes HTTP /
# HTTPS / UDP, plus a PTY-driven Ctrl-C regression check. Runner-
# specific launch logic lives in the :webserver target — the test
# doesn't need to know HVF from QEMU from ISO from native.
py_test(
    name = "test",
    timeout = "long",
    srcs = ["test.py"],
    deps = ["//scripts:test_helpers"],
    data = [
        ":webserver_for_test",
        "//apps/webserver/dev_certs:dev_cert.pem",
    ],
    tags = [
        "exclusive",
        "local",
    ],
)
