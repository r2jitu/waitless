load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:waitless.bzl", "port_fwd", "waitless_binary")
load("//bazel/rules:variants.bzl", "waitless_app_test")

package(default_visibility = ["//visibility:public"])

# ── Production TLS certificate selection ─────────────────────────────────
#
# By default the app bakes in the checked-in self-signed dev cert
# (`dev_certs/`), so `bazel build` / `bazel test` need no flags. A
# `--define tls_cert=prod` build swaps in the real Let's Encrypt cert
# from `prod_certs/` (gitignored — populated by `scripts/issue-cert.sh`).
# The renewal pipeline rebuilds with that define; it never edits
# tracked source. `main.rs` reads the three files via `include_bytes!`
# of the `WAITLESS_TLS_*` paths the `app` rule's `rustc_env` sets.
config_setting(
    name = "prod_tls_cert",
    values = {"define": "tls_cert=prod"},
)

alias(
    name = "tls_leaf",
    actual = select({
        ":prod_tls_cert": "//apps/webserver/prod_certs:leaf",
        "//conditions:default": "//apps/webserver/dev_certs:dev_cert.der",
    }),
)

alias(
    name = "tls_intermediate",
    actual = select({
        ":prod_tls_cert": "//apps/webserver/prod_certs:intermediate",
        "//conditions:default": "//apps/webserver/dev_certs:no_intermediate.der",
    }),
)

alias(
    name = "tls_key",
    actual = select({
        ":prod_tls_cert": "//apps/webserver/prod_certs:key",
        "//conditions:default": "//apps/webserver/dev_certs:dev_key.der",
    }),
)

# Application library — pure business logic, no platform boilerplate.
#
# Deliberately depends on NO driver crate. `app` is compiled into
# both the unikernel image and the native `webserver_bin`; any
# `os:none`-only crate in its deps (the gve driver, once, for
# `/stats` counters — now reached via `waitless::diagnostics::gve_diag`)
# makes the native binary unbuildable. The `:test_native` variant
# of `:test` below builds and runs `webserver_bin`, so `bazel test`
# catches such a leak.
rust_library(
    name = "app",
    srcs = [
        "src/endpoints.rs",
        "src/main.rs",
        "src/pages.rs",
    ],
    compile_data = [
        ":tls_intermediate",
        ":tls_key",
        ":tls_leaf",
    ],
    crate_root = "src/main.rs",
    # The `/connect-probe` + `/fetch-probe` client-path E2E endpoints are
    # an outbound-fetch (SSRF-shaped) affordance — fine for dev/bench/GCE
    # validation (which run the dev cert), but they must NOT exist on the
    # hardened public deploy. Gate on the SAME switch as the cert: the
    # `tls_cert=prod` build compiles them out entirely; every other build
    # (dev cert) keeps them. Dev affordances and the dev cert travel
    # together; production carries neither.
    rustc_flags = select({
        ":prod_tls_cert": [],
        "//conditions:default": ["--cfg=probe_endpoints"],
    }),
    # `main.rs` `include_bytes!`s the TLS cert material from these
    # paths. `$(execpath ...)` resolves the selected `dev_certs/` or
    # `prod_certs/` file to an exec-root-relative path, which rustc
    # reads at compile time.
    rustc_env = {
        "WAITLESS_TLS_INTERMEDIATE": "$(execpath :tls_intermediate)",
        "WAITLESS_TLS_KEY": "$(execpath :tls_key)",
        "WAITLESS_TLS_LEAF": "$(execpath :tls_leaf)",
    },
    deps = [
        "//crates/proto/http",
        # http2 / http3 are reached transitively via `https::serve`; the
        # direct deps are for their `diag` blocks in /obs.
        "//crates/proto/http2",
        "//crates/proto/http3",
        # The all-transports HTTPS facade (https::serve over h2 + h3).
        "//crates/proto/https",
        "//crates/proto/quic",
        # tls is still a direct dep for the boot-time AEAD KAT and the
        # `tls_profile_*` diagnostics endpoints (+ `ServerAuth` for
        # /fetch-probe's pin option).
        "//crates/proto/tls",
        "//crates/waitless",
        # /fetch-probe hashes the fetched body (workspace crate the
        # TLS stack already pulls; no new external dep).
        "@crates//:sha2",
        # Direct dep for installing the per-core egress-drain hook
        # (`eventloop::set_egress_drain`) — docs/tx-backpressure.md stage 3.
        "//crates/kernel/bare",
    ],
)

waitless_binary(
    name = "webserver",
    app = ":app",
    # Runtime picks whichever probes successfully: virtio-net covers
    # QEMU / HVF / the default GCE image; gve covers GCE instances
    # launched with --network-interface=nic-type=GVNIC.
    drivers = [
        "//crates/drivers/virtio-net",
        "//crates/drivers/gve",
    ],
    port_forwards = [
        port_fwd(
            "tcp",
            guest = 80,
            host = 8080,
        ),
        port_fwd(
            "tcp",
            guest = 443,
            host = 8443,
        ),
        port_fwd(
            "udp",
            guest = 443,
            host = 8443,
        ),
        port_fwd(
            "udp",
            guest = 7,
            host = 8007,
        ),
        port_fwd(
            "tcp",
            guest = 9,
            host = 8009,
        ),
    ],
)

# Per-variant integration tests (generates `:test_hvf`, `:test_iso`,
# `:test_qemu_aarch64`, `:test_qemu_x86_64`). test.py reads
# `LAUNCHER_NAME` from env to resolve the per-variant runfile —
# runner-agnostic. HVF auto-skips on non-macOS hosts.
waitless_app_test(
    name = "test",
    timeout = "short",
    srcs = ["test.py"],
    app_base = "webserver",
    extra_data = ["//apps/webserver/dev_certs:dev_cert.pem"],
    tags = [
        "exclusive",
        "local",
    ],
    test_rule = py_test,
    deps = [
        "//scripts:test_helpers",
        # `aioquic` is the QUIC client driving `test_h3_*` cases.
        # Wheel + transitive deps come from the pip hub generated in
        # MODULE.bazel from `//:requirements.txt`.
        requirement("aioquic"),
    ],
)

# Multi-core integration test. HVF-only: Apple's Hypervisor.framework
# runs real hardware-virtualised vCPUs, which is what the guest's
# Tier-1 per-core RX-queue polling and `spawn_on_each_worker` hooks
# need to actually exercise. QEMU/TCG's 4-vCPU boot is slow enough
# that adding another 30-second test per `bazel test //...` run
# isn't worth it for a fallback path.
waitless_app_test(
    name = "test_mc",
    timeout = "short",
    srcs = ["test_mc.py"],
    app_base = "webserver",
    tags = [
        "exclusive",
        "local",
    ],
    test_rule = py_test,
    variants = ["hvf"],
    deps = ["//scripts:test_helpers"],
)
