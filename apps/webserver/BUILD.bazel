load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "HTTP_HTTPS_UDP_FORWARDS", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

# Application library — pure business logic, no platform boilerplate.
rust_library(
    name = "app",
    srcs = ["main.rs"],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = ["//uni"],
)

unikernel_binary(
    name = "webserver",
    app = ":app",
    port_forwards = HTTP_HTTPS_UDP_FORWARDS,
)

# Per-variant integration tests (generates `:test_hvf`, `:test_iso`,
# `:test_qemu_aarch64`, `:test_qemu_x86_64`). test.py reads
# `LAUNCHER_NAME` from env to resolve the per-variant runfile —
# runner-agnostic. HVF auto-skips on non-macOS hosts.
unikernel_app_test(
    name = "test",
    app_base = "webserver",
    test_rule = py_test,
    srcs = ["test.py"],
    deps = ["//scripts:test_helpers"],
    extra_data = ["//apps/webserver/dev_certs:dev_cert.pem"],
    tags = [
        "exclusive",
        "local",
    ],
    timeout = "short",
)
