load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")

package(default_visibility = ["//visibility:public"])

unikernel_binary(
    name = "webserver",
    srcs = ["main.cc"],
    copts = [
        "-I.",
        "-Iinclude",
    ],
)

# Friendly aliases so users can type:
#   bazel run //apps/webserver:run               (x86_64)
#   bazel run --config=aarch64 //apps/webserver:run  (aarch64)
alias(
    name = "run",
    actual = ":webserver_run",
)

# --- Integration tests -------------------------------------------------------
# Each target tests one boot environment. Skips (exit 0) if prerequisites
# are not available (e.g. QEMU not installed, wrong host platform).
#
#   bazel test //apps/webserver:test_vz                                 (macOS arm64 only)
#   bazel test //apps/webserver:test_qemu                               (uses current arch)
#   bazel test --config=x86_64 //apps/webserver:test_qemu               (force x86 QEMU)
#   bazel test --config=x86_64 //apps/webserver:test_limine             (Limine ISO, x86 only)

sh_test(
    name = "test_vz",
    srcs = ["test_vz.sh"],
    data = [
        ":webserver.img",
        "//scripts:run_vz",
    ],
    tags = ["local", "exclusive"],
    timeout = "long",
)

sh_test(
    name = "test_qemu",
    srcs = ["test_qemu.sh"],
    data = [
        ":webserver.elf",
        ":webserver.img",
    ],
    tags = ["local", "exclusive"],
    timeout = "long",
)

sh_test(
    name = "test_limine",
    srcs = ["test_limine.sh"],
    data = [
        ":webserver.elf",
        ":webserver.iso",
    ],
    tags = ["local", "exclusive"],
    timeout = "long",
)
