load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "port_fwd", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

# Application library — pure business logic, no platform boilerplate.
rust_library(
    name = "app",
    srcs = ["main.rs"],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//uni",
        "//uni-http:uni_http",
        "//uni-tls:uni_tls",
    ] + select({
        # NIC drivers are bare-metal-only (`os:none`). On native the
        # app reaches the network through POSIX sockets via
        # `//uni-native`, so no driver crates are needed.
        #
        # Runtime picks whichever probes successfully: virtio-net
        # covers QEMU / HVF / the default GCE image; gve covers GCE
        # instances launched with --network-interface=nic-type=GVNIC.
        "//bazel/platforms:native": [],
        "//conditions:default": [
            "//uni-driver-virtio-net:uni_driver_virtio_net",
            "//uni-driver-gve:uni_driver_gve",
        ],
    }),
)

unikernel_binary(
    name = "webserver",
    app = ":app",
    port_forwards = [
        port_fwd("tcp", guest = 80, host = 8080),
        port_fwd("tcp", guest = 443, host = 8443),
        port_fwd("udp", guest = 7, host = 8007),
    ],
)

# Per-variant integration tests (generates `:test_hvf`, `:test_iso`,
# `:test_qemu_aarch64`, `:test_qemu_x86_64`). test.py reads
# `LAUNCHER_NAME` from env to resolve the per-variant runfile —
# runner-agnostic. HVF auto-skips on non-macOS hosts.
unikernel_app_test(
    name = "test",
    app_base = "webserver",
    test_rule = py_test,
    srcs = ["test.py"],
    deps = ["//scripts:test_helpers"],
    extra_data = ["//apps/webserver/dev_certs:dev_cert.pem"],
    tags = [
        "exclusive",
        "local",
    ],
    timeout = "short",
)
