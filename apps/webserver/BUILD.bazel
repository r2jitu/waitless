load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")

package(default_visibility = ["//visibility:public"])

# Application library — pure business logic, no platform boilerplate.
rust_library(
    name = "app",
    srcs = ["main.rs"],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = ["//uni"],
)

unikernel_binary(
    name = "webserver",
    app = ":app",
)

# One test covers every runner: it lists :webserver (the launcher) as a
# data dep, spawns it as a subprocess, and probes HTTP / HTTPS / UDP,
# plus a PTY-driven Ctrl-C regression check. Runner-specific launch
# logic lives in the :webserver target — the test doesn't need to know
# HVF from QEMU from ISO from native.
#
# sh_test is a thin wrapper (test.sh) that exec's the real
# unittest-based test.py. rules_python isn't wired in this project;
# if that changes the test target can switch to py_test unchanged.
sh_test(
    name = "test",
    timeout = "long",
    srcs = ["test.sh"],
    data = [
        ":test.py",
        ":webserver",
        "//apps/webserver/dev_certs:dev_cert.pem",
    ],
    tags = [
        "exclusive",
        "local",
    ],
)
