load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")

package(default_visibility = ["//visibility:public"])

unikernel_binary(
    name = "webserver",
    srcs = ["main.cc"],
    copts = [
        "-I.",
        "-Iinclude",
    ],
)

# Friendly aliases so users can type:
#   bazel run //apps/webserver:run               (x86_64)
#   bazel run --config=aarch64 //apps/webserver:run  (aarch64)
alias(
    name = "run",
    actual = ":webserver_run",
)

# QEMU integration test: boots the webserver in QEMU and verifies HTTP.
# Architecture is determined by the build platform config:
#   bazel test //apps/webserver:integration_test
#   bazel test //apps/webserver:integration_test --platforms=//bazel/platforms:x86_64_unikernel
#
# Requirements: qemu-system-{x86_64,aarch64} (brew install qemu).
# Skips (exit 0) if the QEMU binary is missing.
sh_test(
    name = "integration_test",
    srcs = ["integration_test.sh"],
    data = [
        ":webserver.elf",
        ":webserver.img",
    ],
    tags = ["local", "exclusive"],
    timeout = "long",
)

# VZ.framework integration test: boots webserver via VZ.framework, verifies HTTP.
# macOS arm64 only — skips on other platforms.
#   bazel test //apps/webserver:integration_test_vz
sh_test(
    name = "integration_test_vz",
    srcs = ["integration_test_vz.sh"],
    data = [
        ":webserver.img",
        "//scripts:run_vz",
    ],
    tags = ["local", "exclusive"],
    timeout = "long",
)
