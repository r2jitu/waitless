load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")

package(default_visibility = ["//visibility:public"])

unikernel_binary(
    name = "webserver",
    app_srcs = ["main.rs"],
    app_deps = ["//net:http_rs", "//uni"],
)

# Friendly alias: bazel run //apps/webserver  (or :run)
alias(name = "run", actual = ":webserver_run")

# Integration test — runner selected by --config:
#   bazel test //apps/webserver:test                        (native, no VM)
#   bazel test --config=vz   //apps/webserver:test          (VZ.framework)
#   bazel test --config=qemu //apps/webserver:test          (QEMU, host arch)
#   bazel test --config=aarch64-qemu //apps/webserver:test  (explicit)
#   bazel test --config=x86_64-iso   //apps/webserver:test  (Limine ISO)
sh_test(
    name = "test",
    srcs = select({
        "//bazel/platforms:runner_vz":   ["test_vz.sh"],
        "//bazel/platforms:runner_qemu": ["test_qemu.sh"],
        "//bazel/platforms:runner_iso":  ["test_iso.sh"],
        "//conditions:default":          ["test_native.sh"],
    }),
    data = select({
        "//bazel/platforms:runner_vz": [
            ":webserver.img",
            "//scripts:run_vz",
            "//scripts:helpers.sh",
        ],
        "//bazel/platforms:runner_qemu": [
            ":webserver.elf",
            ":webserver.img",
            "//scripts:helpers.sh",
        ],
        "//bazel/platforms:runner_iso": [
            ":webserver.limine.elf",
            ":webserver.iso",
            "//scripts:helpers.sh",
        ],
        "//conditions:default": [
            ":webserver_native",
        ],
    }),
    tags = ["local", "exclusive"],
    timeout = "long",
)
