load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")

package(default_visibility = ["//visibility:public"])

# Application library — pure business logic, no platform boilerplate.
rust_library(
    name = "app",
    srcs = ["main.rs"],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = ["//uni"],
)

unikernel_binary(
    name = "webserver",
    app = ":app",
)

# Boot + Ctrl-C regression test. Sends a Ctrl-C byte to the guest serial
# under load and checks the VM exits within a short deadline — a guard
# against event-loop-starvation bugs (e.g. the virtio IRQ storm that used
# to wedge both HTTP and the shutdown path).
sh_test(
    name = "test_ctrlc",
    timeout = "short",
    srcs = ["test_ctrlc.sh"],
    data = ["//scripts:helpers.sh"] + select({
        "//bazel/platforms:runner_hvf": [
            ":webserver.img",
            "//tools/hvf-runner:run_hvf",
        ],
        "//bazel/platforms:runner_qemu": [
            ":webserver.elf",
            ":webserver.img",
        ],
        "//conditions:default": [],
    }),
    tags = [
        "exclusive",
        "local",
    ],
)

# One test script covers every runner: the test depends on the :webserver
# launcher as a data dep and spawns it as a subprocess, then probes the
# three service ports. Runner-specific launch logic stays exactly in the
# :webserver target — the test doesn't need to know about HVF vs QEMU vs
# ISO vs native.
sh_test(
    name = "test",
    timeout = "long",
    srcs = ["test.sh"],
    data = [
        ":webserver",
        "//apps/webserver/dev_certs:dev_cert.pem",
        "//scripts:helpers.sh",
    ],
    tags = [
        "exclusive",
        "local",
    ],
)
