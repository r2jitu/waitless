load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")

package(default_visibility = ["//visibility:public"])

unikernel_binary(
    name = "webserver",
    srcs = ["main.cc"],
    copts = [
        "-I.",
        "-Iinclude",
    ],
)

# Friendly aliases so users can type:
#   bazel run //apps/webserver:run                    (auto-detect VZ or QEMU)
#   bazel run //apps/webserver:run_vz                 (VZ.framework, macOS arm64)
#   bazel run //apps/webserver:run_qemu               (QEMU, any arch)
#   bazel run --config=x86_64 //apps/webserver:run_iso  (Limine ISO, x86_64)
alias(name = "run", actual = ":webserver_run")
alias(name = "run_vz", actual = ":webserver_run_vz")
alias(name = "run_qemu", actual = ":webserver_run_qemu")
alias(name = "run_iso", actual = ":webserver_run_iso")

# --- Integration tests -------------------------------------------------------
# Each target tests one boot environment. Skips (exit 0) if prerequisites
# are not available (e.g. QEMU not installed, wrong host platform).
#
#   bazel test //apps/webserver:test_vz                                 (macOS arm64 only)
#   bazel test //apps/webserver:test_qemu                               (uses current arch)
#   bazel test --config=x86_64 //apps/webserver:test_qemu               (force x86 QEMU)
#   bazel test --config=x86_64 //apps/webserver:test_iso                (Limine ISO, x86 only)

sh_test(
    name = "test_vz",
    srcs = ["test_vz.sh"],
    data = [
        ":webserver.img",
        "//scripts:run_vz",
        "//scripts:helpers.sh",
    ],
    target_compatible_with = ["@platforms//cpu:aarch64"],
    tags = ["local", "exclusive"],
    timeout = "long",
)

sh_test(
    name = "test_qemu",
    srcs = ["test_qemu.sh"],
    data = [
        ":webserver.elf",
        ":webserver.img",
        "//scripts:helpers.sh",
    ],
    tags = ["local", "exclusive"],
    timeout = "long",
)

sh_test(
    name = "test_iso",
    srcs = ["test_iso.sh"],
    data = [
        ":webserver.limine.elf",
        ":webserver.iso",
        "//scripts:helpers.sh",
    ],
    target_compatible_with = ["@platforms//cpu:x86_64"],
    tags = ["local", "exclusive"],
    timeout = "long",
)
