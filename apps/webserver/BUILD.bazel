load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

# Application library — pure business logic, no platform boilerplate.
rust_library(
    name = "app",
    srcs = ["main.rs"],
    deps = ["//uni"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

unikernel_binary(
    name = "webserver",
    app = ":app",
)

alias(name = "run", actual = ":webserver_run")

sh_test(
    name = "test",
    srcs = select({
        "//bazel/platforms:runner_vz":   ["test_vz.sh"],
        "//bazel/platforms:runner_qemu": ["test_qemu.sh"],
        "//bazel/platforms:runner_iso":  ["test_iso.sh"],
        "//conditions:default":          ["test_native.sh"],
    }),
    data = select({
        "//bazel/platforms:runner_vz": [
            ":webserver.img",
            "//scripts:run_vz",
            "//scripts:helpers.sh",
        ],
        "//bazel/platforms:runner_qemu": [
            ":webserver.elf",
            ":webserver.img",
            "//scripts:helpers.sh",
        ],
        "//bazel/platforms:runner_iso": [
            ":webserver.limine.elf",
            ":webserver.iso",
            "//scripts:helpers.sh",
        ],
        "//conditions:default": [
            ":webserver_native",
        ],
    }),
    tags = ["local", "exclusive"],
    timeout = "long",
)
