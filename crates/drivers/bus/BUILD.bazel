load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Shared bus/transport layer: MMIO helpers, PCI enumeration, VirtIO
# transport. The driver crates (`virtio-net`, `gve`, `virtio-console`)
# depend here for MMIO + bus enumeration; the NIC-dispatch shim lives
# in the sibling `//crates/drivers/nic` package.
rust_library(
    name = "bus",
    srcs = [
        "src/lib.rs",
        "src/pci.rs",
        "src/virtio.rs",
    ],
    crate_name = "bus",
    crate_root = "src/lib.rs",
    deps = [
        "//crates/kernel/bare",
    ],
)
