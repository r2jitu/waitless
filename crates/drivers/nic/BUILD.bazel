load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# NIC dispatch shim: thin wrappers over the `nic_api`
# active-ops slot (`send`, `poll`, `acquire_tx_buf`, …). Standalone
# host-buildable crate — its only dependency is the host-buildable
# `//crates/drivers/nic-api` interface crate — so the TX-side net
# crates (`ethernet_send`, `tcp`, …) can call the dispatchers
# without being dragged onto the os:none `//crates/drivers/bus`.
rust_library(
    name = "nic",
    srcs = ["src/nic.rs"],
    crate_name = "nic",
    crate_root = "src/nic.rs",
    deps = ["//crates/drivers/nic-api"],
)
