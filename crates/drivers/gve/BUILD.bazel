load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Google Virtual Ethernet driver (GCE). Uses `//drivers` only for
# MMIO + PCI; gve has its own BAR-register ABI, not VirtIO.
rust_library(
    name = "gve",
    srcs = [
        "src/adminq.rs",
        "src/diag.rs",
        "src/dqo.rs",
        "src/gqi.rs",
        "src/init.rs",
        "src/lib.rs",
        "src/rx.rs",
        "src/tx.rs",
    ],
    crate_name = "gve",
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        "//crates/drivers/bus",
        "//crates/drivers/nic:api",
        "//crates/kernel/bare",
        "//crates/util/iobuf",
        "//crates/util/obs",
        "//crates/util/sync",
    ],
)
