load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "uni",
    srcs = [
        "src/boot_info.rs",
        "src/lib.rs",
        "src/rng.rs",
    ],
    crate_root = "src/lib.rs",
    proc_macro_deps = ["//crates/uni/macros:uni_macros"],
    # `//uni-net` re-exported as `uni::net`. `//crates/uni/backend` is the
    # cfg-selected platform adapter (bare-metal or POSIX). `//kernel`
    # stays as a bare-metal-only direct dep because `uni/lib.rs`
    # itself calls into it for `cpu_id`, `eventloop::set_on_shutdown`,
    # and `rng::fill_bytes`.
    deps = [
        "//crates/uni/backend",
        "//crates/uni/net",
        "//crates/runtime/executor",
        "//crates/runtime/worker",
    ] + select({
        "//bazel/platforms:native": [],
        "//conditions:default": ["//crates/kernel/sys"],
    }),
)

rust_test(
    name = "boot_info_test",
    size = "small",
    srcs = ["src/boot_info.rs"],
    crate_root = "src/boot_info.rs",
    deps = ["//crates/runtime/worker"],
)
