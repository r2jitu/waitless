load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# The HTTP/2 server (RFC 7540 + HPACK RFC 7541).
#
# "h2" is HTTP/2-over-TLS, so this crate is the TLS/TCP HTTPS server:
# `http2::listen` runs the TLS handshake (via //crates/proto/tls), reads
# the negotiated ALPN, and serves h2 or — for the mandatory fallback —
# HTTP/1.1 (//crates/proto/http). The protocol half (`serve_conn`) stays
# generic over `http::HttpStream`, so only the listener pulls TLS/TCP.
# Parallels //crates/proto/http3 (which bundles its QUIC listener). The
# RFC 7541 Huffman table is shared with proto/http3 via
# //crates/proto/field-huffman.
rust_library(
    name = "http2",
    srcs = [
        "src/connect.rs",
        "src/diag.rs",
        "src/frame.rs",
        "src/hpack.rs",
        "src/lib.rs",
        "src/listen.rs",
        "src/server.rs",
        "src/static_table.rs",
    ],
    compile_data = [
        # connect.rs's loopback tests pin against the dev cert (same
        # include_bytes! pattern as //crates/proto/tls's client tests).
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    crate_name = "http2",
    deps = [
        # obs::{Counter, LastEvent} — observability primitives.
        "//crates/util/obs",
        # RFC 7541 Huffman (shared with proto/http3 — HPACK == QPACK table).
        "//crates/proto/field-huffman",
        "//crates/proto/http",
        "//crates/util/iobuf",
        # The TLS state machine the listener drives (listen.rs only).
        "//crates/proto/tls",
        "//crates/runtime/worker",
        "//crates/waitless",
    ],
)

rust_test(
    name = "http2_test",
    size = "small",
    crate = ":http2",
    # Test-only: the connect.rs loopback drives the REAL
    # `http::serve_conn`, whose idle `timeout_us` schedules a timer —
    # the test calls `executor::init(1)` so the wheel exists off-VM.
    deps = ["//crates/runtime/executor"],
)
