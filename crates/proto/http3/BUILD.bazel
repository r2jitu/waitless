load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# HTTP/3 server over //crates/proto/quic.
#
# Layered: H3 frames + QPACK (static-only) + H3Server. Re-uses the
# `http::Request` / `http::Response` shape so a single
# handler closure serves HTTP/1.1 over TCP+TLS and HTTP/3 over QUIC
# without any changes.
rust_library(
    name = "http3",
    srcs = [
        "src/client.rs",
        "src/diag.rs",
        "src/frame.rs",
        "src/huffman.rs",
        "src/lib.rs",
        "src/qpack.rs",
        "src/server.rs",
        "src/static_table.rs",
    ],
    compile_data = [
        # client.rs's loopback tests pin against the dev cert (same
        # include_bytes! pattern as http2's connect.rs tests).
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    crate_name = "http3",
    deps = [
        # obs::{Counter, LastEvent} — observability primitives.
        "//crates/util/obs",
        # RFC 7541 Huffman (shared with proto/http2 — HPACK == QPACK table).
        "//crates/proto/field-huffman",
        "//crates/proto/http",
        "//crates/proto/quic",
        # TlsClientConfig / ServerAuth for the h3 client's QUIC-TLS setup.
        "//crates/proto/tls",
        "//crates/waitless",
    ],
)

rust_test(
    name = "http3_test",
    size = "small",
    crate = ":http3",
    # The in-process h3 loopback drives spawned tasks via the executor.
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    deps = ["//crates/runtime/executor"],
)
