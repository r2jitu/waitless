load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# AES-GCM inlines 128-bit vector ops (`__m128i`, pclmulqdq) into call
# sites, so //crates/proto/quic (and downstream crates that monomorphise its
# types) pulls them in too. SSE2 -- the register class those need --
# is baked into the hard-float `@hardfloat_x86_64_none` target spec,
# so no ABI toggle is required. This flag is just the non-ABI
# x86_64-v3 SIMD perf baseline shared with the crypto crates (cf.
# `_X86_CRYPTO_FLAG` in MODULE.bazel).
_X86_CRYPTO_FLAG = "-Ctarget-feature=+sse3,+ssse3,+sse4.1,+sse4.2,+avx,+avx2,+aes,+pclmulqdq,+fma,+bmi1,+bmi2"

# QUIC v1 protocol stack (RFC 9000 + RFC 9001).
#
# Owns the FULL QUIC implementation: sans-io wire-format primitives
# (`wire`, `frame`, `crypto`), the TLS 1.3 handshake driver wrapped
# over CRYPTO frames (`tls`), the per-connection state machine
# (`conn`), per-connection async inbox (`inbox`), and the UDP
# endpoint that routes datagrams to conn tasks (`endpoint`). Depends
# on `//crates/proto/tls` for the sans-io TLS bits (`schedule`, `aead`,
# `handshake`) plus the cert / signing-key types reused across
# both protocols.
rust_library(
    name = "quic",
    srcs = [
        "src/lib.rs",
        # Observability: per-reason atomic counters + the
        # `quic_drop!` / `quic_event!` macros that wrap every
        # silent-drop site so failures are visible to the operator.
        "src/diag.rs",
        # DRR fair queue behind src/egress.rs (former crates/net/egress).
        "src/drr.rs",
        # Sans-io QUIC primitives (formerly //crates/net:quic_{wire,frame,crypto}).
        "src/crypto.rs",
        "src/frame.rs",
        "src/transport_params.rs",
        "src/wire.rs",
        # TLS-handshake-over-CRYPTO-frames driver + connection state
        # machine + async inbox + UDP endpoint + streams.
        # `conn` is split across submodules under `src/conn/` —
        # `mod.rs` holds the `Connection` struct + cheap accessors,
        # `keys.rs` the per-direction packet-protection ciphers,
        # `rx.rs` the inbound packet path, `tx.rs` outbound assembly
        # + AEAD seal, `loss.rs` the RFC 9002 loss / RTT machinery.
        "src/conn/mod.rs",
        "src/conn/cfg.rs",
        # Client role: `Connection::new_client` + the client-received
        # packets (Version Negotiation, Retry) + the RFC 9000 §7.3
        # transport-parameter CID authentication.
        "src/conn/client.rs",
        "src/conn/keys.rs",
        "src/conn/loss.rs",
        "src/conn/rx.rs",
        "src/conn/tx.rs",
        # Per-core egress scheduler (DRR fair queue) — docs/tx-backpressure.md
        # stage 3, the QUIC arm.
        "src/egress.rs",
        "src/endpoint.rs",
        "src/inbox.rs",
        "src/streams.rs",
        "src/time.rs",
        "src/tls.rs",
    ],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    crate_name = "quic",
    rustc_flags = select({
        "@platforms//cpu:x86_64": [_X86_CRYPTO_FLAG],
        "//conditions:default": [],
    }),
    deps = [
        "//crates/drivers/nic:api",
        "//crates/net/cc",
        # Per-core egress scheduler (DRR fair queue) — docs/tx-backpressure.md
        # stage 3, the QUIC arm (see src/egress.rs).
        "//crates/proto/tls",
        "//crates/runtime/executor",
        # `WorkerLocal` / `CurrentWorker` for the per-core egress state.
        "//crates/runtime/worker",
        "//crates/waitless",
        "//crates/util/iobuf",
        # `obs::{Counter, LastEvent, LatencyHist}` — the shared
        # observability primitives. QUIC is the doctrine's reference
        # implementation; see `docs/observability.md`.
        "//crates/util/obs",
        # AEAD packet protection: the hand-rolled stitched/batched
        # AES-128-GCM (`Aes128GcmFast`) that TLS already uses — far faster
        # per byte than RustCrypto's non-stitched `aes-gcm`. `@crates//:aes-gcm`
        # stays for the HP cipher (`aes_gcm::aes::Aes128`, one block/packet).
        "//crates/crypto/aes-gcm",
        "@crates//:aes-gcm",
        "@crates//:getrandom",
        "@crates//:hmac",
        "@crates//:p256",
        "@crates//:sha2",
    ],
)

# Host-native unit tests for in-crate `mod tests` blocks (wire-format
# parsing, frame round-trips, AEAD seal/open, packet-number decode,
# slot-table allocator, end-to-end self handshake).
rust_test(
    name = "quic_test",
    size = "small",
    crate = ":quic",
)
