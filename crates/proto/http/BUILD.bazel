load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# HTTP/1.1 server + client. Also hosts the `Tls` / `TlsConn` traits that
# `//crates/proto/tls` implements — keeps the HTTP path TLS-unaware so apps
# without `tls` link zero TLS / crypto code. The client half
# (`src/client.rs`: response parser, chunked decoder, request writer,
# `fetch`) is transport-generic over `HttpStream`; the TLS client
# stream that feeds it lives in //crates/proto/https (`client.rs`).
rust_library(
    name = "http",
    srcs = [
        "src/body.rs",
        "src/client.rs",
        "src/diag.rs",
        "src/lib.rs",
        "src/request.rs",
        "src/response.rs",
        "src/server.rs",
        "src/stream.rs",
        "src/streaming.rs",
    ],
    crate_name = "http",
    deps = [
        # obs::{Counter, LastEvent} — observability primitives.
        "//crates/util/obs",
        "//crates/runtime/worker",
        "//crates/waitless",
        "//crates/util/iobuf",
    ],
)

# Inline #[cfg(test)] unit tests — request parser (chunked-TE
# rejection, Host-header port parsing). Run via:
#   bazel test //crates/proto/http:http_test
rust_test(
    name = "http_test",
    size = "small",
    crate = ":http",
)
