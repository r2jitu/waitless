load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# HTTP/1.1 server. Also hosts the `Tls` / `TlsConn` traits that
# `//crates/proto/tls` implements — keeps the HTTP path TLS-unaware so apps
# without `tls` link zero TLS / crypto code.
rust_library(
    name = "http",
    srcs = [
        "src/body.rs",
        "src/lib.rs",
        "src/request.rs",
        "src/response.rs",
        "src/server.rs",
        "src/stream.rs",
    ],
    crate_name = "http",
    deps = [
        "//crates/runtime/worker",
        "//crates/uni/uni",
        "//crates/util/iobuf",
    ],
)

# Inline #[cfg(test)] unit tests — request parser (chunked-TE
# rejection, Host-header port parsing). Run via:
#   bazel test //crates/proto/http:uni_http_test
rust_test(
    name = "uni_http_test",
    size = "small",
    crate = ":http",
)
