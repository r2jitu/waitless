load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# The shared tagged-pointer Treiber free-list core. `IOBufPool`
# (//crates/util/iobuf) and `RxNodePool` (//kernel) both delegate their
# lock-free free list to the one `TaggedTreiberStack` here.
#
# Kept as a zero-dep `core`-only leaf crate — like //crates/util/atomic-fn —
# so rust_test consumers don't transitively inherit //kernel's
# RustCrypto / talc / panic=abort chain.
rust_library(
    name = "tagged-treiber",
    srcs = ["src/lib.rs"],
    crate_name = "tagged_treiber",
    crate_root = "src/lib.rs",
)

# Host-native unit tests, including an 8-thread ABA stress test for
# the Treiber stack. The `rust_test` wrapper from //bazel/rules:rust.bzl
# gates this on `tests_need_std` (it needs the std libtest harness +
# `-Cpanic=unwind`), so `bazel build //...` skips it and `bazel test`
# picks it up. Run via:
#   bazel test //crates/util/tagged-treiber:tagged_treiber_test
rust_test(
    name = "tagged_treiber_test",
    size = "small",
    crate = ":tagged-treiber",
)
