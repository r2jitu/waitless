load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "bare",
    srcs = [
        "src/cpu.rs",
        "src/cpu_info.rs",
        "src/eventloop.rs",
        "src/lib.rs",
        "src/mm.rs",
        "src/mmu.rs",
        "src/rng.rs",
        "src/runtime.rs",
        "src/serial.rs",
        "src/time.rs",
    ] + select({
        "//bazel/platforms:x86_64": [
            "src/x86_64/acpi.rs",
            "src/x86_64/apic.rs",
            "src/x86_64/boot_args.rs",
            "src/x86_64/gdt.rs",
            "src/x86_64/idt.rs",
            "src/x86_64/mod.rs",
            "src/x86_64/smp.rs",
        ],
        "//bazel/platforms:aarch64": [
            "src/aarch64/exceptions.rs",
            "src/aarch64/fdt.rs",
            "src/aarch64/mod.rs",
            "src/aarch64/smp.rs",
        ],
        "//conditions:default": [],
    }),
    crate_name = "kernel_bare",
    crate_root = "src/lib.rs",
    # `verbose_diag` is the opt-in cfg for high-volume diagnostic
    # prints (currently the per-core event-loop watchdog in
    # `eventloop::run`). Declared so `#[cfg(verbose_diag)]` doesn't
    # trip rustc's check-cfg lint; enable via `--cfg=verbose_diag`
    # in `rustc_flags` of this rule for a debug build (same pattern
    # as `tls_debug` in `//crates/proto/tls`). Off by default — the
    # watchdog adds a TSC read per event-loop iteration and emits
    # ~1.6 KB/s of serial across 8 cores, neither of which production
    # deployments want full-time.
    rustc_flags = [
        "--check-cfg=cfg(verbose_diag)",
    ],
    # Unikernel-only: links against MMU / APIC / IDT / boot-section
    # code that only makes sense under a bare-metal target. Host
    # compilation hits mach-o-unfriendly `#[link_section = ".boot_bss"]`
    # annotations. The rust_tests below are independent — they
    # `srcs = [...]` specific files directly and don't depend on this
    # library.
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        # `net_types` only — the Tier-2 RX inbox payload carries a
        # `ParsedL3` (see `percpu::RxChain`). `net_types` is a zero-dep
        # leaf, so this adds no cycle with the `net_*` crates that
        # depend back on `//kernel`.
        "//crates/net:types",
        "//crates/kernel/core",
        "//crates/runtime/executor",
        "//crates/runtime/worker",
        "//crates/runtime/platform",
        # `Spinlock` + the observability primitives — the leaf crates
        # hoisted out of `kernel_core` (see `docs/observability.md`).
        "//crates/util/obs",
        "//crates/util/sync",
        "@crates//:getrandom",
        "@crates//:sha2",
        "@crates//:talc",
    ] + select({
        "//bazel/platforms:aarch64": ["@crates//:fdt"],
        "//conditions:default": [],
    }),
)
