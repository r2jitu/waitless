load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "waitless",
    srcs = [
        "src/boot_info.rs",
        "src/lib.rs",
        "src/rng.rs",
    ],
    crate_root = "src/lib.rs",
    proc_macro_deps = ["//crates/waitless/macros:waitless_macros"],
    # `//crates/waitless/net` re-exported as `waitless::net`.
    # `//crates/waitless/backend:waitless_backend` is the cfg-selected platform
    # adapter (bare-metal or POSIX). `//kernel` stays as a bare-metal-
    # only direct dep because `waitless/lib.rs` itself calls into it for
    # `cpu_id`, `eventloop::set_on_shutdown`, and `rng::fill_bytes`.
    deps = [
        "//crates/runtime/executor",
        "//crates/runtime/worker",
        "//crates/waitless/backend:waitless_backend",
        "//crates/waitless/net",
    ] + select({
        "//bazel/platforms:os_none": ["//crates/kernel/bare"],
        "//conditions:default": [],
    }),
)

rust_test(
    name = "boot_info_test",
    size = "small",
    srcs = ["src/boot_info.rs"],
    crate_root = "src/boot_info.rs",
    deps = ["//crates/runtime/worker"],
)
