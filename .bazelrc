# --- x86_64 unikernel (default, for cloud deployments) ----------------------
build:unikernel --platforms=//bazel/platforms:x86_64_unikernel
build:unikernel --action_env=PATH

# --- aarch64 unikernel (for local macOS ARM / Apple Silicon) -----------------
build:aarch64 --platforms=//bazel/platforms:aarch64_unikernel
build:aarch64 --action_env=PATH

# --- Default architecture ----------------------------------------------------
# Falls back to x86_64.  On Apple Silicon, run ./scripts/setup-dev.sh once:
# it writes .bazelrc.local with "build --config=aarch64", which takes
# precedence so that plain "bazel build" and "bazel run" use the right arch.
build --config=unikernel

# --- Machine-local overrides (generated by setup-dev.sh, not committed) ------
try-import %workspace%/.bazelrc.local
