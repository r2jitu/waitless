# --- x86_64 unikernel --------------------------------------------------------
build:x86_64 --platforms=//bazel/platforms:x86_64_unikernel
build:x86_64 --action_env=PATH

# --- aarch64 unikernel (for local macOS ARM / Apple Silicon) -----------------
build:aarch64 --platforms=//bazel/platforms:aarch64_unikernel
build:aarch64 --action_env=PATH

# --- Default architecture (x86_64) ------------------------------------------
# Set directly (not via --config=x86_64) so that --config=aarch64 on the
# command line only expands --platforms once, avoiding the "expanded from
# multiple configs" warning.  On Apple Silicon, run ./scripts/setup-dev.sh
# once to generate .bazelrc.local with "build --config=aarch64".
build --platforms=//bazel/platforms:x86_64_unikernel
build --action_env=PATH

# --- Machine-local overrides (generated by setup-dev.sh, not committed) ------
try-import %workspace%/.bazelrc.local
