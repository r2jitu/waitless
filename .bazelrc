# ── Global ────────────────────────────────────────────────────────────────────
build --action_env=PATH

# Rust compiler flags applied to all crates.
#
# Global `panic=abort` because every rust_library in this repo is
# `#![no_std]` (or `#![cfg_attr(not(test), no_std)]`, staying no_std
# outside `--test`), and rustc rejects `panic=unwind` on no_std.
#
# `bazel test` overrides to `-Cpanic=unwind` so the libtest harness
# can catch assertion panics. That's legal because every `rust_test`
# source file uses `#![cfg_attr(not(test), no_std)]` — under `--test`
# they flip to std.
#
# Integration tests (py_tests that spawn unikernel binaries) depend
# on their target binaries through `//bazel/rules:integration_test.bzl`'s
# `integration_data` wrapper, which applies a Bazel transition that
# pins `-Cpanic=abort` for the wrapped sub-graph — so the test-verb
# unwind override never reaches the no_std dep-chain. Users run them
# with `bazel test //apps/foo:test` (no config gymnastics, no
# tag filter).
build --@rules_rust//:extra_rustc_flags=-Cpanic=abort,-Copt-level=2,-Dwarnings
test  --@rules_rust//:extra_rustc_flag=-Cpanic=unwind

# `bazel test` flips //bazel/rules:tests_need_std=True so
# `#![cfg_attr(not(feature = "std"), no_std)]` crates (currently
# just //util/atomic_fn) pick up `crate_features = ["std"]` and
# compile as std + panic=unwind to link into libtest harnesses.
# `integration_data` transitions reset the flag back to False for
# their sub-graph so unikernel rlibs stay no_std in-process.
test --//bazel/rules:tests_need_std=True

# Bazel 9 made the default test toolchain require an exec platform that
# matches every target-platform constraint. Our test target uses the
# unikernel target platform but runs on the host (sh_test wrapping a
# binary), so the new behaviour rejects it. Until we add a proper
# platform transition for tests, opt out of the new default and fall
# back to the bazel 7/8 behaviour. `common` (instead of `test`) so
# the flag applies to `bazel build` too — the rust-analyzer
# discover_bazel_rust_project tool runs `bazel build //...` and trips
# on test targets in transitive analysis if the flag isn't visible.
common --@bazel_tools//tools/test:incompatible_use_default_test_toolchain=false

# ── Shorthand configs ─────────────────────────────────────────────────────────
# --config=qemu → unikernel via QEMU (platform from .bazelrc.local for host arch)
build:qemu --define=uni_runner=qemu

# --config=hvf  → ARM64 unikernel, HVF (macOS arm64, Apple Hypervisor.framework)
build:hvf  --platforms=//bazel/platforms:aarch64_unikernel
build:hvf  --define=uni_runner=hvf

# --config=iso  → x86_64 unikernel via Limine ISO + QEMU
build:iso  --platforms=//bazel/platforms:x86_64_unikernel
build:iso  --define=uni_runner=iso

# --config=native → native POSIX binary (platform from .bazelrc.local for host)
# setup-dev.sh generates: build:native --platforms=//bazel/platforms:native_<host>

# ── Full triplet configs ───────────────────────────────────────────────────────
build:aarch64-hvf  --platforms=//bazel/platforms:aarch64_unikernel
build:aarch64-hvf  --define=uni_runner=hvf

build:aarch64-qemu --platforms=//bazel/platforms:aarch64_unikernel
build:aarch64-qemu --define=uni_runner=qemu

build:x86_64-qemu  --platforms=//bazel/platforms:x86_64_unikernel
build:x86_64-qemu  --define=uni_runner=qemu

build:x86_64-iso   --platforms=//bazel/platforms:x86_64_unikernel
build:x86_64-iso   --define=uni_runner=iso

build:aarch64-macos --platforms=//bazel/platforms:aarch64_macos
build:x86_64-linux  --platforms=//bazel/platforms:x86_64_linux

# ── Fallback default (overridden by .bazelrc.local on dev machines) ───────────
# setup-dev.sh generates .bazelrc.local; on Apple Silicon it sets:
#   build --platforms=//bazel/platforms:aarch64_macos  (native, no VM)
#   build:native  --platforms=//bazel/platforms:aarch64_macos
#   build:qemu    --platforms=//bazel/platforms:aarch64_unikernel
# On a fresh checkout without .bazelrc.local, x86_64 unikernel is the default.
build --platforms=//bazel/platforms:x86_64_unikernel

# ── Machine-local overrides (generated by setup-dev.sh, not committed) ────────
try-import %workspace%/.bazelrc.local
