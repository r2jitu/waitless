# ── Global ────────────────────────────────────────────────────────────────────
build --action_env=PATH

# Rust compiler flags applied to all crates.
#
# Global `panic=abort`: the production target is a unikernel with
# no unwinding runtime, and every rust_library here is no_std (or
# `#![cfg_attr(not(test), no_std)]`, staying no_std outside
# `--test`).
#
# `bazel test` overrides to `-Cpanic=unwind` so the libtest harness
# can catch assertion panics. `rust_test` crates are
# `#![cfg_attr(not(test), no_std)]`, so under `--test` they flip to
# std where unwinding is fine; their no_std rlib deps stay no_std
# and link in regardless.
#
# Per-variant unikernel targets (:<app>_hvf / _iso / _qemu_<arch>)
# apply a Bazel transition via //bazel/rules:variants.bzl that
# re-asserts `-Cpanic=abort` on the unikernel sub-graph, so under
# `bazel test //apps/foo:test_hvf` the test-verb unwind override
# never reaches the unikernel rlibs.
build --@rules_rust//:extra_rustc_flags=-Cpanic=abort,-Copt-level=2,-Dwarnings
test  --@rules_rust//:extra_rustc_flag=-Cpanic=unwind

# `bazel test` flips //bazel/rules:tests_need_std=True. The
# `rust_test` wrapper in //bazel/rules:rust.bzl gates its targets'
# `target_compatible_with` on this flag, so `bazel build //...`
# skips rust_test targets (they can't compile under the global
# `-Cpanic=abort`) while `bazel test` builds and runs them.
# Per-variant transitions reset the flag to False for their
# sub-graph.
test --//bazel/rules:tests_need_std=True

# ── Platform-only configs (runner is picked per-target, not per-build) ──────
# `--config=aarch64-macos` / `--config=x86_64-linux` are host-platform
# overrides for multi-arch dev boxes / remote CI. They don't pick a
# runner; that's the variant target's job. `bazel build :webserver_hvf`
# runs fine under any host-platform default because the variant's
# transition pins the guest platform internally.
build:aarch64-macos --platforms=//bazel/platforms:aarch64_macos
build:x86_64-linux  --platforms=//bazel/platforms:x86_64_linux

# ── Fallback default (overridden by .bazelrc.local on dev machines) ───────────
# setup-dev.sh generates .bazelrc.local; on Apple Silicon it sets:
#   build --platforms=//bazel/platforms:aarch64_macos  (native, no VM)
# On a fresh checkout without .bazelrc.local, x86_64 unikernel is the default.
build --platforms=//bazel/platforms:x86_64_unikernel

# ── Machine-local overrides (generated by setup-dev.sh, not committed) ────────
try-import %workspace%/.bazelrc.local
