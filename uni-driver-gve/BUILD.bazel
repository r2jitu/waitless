load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# uni-driver-gve — Google Virtual Ethernet driver (GCE).
#
# Depends only on `//drivers:infra` (MMIO + PCI). Notably does NOT
# use `//drivers:infra`'s VirtIO transport — gve has its own
# BAR-register ABI that doesn't go through VirtIO.
rust_library(
    name = "uni-driver-gve",
    srcs = ["src/lib.rs"],
    crate_name = "uni_driver_gve",
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        "//drivers:infra",
        "//kernel",
        "//uni-net:driver",
    ],
)
