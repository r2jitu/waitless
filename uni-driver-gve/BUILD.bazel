load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Google Virtual Ethernet driver (GCE). Uses `//drivers:infra` only for
# MMIO + PCI; gve has its own BAR-register ABI, not VirtIO.
rust_library(
    name = "uni-driver-gve",
    srcs = [
        "src/lib.rs",
        "src/adminq.rs",
        "src/dqo.rs",
        "src/gqi.rs",
    ],
    crate_name = "uni_driver_gve",
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        "//drivers:infra",
        "//kernel",
        "//uni-net:driver",
    ],
)
