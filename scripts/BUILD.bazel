load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "run-local.sh",
    "run-vz.entitlements",
    "make-limine-iso.sh",
    "helpers.sh",
])

sh_binary(
    name = "make_limine_iso",
    srcs = ["make-limine-iso.sh"],
    data = ["//boot:limine.conf"],
)

# Compile the VZ.framework runner from Swift source and codesign it.
# Produces bazel-bin/scripts/run-vz, a macOS arm64 command-line binary with
# the com.apple.security.virtualization entitlement.
#
# Usage: bazel build //scripts:run_vz
#
# Why genrule with local=True instead of rules_apple macos_command_line_application:
#   - macos_command_line_application uses signing_attrs(supports_capabilities=False),
#     which excludes the 'entitlements' attribute. Ad-hoc signing with a custom
#     entitlements file requires codesign --sign - directly.
#   - local=True means the cmd runs on the exec (host) machine regardless of
#     the Bazel target platform, so --platforms=aarch64_unikernel doesn't interfere.
genrule(
    name = "run_vz",
    srcs = [
        "run-vz.swift",
        "run-vz.entitlements",
    ],
    outs = ["run-vz"],
    cmd = " && ".join([
        "swiftc $(location run-vz.swift) -o $@ -framework Virtualization",
        "codesign --sign - --entitlements $(location run-vz.entitlements) $@",
    ]),
    local = True,
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "//bazel/platforms:native",
    ],
)
