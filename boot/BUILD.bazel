load("@rules_rust//rust:defs.bzl", "rust_static_library")

package(default_visibility = ["//visibility:public"])

exports_files(["limine.conf"])

# Boot/entry code: rust_static_library targets supplying the
# `#[no_mangle]` symbols that assembly resolves at link time
# (kernel_main, limine_entry, memcpy).
_UNIKERNEL_ONLY = ["@platforms//os:none"]

rust_static_library(
    name = "entry",
    srcs = ["entry.rs"],
    compile_data = select({
        "//bazel/platforms:x86_64": [
            "x86_64/idt_stubs.S",
            "x86_64/ap_boot.S",
        ],
        "//bazel/platforms:aarch64": ["aarch64/boot.S"],
        "//conditions:default": [
            "x86_64/idt_stubs.S",
            "x86_64/ap_boot.S",
        ],
    }),
    crate_root = "entry.rs",
    target_compatible_with = _UNIKERNEL_ONLY,
    deps = [
        "//drivers",
        "//kernel",
        "//net",
        "//uni",
    ],
)

# x86_64 multiboot/PVH stub. Excluded from the Limine higher-half
# target: boot.S has 32-bit absolute relocations that can't be linked
# into higher-half, and Limine enters at limine_entry() directly.
rust_static_library(
    name = "boot_asm",
    srcs = ["boot_asm.rs"],
    compile_data = ["x86_64/boot.S"],
    target_compatible_with = _UNIKERNEL_ONLY,
)

rust_static_library(
    name = "limine",
    srcs = ["limine_entry.rs"],
    target_compatible_with = _UNIKERNEL_ONLY,
    deps = [
        "//kernel",
        "@crates//:limine",
    ],
)

rust_static_library(
    name = "libc",
    srcs = ["libc.rs"],
    target_compatible_with = _UNIKERNEL_ONLY,
)
