load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

exports_files(["limine.conf"])

# Boot/entry code — rust_static_library targets that provide #[no_mangle]
# symbols resolved at link time by assembly (kernel_main, limine_entry,
# memcpy). Separate from the clean kernel library crate.

rust_static_library(
    name = "entry",
    srcs = ["entry.rs"],
    compile_data = select({
        "//bazel/platforms:x86_64": [
            "x86_64/idt_stubs.S",
            "x86_64/ap_boot.S",
        ],
        "//bazel/platforms:aarch64": ["aarch64/boot.S"],
        "//conditions:default": [
            "x86_64/idt_stubs.S",
            "x86_64/ap_boot.S",
        ],
    }),
    crate_root = "entry.rs",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//drivers",
        "//kernel",
        "//net",
        "//uni",
    ],
)

# x86_64 multiboot/PVH boot stub (boot.S only).
# Excluded from the Limine higher-half target: boot.S contains 32-bit
# absolute relocations targeting `.boot_bss` that cannot be linked into
# a higher-half ELF, and Limine doesn't need the multiboot stub anyway.
rust_static_library(
    name = "boot_asm",
    srcs = ["boot_asm.rs"],
    compile_data = ["x86_64/boot.S"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

rust_static_library(
    name = "limine",
    srcs = ["limine_entry.rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [
        "//kernel",
        "@crates//:limine",
    ],
)

rust_static_library(
    name = "libc",
    srcs = ["libc.rs"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)
