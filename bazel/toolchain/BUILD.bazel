# ---- x86_64 Linux (cross-compile from macOS) --------------------------------

cc_toolchain(
    name = "x86_64_linux_impl",
    toolchain_config = ":x86_64_linux_toolchain_config",
    all_files = ":all_files",
    ar_files = ":all_files",
    as_files = ":all_files",
    compiler_files = ":all_files",
    dwp_files = ":empty",
    linker_files = ":all_files",
    objcopy_files = ":empty",
    strip_files = ":empty",
)

toolchain(
    name = "cc_toolchain_x86_64_linux",
