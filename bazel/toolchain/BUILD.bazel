load(":toolchains.bzl", "register_cc_toolchain")

exports_files([
    "unikernel.ld",
    "unikernel_arm64.ld",
    "unikernel_limine.ld",
])

filegroup(name = "empty")

filegroup(
    name = "all_files",
    srcs = glob(["**"]),
)

register_cc_toolchain(
    name = "unikernel_cc_toolchain_x86_64",
    cpu = "x86_64",
    os = "none",
    target_system = "x86_64-unknown-none",
)

register_cc_toolchain(
    name = "unikernel_cc_toolchain_aarch64",
    cpu = "aarch64",
    os = "none",
    pic = True,
    target_system = "aarch64-unknown-none",
)

register_cc_toolchain(
    name = "cc_toolchain_aarch64_macos",
    cpu = "aarch64",
    os = "macos",
    target_libc = "macosx",
    target_system = "aarch64-apple-darwin",
)

register_cc_toolchain(
    name = "cc_toolchain_x86_64_linux",
    cpu = "x86_64",
    os = "linux",
    target_libc = "musl",
    target_system = "x86_64-unknown-linux-musl",
)
