package(default_visibility = ["//visibility:public"])

platform(
    name = "x86_64_unikernel",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
    ],
)

platform(
    name = "aarch64_unikernel",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:none",
    ],
)

# ── Host OS marker ────────────────────────────────────────────────────────────
# The unikernel target OS is always bare-metal (os:none). These constraints
# embed the *build host* OS into the platform so select() can distinguish
# macOS arm64 from Linux arm64 — needed for VZ.framework dependencies.
constraint_setting(name = "host_os")
constraint_value(name = "host_macos", constraint_setting = ":host_os")
constraint_value(name = "host_linux", constraint_setting = ":host_os")

platform(
    name = "macos_arm64_unikernel",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:none",
        ":host_macos",
    ],
)

# Native macOS arm64 — for building host binaries (benchmarks, dev tools).
platform(
    name = "native_macos_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

# ── config_setting helpers used in select() expressions ──────────────────────
config_setting(
    name = "x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

# Matches macOS arm64 only (more specific than :aarch64; wins in ambiguous selects).
config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        ":host_macos",
    ],
)

# Matches any unikernel platform (bare-metal, os=none).
# Used by tests to mark themselves as incompatible with the unikernel toolchain.
config_setting(
    name = "os_none",
    constraint_values = ["@platforms//os:none"],
)

# ── Runner selection ──────────────────────────────────────────────────────────
# Set via --define=uni_runner=<value>; used in select() by unikernel_binary().
# Default (no define) = native POSIX binary.
config_setting(name = "runner_vz",   define_values = {"uni_runner": "vz"})
config_setting(name = "runner_qemu", define_values = {"uni_runner": "qemu"})
config_setting(name = "runner_iso",  define_values = {"uni_runner": "iso"})
