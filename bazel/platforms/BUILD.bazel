package(default_visibility = ["//visibility:public"])

platform(
    name = "x86_64_unikernel",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
    ],
)

platform(
    name = "aarch64_unikernel",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:none",
    ],
)

# ── Runtime constraint ─────────────────────────────────────────────────────────
# Distinguishes native host builds (os:macos or os:linux) from bare-metal
# unikernel builds (os:none).  Used in target_compatible_with to gate targets
# that only make sense as host binaries (native app binary, VZ runner).
constraint_setting(name = "runtime")

constraint_value(
    name = "native",
    constraint_setting = ":runtime",
)

# Native macOS arm64 — builds host POSIX binaries via the custom macOS toolchain.
platform(
    name = "aarch64_macos",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
        ":native",
    ],
)

# Native Linux x86_64 — builds host POSIX binaries via the auto-detected
# host toolchain (local_config_cc; no custom toolchain registration needed).
platform(
    name = "x86_64_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        ":native",
    ],
)

# Native Linux aarch64 — builds host POSIX binaries (e.g., Oracle Cloud A1).
platform(
    name = "aarch64_linux",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        ":native",
    ],
)

# ── config_setting helpers used in select() expressions ──────────────────────
config_setting(
    name = "x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

# Matches any unikernel platform (bare-metal, os=none).
# Used by tests to mark themselves as incompatible with the unikernel toolchain.
config_setting(
    name = "os_none",
    constraint_values = ["@platforms//os:none"],
)

# ── Runner selection ──────────────────────────────────────────────────────────
# Set via --define=uni_runner=<value>; used in select() by unikernel_binary().
# Default (no define) = native POSIX binary.
config_setting(
    name = "runner_vz",
    define_values = {"uni_runner": "vz"},
)

config_setting(
    name = "runner_qemu",
    define_values = {"uni_runner": "qemu"},
)

config_setting(
    name = "runner_iso",
    define_values = {"uni_runner": "iso"},
)
