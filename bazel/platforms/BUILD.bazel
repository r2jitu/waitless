package(default_visibility = ["//visibility:public"])

platform(
    name = "x86_64_waitless",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
    ],
)

platform(
    name = "aarch64_waitless",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:none",
    ],
)

# ── Native host platforms ─────────────────────────────────────────────────────
# Pure cpu+os triples — identical to Bazel's auto-detected `@platforms//host`
# on the matching machine. A plain `bazel build` (no `--platforms`, no
# `.bazelrc.local`) therefore resolves to the host build, worktrees included.
# These named handles exist only for the explicit `--config=aarch64-macos` /
# `x86_64-linux` / `aarch64-linux` cross/override builds in `.bazelrc`.

# Native macOS arm64 — host POSIX binaries via the custom macOS toolchain.
platform(
    name = "aarch64_macos",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

# Native Linux x86_64 — builds host POSIX binaries via the auto-detected
# host toolchain (local_config_cc; no custom toolchain registration needed).
platform(
    name = "x86_64_linux",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

# Native Linux aarch64 — builds host POSIX binaries (e.g., Oracle Cloud A1).
platform(
    name = "aarch64_linux",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

# ── config_setting helpers used in select() expressions ──────────────────────
config_setting(
    name = "x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "aarch64",
    constraint_values = ["@platforms//cpu:aarch64"],
)

# Matches any unikernel platform (bare-metal, os:none). This is the sole
# native-vs-unikernel discriminator: crate BUILD files `select()` on it to
# pull in bare-metal-only deps, and host-only targets gate their
# `target_compatible_with` off it. A native platform carries os:macos /
# os:linux, so it always lands on the `//conditions:default` arm.
config_setting(
    name = "os_none",
    constraint_values = ["@platforms//os:none"],
)

# ── Runner selection ──────────────────────────────────────────────────────────
# Matches the `//bazel/rules:waitless_runner` string_flag (default "native",
# one of "native" / "hvf" / "qemu" / "iso"). Used by waitless_binary()'s
# `srcs` / `data` select() to pick the right launcher script + data
# deps. `.bazelrc` shortcut configs (`build:hvf` etc.) and per-variant
# transitions in `//bazel/rules:variants.bzl` both flip the flag.
config_setting(
    name = "runner_qemu",
    flag_values = {"//bazel/rules:waitless_runner": "qemu"},
)

config_setting(
    name = "runner_hvf",
    flag_values = {"//bazel/rules:waitless_runner": "hvf"},
)

config_setting(
    name = "runner_iso",
    flag_values = {"//bazel/rules:waitless_runner": "iso"},
)
