#!/usr/bin/env bash
# Generated launcher for the `_qemu_<arch>` variant of a unikernel_binary
# target. The variant rule symlinks the guest ELF and the raw .img
# next to this script under the filenames substituted into %ELF% /
# %IMG%; `//scripts:helpers.sh` is accessible via the launcher-
# relative path substituted into %HELPERS%; `%HOSTFWD%` is the
# hostfwd string built from the app's `port_forwards` attr, with
# env-var defaults baked in per forward.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ELF="$SELF_DIR/%ELF%"
IMG="$SELF_DIR/%IMG%"
HELPERS="$SELF_DIR/%HELPERS%"
# shellcheck disable=SC1090
source "$HELPERS"

detect_qemu "$ELF" "$IMG"

run_qemu \
    "${UNIKERNEL_MEMORY:-%DEFAULT_RAM%}" \
    "${UNIKERNEL_CPUS:-%DEFAULT_CPUS%}" \
    "%HOSTFWD%" \
    "${QEMU_MACHINE[@]}" -kernel "$KERNEL_ARG"
