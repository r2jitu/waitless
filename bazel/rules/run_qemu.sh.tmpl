#!/usr/bin/env bash
# Generated launcher for the `_qemu_<arch>` variant of a waitless_binary
# target. The variant rule symlinks the guest ELF, the raw .img, AND
# `//scripts:helpers.sh` next to this script — under the filenames
# substituted into %ELF% / %IMG% / %HELPERS_NAME% — so all three are
# reachable via `$SELF_DIR/<basename>` regardless of whether the
# launcher is invoked from bazel-bin (the case for `bazel run`) or
# from the runfiles tree (the case for `bazel test`). `%HOSTFWD%` is
# the hostfwd string built from the app's `port_forwards` attr, with
# env-var defaults baked in per forward.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ELF="$SELF_DIR/%ELF%"
IMG="$SELF_DIR/%IMG%"
HELPERS="$SELF_DIR/%HELPERS_NAME%"
# shellcheck disable=SC1090
source "$HELPERS"

detect_qemu "$ELF" "$IMG"

run_qemu \
    "${WAITLESS_MEMORY:-%DEFAULT_RAM%}" \
    "${WAITLESS_CPUS:-%DEFAULT_CPUS%}" \
    "%HOSTFWD%" \
    "${QEMU_MACHINE[@]}" -kernel "$KERNEL_ARG"
