load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")

package(default_visibility = ["//visibility:public"])

exports_files([
    # Per-variant launcher templates, consumed by //bazel/rules:variants.bzl.
    # Each contains %TOKEN% placeholders that the variant rule's
    # `ctx.actions.expand_template` substitutes with runfile filenames.
    "run_hvf.sh.tmpl",
    "run_iso.sh.tmpl",
    "run_qemu.sh.tmpl",
    "native_main.rs",
    "unikernel_main.rs",
])

# `bazel test` flips this to True via `.bazelrc`. Crates that are
# `#![cfg_attr(not(feature = "std"), no_std)]` select on the
# matching `:tests_need_std_on` config_setting below to pick up
# `crate_features = ["std"]` when True, so they compile as std +
# panic=unwind under the test verb (satisfying libtest) but stay
# no_std + panic=abort for production unikernel builds.
#
# Per-variant transitions in `//bazel/rules:variants.bzl` re-enter
# the production sub-graph from under `bazel test` and reset this
# flag to False, so unikernel rlibs pulled in as variant data stay
# no_std.
bool_flag(
    name = "tests_need_std",
    build_setting_default = False,
)

config_setting(
    name = "tests_need_std_on",
    flag_values = {":tests_need_std": "True"},
)

# Runner selector consumed by `//bazel/platforms`'s runner
# config_settings, which the unikernel_binary macro's `srcs` /
# `data` select() queries. Flipped by the per-variant transitions
# in `//bazel/rules:variants.bzl`; no whole-build `.bazelrc` config
# sets it (runner selection is per-target, not per-invocation).
# Previously this lived on `--define=uni_runner=<val>`, but
# Starlark transitions cannot set `--define`, so we migrated to a
# user-defined `string_flag` (which transitions DO support).
string_flag(
    name = "uni_runner",
    build_setting_default = "native",
    values = [
        "native",
        "hvf",
        "qemu",
        "iso",
    ],
)
