load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")

package(default_visibility = ["//visibility:public"])

exports_files([
    # Per-variant launcher templates, consumed by //bazel/rules:variants.bzl.
    # Each contains %TOKEN% placeholders that the variant rule's
    # `ctx.actions.expand_template` substitutes with runfile filenames.
    "run_hvf.sh.tmpl",
    "run_iso.sh.tmpl",
    "run_native.sh.tmpl",
    "run_qemu.sh.tmpl",
    "native_main.rs",
    "waitless_main.rs",
])

# `bazel test` flips this to True via `.bazelrc`. The `rust_test`
# wrapper in `//bazel/rules:rust.bzl` selects on the matching
# `:tests_need_std_on` config_setting to set `target_compatible_with`:
# `bazel build //...` skips rust_test targets (rustc won't build a
# test binary under the global `-Cpanic=abort`) and `bazel test`
# picks them up.
#
# Per-variant transitions in `//bazel/rules:variants.bzl` reset
# this flag to False for the unikernel sub-graph.
bool_flag(
    name = "tests_need_std",
    build_setting_default = False,
)

config_setting(
    name = "tests_need_std_on",
    flag_values = {":tests_need_std": "True"},
)

# Runner selector consumed by `//bazel/platforms`'s runner
# config_settings, which the waitless_binary macro's `srcs` /
# `data` select() queries. Flipped by the per-variant transitions
# in `//bazel/rules:variants.bzl`; no whole-build `.bazelrc` config
# sets it (runner selection is per-target, not per-invocation).
# Previously this lived on `--define=waitless_runner=<val>`, but
# Starlark transitions cannot set `--define`, so we migrated to a
# user-defined `string_flag` (which transitions DO support).
string_flag(
    name = "waitless_runner",
    build_setting_default = "native",
    values = [
        "native",
        "hvf",
        "qemu",
        "iso",
    ],
)

# Link-time-optimization mode for the unikernel image. The transitions
# in `//bazel/rules:{waitless,variants}.bzl` read this and set
# `@rules_rust//rust/settings:lto` on the unikernel sub-graph to its
# value — so LTO covers the kernel/app/driver crates only, and host
# `rust_test` / `:<app>_native` builds (which don't take those
# transitions) stay non-LTO and fast regardless of the setting.
#
#   off  (default) — no cross-crate LTO.
#   thin           — per-module ThinLTO: cross-crate inlining.
#   fat            — whole-program LTO: inlining + constant/rodata
#                    merging; ~40% smaller image, slower to link.
#
# Opt in per-build with `--//bazel/rules:lto={fat,thin}`, or the
# `--config=lto-fat` / `--config=lto-thin` shortcuts (see `.bazelrc`).
#
# Why `thin` rarely helps the image size: this build already links
# with `--gc-sections`, so dead code is gone before LTO runs. ThinLTO
# then mostly just inlines (growing `.text`), and — being per-module —
# cannot merge the identical read-only constants that the crypto
# crates' monomorphizations duplicate across the dep graph. `fat` LTO
# sees the whole program at once and folds them, which is where the
# ~40% image shrink comes from. Pick `thin` for build speed, `fat`
# for a deployable image.
string_flag(
    name = "lto",
    build_setting_default = "off",
    values = [
        "off",
        "thin",
        "fat",
    ],
)
