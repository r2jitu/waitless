#!/usr/bin/env bash
# Generated launcher for the `_hvf` variant of a unikernel_binary
# target. The variant rule symlinks both the guest image and the
# HVF runner binary next to this script, under the filenames
# substituted into %IMG% and %RUNNER% respectively (so they resolve
# the same way whether the runner ships in this repo or in the
# unikernel Bazel module an external app depends on);
# `%PORT_FLAGS%` is the `-p proto:host:guest` argument sequence
# built from the app's `port_forwards` attr, with env-var defaults
# baked in per forward.
#
# Trailing `"$@"` forwards any positional args reaching the launcher
# straight through to the runner, so e.g.
#   bazel run //app:foo_hvf -- --bootargs="quic.log=events"
# flips the in-guest log level without rebuilding.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
IMG="$SELF_DIR/%IMG%"
RUNNER="$SELF_DIR/%RUNNER%"

exec "$RUNNER" "$IMG" \
    "--ram=${UNIKERNEL_MEMORY:-%DEFAULT_RAM%}" \
    "--cpus=${UNIKERNEL_CPUS:-%DEFAULT_CPUS%}" \
    %PORT_FLAGS% \
    "$@"
