#!/usr/bin/env bash
# Generated launcher for the `_hvf` variant of a unikernel_binary
# target. The variant rule symlinks the guest image next to this
# script under the filename substituted into %IMG%; the HVF runner
# binary is reachable via the launcher-relative path in %RUNNER%;
# `%PORT_FLAGS%` is the `-p proto:host:guest` argument sequence
# built from the app's `port_forwards` attr, with env-var defaults
# baked in per forward.
#
# Pass-through extras: any positional args the launcher receives are
# forwarded to the runner verbatim, after the BUILD-baked port
# flags. The canonical use case is `bazel run //app:foo_hvf --
# --bootargs="quic.log=events"` to flip the in-guest log level
# without rebuilding. `UNIKERNEL_BOOTARGS=…` is a friendlier
# environment-variable alternative; specifying both means the env
# var is appended first, then the explicit args.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
IMG="$SELF_DIR/%IMG%"
RUNNER="$SELF_DIR/%RUNNER%"

EXTRA_ARGS=()
if [ -n "${UNIKERNEL_BOOTARGS:-}" ]; then
    EXTRA_ARGS+=("--bootargs=${UNIKERNEL_BOOTARGS}")
fi

## `"${EXTRA_ARGS[@]}"` is a "set -u"-safe expansion of a possibly-
## empty array (bash 3.2 ships with macOS — `set -u` plus a bare
## `"${EMPTY[@]}"` aborts with "unbound variable", `${EMPTY[@]+...}`
## suppresses that). Same shape used in scripts/helpers.sh.
exec "$RUNNER" "$IMG" \
    "--ram=${UNIKERNEL_MEMORY:-%DEFAULT_RAM%}" \
    "--cpus=${UNIKERNEL_CPUS:-%DEFAULT_CPUS%}" \
    %PORT_FLAGS% \
    ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
    "$@"
