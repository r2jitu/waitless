load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:unikernel.bzl", "unikernel_binary")
load("//bazel/rules:variants.bzl", "unikernel_app_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "app",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    deps = ["//crates/uni"],
)

# Single-core is enough — the executor is per-core and the test only
# spawns on the BSP. Serial-log-only assertions → no port forwards.
# Virtio-net is linked so the TCP stack (`net::init_stack`) wires up
# its backend hooks; the socket-lifecycle tests need `TcpListener::
# bind` to succeed. No actual traffic is sent either way.
unikernel_binary(
    name = "test_async",
    app = ":app",
    cpus = 1,
    drivers = ["//crates/drivers/virtio-net"],
)

# Async-runtime smoke test. Runs on HVF and both QEMU TCG arches;
# native excluded because the test exercises `kernel::executor`,
# which is bare-metal-only.
unikernel_app_test(
    name = "test",
    timeout = "short",
    srcs = ["test.py"],
    app_base = "test_async",
    tags = [
        "exclusive",
        "local",
    ],
    test_rule = py_test,
    variants = [
        "hvf",
        "qemu_aarch64",
        "qemu_x86_64",
        "native",
    ],
    deps = ["//scripts:test_helpers"],
)
