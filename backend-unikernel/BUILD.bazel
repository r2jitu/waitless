load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Bare-metal backend for `uni`. Sibling of `//backend-native`,
# picked by `target_os` in `//uni`'s deps select. Owns the arch-
# specific idle path (WFI / hvf-yield / STI;HLT;CLI) plus glue
# onto `//kernel`.
rust_library(
    name = "backend-unikernel",
    srcs = ["src/lib.rs"],
    crate_name = "backend_unikernel",
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        "//drivers",
        "//kernel",
    ],
)
