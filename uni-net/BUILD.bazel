load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

# uni-net — the net-stack crate carved out of `uni::net`.
#
# Owns `Net::enable` + `NetBringUp` + `Ipv4Addr`, the
# `NetError` / `DhcpError` / `NicError` hierarchy, and the Phase 5
# `EthernetDriver` / `register_ethernet_driver!` registration
# machinery. Apps keep importing these via `uni::net::*` and
# `uni::{NetError, …}` — `//uni:uni` re-exports this crate.
#
# Driver crates (`uni-driver-virtio-net`, `uni-driver-gve` in later
# Phase 5 steps) will depend on this crate for the `EthernetDriver`
# trait and the `register_ethernet_driver!` macro, without pulling
# in `//uni`. That's the whole point of the carveout: break the
# `drivers → uni` cycle that would otherwise prevent the driver
# split.
rust_library(
    name = "uni_net",
    srcs = [
        "error.rs",
        "lib.rs",
    ],
    crate_name = "uni_net",
    crate_root = "lib.rs",
    rustc_flags = select({
        "//bazel/platforms:native": ["--cfg=platform_native"],
        "//conditions:default": ["--cfg=platform_unikernel"],
    }) + UNIKERNEL_RUSTC_FLAGS,
    # Native build uses only the hand-rolled TLS 1.3 state machine
    # (everything else goes through POSIX sockets). Bare-metal
    # builds pull the full `//net` umbrella for TCP / UDP / ARP /
    # IPv4 / DHCP / TLS server.
    deps = select({
        "//bazel/platforms:native": [
            "//net:tls",
            "//net:tls_crypto",
            "//net:tls_handshake",
            "//net:tls_record",
            "//net:tls_server",
        ],
        "//conditions:default": [
            "//net",
        ],
    }),
)

# Host-native unit tests for the shared error hierarchy. Runs as a
# standalone test crate (no deps on alloc / kernel / net) so it
# sidesteps the panic-strategy conflict that dep chains through
# `//kernel` or the RustCrypto deps would trigger.
rust_test(
    name = "error_test",
    srcs = ["error.rs"],
    crate_root = "error.rs",
    rustc_flags = ["-Cpanic=unwind"],
)
