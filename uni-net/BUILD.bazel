load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS", "rust_test")

package(default_visibility = ["//visibility:public"])

# ── Leaf: uni_net_driver (ethernet driver contract) ─────────────────
#
# Tiny no-dep crate that hosts the `EthernetDriver` trait plus its
# support types (`NicHandle`, `NicError`) and the link-time registry
# machinery (`EthernetDriverReg`, `register_ethernet_driver!`,
# `linked_ethernet_drivers()`).
#
# Sits here rather than inside the main `uni_net` crate so driver
# crates (`drivers`, and the forthcoming `//uni-driver-virtio-net`
# / `//uni-driver-gve`) can depend on just this one leaf without
# pulling in the full net stack. Concretely it breaks the cycle
#
#     drivers → uni_net → net (umbrella) → drivers
#
# that would otherwise appear the moment `drivers/virtio_net.rs`
# does `impl EthernetDriver`.
rust_library(
    name = "driver",
    srcs = [
        "driver.rs",
        "error.rs",
    ],
    crate_name = "uni_net_driver",
    crate_root = "driver.rs",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

# ── Main uni_net crate ─────────────────────────────────────────────
#
# Owns `Net::enable` + `NetBringUp` + `Ipv4Addr`, the `NetError` /
# `DhcpError` hierarchy, and re-exports the full `driver` surface
# and the bare-metal net umbrella. Apps keep importing via
# `uni::net::*` and `uni::{NetError, …}` — `//uni:uni` re-exports
# this crate.
rust_library(
    name = "uni_net",
    srcs = [
        "lib.rs",
    ],
    crate_name = "uni_net",
    crate_root = "lib.rs",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    deps = [":driver"] + select({
        "//bazel/platforms:native": [],
        "//conditions:default": ["//net"],
    }),
)

# Host-native unit tests for the shared error hierarchy.
rust_test(
    name = "error_test",
    srcs = ["error.rs"],
    crate_root = "error.rs",
    size = "small",
)
