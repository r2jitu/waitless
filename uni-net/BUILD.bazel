load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# Leaf crate: `EthernetDriver` trait + link-time registry. No deps on
# the net stack — driver crates depend here without forming a
# `drivers → uni_net → net → drivers` cycle.
rust_library(
    name = "driver",
    srcs = [
        "src/driver.rs",
        "src/error.rs",
    ],
    crate_name = "uni_net_driver",
    crate_root = "src/driver.rs",
)

# `Net::enable`, error types, and the bare-metal net umbrella.
rust_library(
    name = "uni-net",
    srcs = [
        "src/lib.rs",
    ],
    crate_name = "uni_net",
    crate_root = "src/lib.rs",
    deps = [":driver"] + select({
        "//bazel/platforms:native": [],
        "//conditions:default": [
            "//drivers",
            "//net",
        ],
    }),
)

# Host-native unit tests for the shared error hierarchy.
rust_test(
    name = "error_test",
    size = "small",
    srcs = ["src/error.rs"],
    crate_root = "src/error.rs",
)
