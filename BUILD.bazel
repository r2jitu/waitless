package(default_visibility = ["//visibility:public"])

# Mark the workspace Cargo.toml plus the bazel-side lockfiles as
# labels so the crate_universe extension in MODULE.bazel can read
# them. Cargo.Bazel.lock is the bazel-managed cargo-format lockfile;
# cargo-bazel-lock.json is the bazel-side JSON lockfile that lets
# cargo-bazel resolve crates offline. Both are separate from the
# cargo-managed Cargo.lock that the standalone `cargo build` reads.
exports_files([
    "Cargo.toml",
    "Cargo.Bazel.lock",
    "cargo-bazel-lock.json",
    ".cargo/config.toml",
])

# rust-analyzer auto-discovery target. VS Code's rust-analyzer
# extension calls this via `.vscode/settings.json` whenever it needs
# fresh project metadata; we don't have to regenerate manually.
# Wrapped by `scripts/discover-rust-project.sh` so the IDE bazel
# invocation uses an isolated `--output_base` and doesn't fight the
# CLI bazel server for locks.
alias(
    name = "discover_rust_project",
    actual = "@rules_rust//tools/rust_analyzer:discover_bazel_rust_project",
)
