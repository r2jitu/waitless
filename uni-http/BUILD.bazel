load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# HTTP/1.1 server. Also hosts the `Tls` / `TlsConn` traits that
# `//uni-tls` implements — keeps the HTTP path TLS-unaware so apps
# without `uni_tls` link zero TLS / crypto code.
rust_library(
    name = "uni-http",
    srcs = ["src/lib.rs"],
    # Under the `test` verb the crate flips to `std` for the
    # libtest harness — see the `cfg_attr` in `src/lib.rs`.
    # Mirrors `//uni-http3`.
    crate_features = select({
        "//bazel/rules:tests_need_std_on": ["std"],
        "//conditions:default": [],
    }),
    crate_name = "uni_http",
    rustc_flags = [
        "--check-cfg=cfg(test)",
        "--check-cfg=cfg(feature,values(\"std\"))",
    ],
    deps = [
        "//uni",
        "//uni-iobuf",
        "//uni-worker",
    ],
)

# Inline #[cfg(test)] unit tests — request parser (chunked-TE
# rejection, Host-header port parsing). Run via:
#   bazel test //uni-http:uni_http_test
rust_test(
    name = "uni_http_test",
    size = "small",
    crate = ":uni-http",
)
