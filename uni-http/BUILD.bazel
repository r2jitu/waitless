load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# HTTP/1.1 server. Also hosts the `TlsAdapter` / `TlsConnection`
# traits that `//uni-tls` implements — keeps Server TLS-unaware.
rust_library(
    name = "uni-http",
    srcs = ["src/lib.rs"],
    crate_name = "uni_http",
    deps = ["//uni"],
)
