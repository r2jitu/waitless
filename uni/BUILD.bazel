load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# ---- Platform API (Rust) ----------------------------------------------------
# Safe Rust types for the uni:: platform abstraction: TcpListener, TcpStream,
# log(), config_port(), etc.
#
# The backend is selected at compile time via --cfg:
#   - platform_unikernel: direct calls to net/stack.rs + uni/ffi.rs
#   - platform_native:    direct calls to uni/native.rs
# No C FFI boundary — pure Rust crate-to-crate calls.

rust_library(
    name = "api",
    srcs = ["api.rs"],
    crate_name = "uni",
    edition = "2024",
    deps = select({
        "//bazel/platforms:native": [":native"],
        "//conditions:default": [
            "//net:stack_rs",
            ":ffi",
        ],
    }),
    rustc_flags = select({
        "//bazel/platforms:native": ["--cfg=platform_native"],
        "//conditions:default": ["--cfg=platform_unikernel"],
    }) + ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# ---- Unikernel backend (Rust) -----------------------------------------------
# Provides uni_* lifecycle/config symbols (uni_log, uni_config_port,
# uni_check_shutdown, uni_wait_for_events). Calls kernel/driver Rust
# functions directly with inline assembly for arch primitives.

rust_library(
    name = "ffi",
    srcs = ["ffi.rs"],
    crate_name = "uni_ffi",
    edition = "2024",
    deps = [
        "//kernel:serial_rs",
        "//drivers:drivers_rs",
    ],
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# ---- Native backend (Rust) --------------------------------------------------
# Provides the same uni_* symbols using POSIX sockets + stdio.
# Also provides main() → init + uni_main() for the native entry point.

rust_library(
    name = "native",
    srcs = ["native.rs"],
    crate_name = "uni_native",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"],
)
