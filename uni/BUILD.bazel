load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# ---- Unikernel backend (extern "C" FFI for Rust) ----------------------------
# Provides uni_* lifecycle/config symbols by calling kernel/serial, kernel/arch,
# drivers/virtio_net. TCP symbols are provided by the Rust net stack.

cc_library(
    name = "ffi",
    srcs = ["ffi.cc"],
    deps = [
        "//drivers:virtio_net",
        "//kernel:arch_h",
        "//kernel:core",
    ],
    copts = ["-I."],
)

# ---- Native backend (extern "C" FFI for Rust) -------------------------------
# Provides the same uni_* symbols using POSIX sockets + stdio.
# Linked into the native binary.

cc_library(
    name = "native",
    srcs = ["native.cc"],
    copts = ["-I."],
)

# ---- Native entry point -----------------------------------------------------
# Provides int main() → uni_init_native() + uni_main().

cc_library(
    name = "native_entry",
    srcs = ["native_main.cc"],
    copts = ["-I."],
)
