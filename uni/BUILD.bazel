load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "uni",
    srcs = [
        "boot_info.rs",
        "http.rs",
        "lib.rs",
        "rng.rs",
    ],
    proc_macro_deps = ["//uni/macros:uni_macros"],
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
    # `//uni-net` owns everything net-stack-related (Net::enable,
    # NetBringUp, error types, EthernetDriver trait, and the
    # transitive TCP/UDP/TLS umbrella). `uni` re-exports it as
    # `uni::net` so apps don't need to learn a new import path.
    #
    # Platform backend is picked by target_os via the select below:
    # `//uni-kernel` for bare metal (log/wait_for_events/arch idle
    # on top of `kernel` + `drivers`), `//uni-native` for host POSIX
    # (libc sockets, pthread workers, kqueue/epoll event loop).
    # `//kernel` + `//drivers` stay here as direct deps because
    # `uni/lib.rs` itself still calls into them (eventloop hooks,
    # NIC driver diagnostics).
    deps = [
        "//uni-net:uni_net",
        "//util/atomic_fn",
    ] + select({
        "//bazel/platforms:native": ["//uni-native:uni_native"],
        "//conditions:default": [
            "//drivers",
            "//kernel",
            "//uni-kernel:uni_kernel",
        ],
    }),
)

# Host-native unit tests for the self-contained boot_info module.
# boot_info.rs uses only `core::`, so compiling it as a standalone
# test crate exercises the struct layout + InitOnce without pulling
# in kernel/drivers/net.
rust_test(
    name = "boot_info_test",
    srcs = ["boot_info.rs"],
    crate_root = "boot_info.rs",
    size = "small",
)
