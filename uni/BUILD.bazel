load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Platform abstraction: TcpListener, TcpStream, log(), config_port(), etc.
#
# Single crate with cfg-gated backend modules:
#   - platform_unikernel: unikernel.rs (lifecycle) + net_stack (TCP)
#   - platform_native:    native.rs (POSIX sockets + stdio)

rust_library(
    name = "uni",
    srcs = ["lib.rs", "unikernel.rs", "native.rs"],
    crate_name = "uni",
    edition = "2024",
    deps = select({
        "//bazel/platforms:native": [],
        "//conditions:default": [
            "//kernel:kernel_rs",
            "//drivers:drivers_rs",
            "//net:stack_rs",
        ],
    }),
    rustc_flags = select({
        "//bazel/platforms:native": ["--cfg=platform_native"],
        "//conditions:default": ["--cfg=platform_unikernel"],
    }) + ["-C", "panic=abort", "-C", "opt-level=2"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)
