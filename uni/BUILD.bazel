load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "uni",
    srcs = [
        "http.rs",
        "lib.rs",
        "native.rs",
        "unikernel.rs",
    ],
    proc_macro_deps = ["//uni/macros:uni_macros"],
    rustc_flags = select({
        "//bazel/platforms:native": ["--cfg=platform_native"],
        "//conditions:default": ["--cfg=platform_unikernel"],
    }) + UNIKERNEL_RUSTC_FLAGS,
    deps = select({
        "//bazel/platforms:native": [],
        "//conditions:default": [
            "//drivers",
            "//kernel",
            "//net",
        ],
    }),
)
