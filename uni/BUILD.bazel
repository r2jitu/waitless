load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# ---- Unikernel backend (Rust) -----------------------------------------------
# Provides uni_* lifecycle/config symbols (uni_log, uni_config_port,
# uni_check_shutdown, uni_wait_for_events). Calls kernel/driver Rust
# functions directly with inline assembly for arch primitives.

rust_library(
    name = "ffi",
    srcs = ["ffi.rs"],
    crate_name = "uni_ffi",
    edition = "2024",
    deps = [
        "//kernel:serial_rs",
        "//drivers:drivers_rs",
    ],
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# ---- Native backend (extern "C" FFI for Rust) -------------------------------
# Provides the same uni_* symbols using POSIX sockets + stdio.
# Linked into the native binary.

cc_library(
    name = "native",
    srcs = ["native.cc"],
    copts = ["-I."],
)

# ---- Native entry point -----------------------------------------------------
# Provides int main() → uni_init_native() + uni_main().

cc_library(
    name = "native_entry",
    srcs = ["native_main.cc"],
    copts = ["-I."],
)
