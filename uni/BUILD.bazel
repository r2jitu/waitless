load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "uni",
    srcs = [
        "boot_info.rs",
        "http.rs",
        "lib.rs",
        "native.rs",
        "rng.rs",
        "unikernel.rs",
    ],
    proc_macro_deps = ["//uni/macros:uni_macros"],
    rustc_flags = select({
        "//bazel/platforms:native": ["--cfg=platform_native"],
        "//conditions:default": ["--cfg=platform_unikernel"],
    }) + UNIKERNEL_RUSTC_FLAGS,
    # `//uni-net` owns everything net-stack-related (Net::enable,
    # NetBringUp, error types, EthernetDriver trait, and the
    # transitive TCP/UDP/TLS umbrella). `uni` re-exports it as
    # `uni::net` so apps don't need to learn a new import path.
    #
    # The native build also gets uni-net; its deps resolve to just
    # the hand-rolled TLS 1.3 state machine (POSIX sockets cover
    # everything else). Bare-metal builds additionally pull in
    # //drivers for the stats queries (`net_rx_counts` etc.) that
    # surface through `uni::*` to apps.
    deps = [
        "//uni-net:uni_net",
        "//util/atomic_fn",
    ] + select({
        "//bazel/platforms:native": [],
        "//conditions:default": [
            "//drivers",
            "//kernel",
        ],
    }),
)

# Host-native unit tests for the self-contained boot_info module.
# boot_info.rs uses only `core::`, so compiling it as a standalone
# test crate exercises the struct layout + InitOnce without pulling
# in kernel/drivers/net.
rust_test(
    name = "boot_info_test",
    srcs = ["boot_info.rs"],
    crate_root = "boot_info.rs",
    size = "small",
)
