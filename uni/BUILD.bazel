load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# ---- Platform API (Rust) ----------------------------------------------------
# Safe Rust types for the uni:: platform abstraction: TcpListener, TcpStream,
# log(), config_port(), etc. Symbols are resolved at link time from one of:
#   - Unikernel backend: net/stack.rs (TCP) + uni/ffi.rs (lifecycle)
#   - Native backend:    uni/native.rs (POSIX sockets + stdio)

rust_library(
    name = "api",
    srcs = ["api.rs"],
    crate_name = "uni",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# ---- Unikernel backend (Rust) -----------------------------------------------
# Provides uni_* lifecycle/config symbols (uni_log, uni_config_port,
# uni_check_shutdown, uni_wait_for_events). Calls kernel/driver Rust
# functions directly with inline assembly for arch primitives.

rust_library(
    name = "ffi",
    srcs = ["ffi.rs"],
    crate_name = "uni_ffi",
    edition = "2024",
    deps = [
        "//kernel:serial_rs",
        "//drivers:drivers_rs",
    ],
    rustc_flags = ["-C", "panic=abort"] + select({
        "//bazel/platforms:aarch64": ["-C", "relocation-model=pic"],
        "//conditions:default": [],
    }),
)

# ---- Native backend (Rust) --------------------------------------------------
# Provides the same uni_* symbols using POSIX sockets + stdio.
# Also provides main() → init + uni_main() for the native entry point.

rust_library(
    name = "native",
    srcs = ["native.rs"],
    crate_name = "uni_native",
    edition = "2024",
    rustc_flags = ["-C", "panic=abort"],
)
