load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "uni",
    srcs = [
        "src/boot_info.rs",
        "src/lib.rs",
        "src/rng.rs",
    ],
    crate_root = "src/lib.rs",
    proc_macro_deps = ["//uni/macros:uni_macros"],
    # `//uni-net` re-exported as `uni::net`. `//uni-backend` is the
    # cfg-selected platform adapter (bare-metal or POSIX). `//kernel`
    # stays as a bare-metal-only direct dep because `uni/lib.rs`
    # itself calls into it for `cpu_id`, `eventloop::set_on_shutdown`,
    # and `rng::fill_bytes`.
    deps = [
        "//uni-backend",
        "//uni-net",
        "//uni-worker",
        "//uni-runtime",
    ] + select({
        "//bazel/platforms:native": [],
        "//conditions:default": ["//kernel"],
    }),
)

rust_test(
    name = "boot_info_test",
    size = "small",
    srcs = ["src/boot_info.rs"],
    crate_root = "src/boot_info.rs",
    deps = ["//uni-worker"],
)
