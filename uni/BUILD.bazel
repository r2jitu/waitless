load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "uni",
    srcs = ["lib.rs", "unikernel.rs", "native.rs", "http.rs"],
    deps = select({
        "//bazel/platforms:native": [],
        "//conditions:default": ["//kernel", "//drivers", "//net:stack"],
    }),
    rustc_flags = select({
        "//bazel/platforms:native": ["--cfg=platform_native"],
        "//conditions:default": ["--cfg=platform_unikernel"],
    }) + UNIKERNEL_RUSTC_FLAGS,
)
