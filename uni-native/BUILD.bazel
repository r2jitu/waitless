load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Host POSIX backend for `uni` on native builds. Kept in its own
# std-linking crate so `uni` itself stays `#![no_std]`.
#
# Leaf-only: app-level types (boot_info, shutdown, listener plumbing)
# flow IN via callbacks registered from `uni::run`. Only `atomic_fn`
# is shared, for the `IO_POLL` / `SERVICE` slots.
rust_library(
    name = "uni-native",
    srcs = [
        "src/executor.rs",
        "src/lib.rs",
    ],
    crate_name = "uni_native",
    target_compatible_with = ["//bazel/platforms:native"],
    deps = ["//util/atomic_fn"],
)
