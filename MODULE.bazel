module(
    name = "unikernel",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_rust", version = "0.68.1")

# Patch rules_rust to add aarch64-unknown-none to the platform registry.
# Without this, crate_universe marks crates as incompatible for our
# aarch64 bare-metal target. x86_64-unknown-none is already registered.
single_version_override(
    module_name = "rules_rust",
    patches = ["//bazel/patches:rules_rust_aarch64_none.patch"],
    patch_strip = 1,
)

register_toolchains(
    "//bazel/toolchain:unikernel_cc_toolchain_x86_64",
    "//bazel/toolchain:unikernel_cc_toolchain_aarch64",
    "//bazel/toolchain:cc_toolchain_aarch64_macos",
    "//bazel/toolchain:cc_toolchain_x86_64_linux",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-unknown-none",
        "aarch64-unknown-none",
        "x86_64-unknown-linux-musl",
    ],
    versions = ["1.91.1"],
)
use_repo(rust, "rust_toolchains")

# rules_rust 0.69+ auto-creates a `rust_host_tools` repo whose
# version tracks `rust.toolchain(versions=...)` above, so an
# explicit `rust_host_tools.host_tools(...)` is no longer needed
# (and conflicts with the default). 1.86.0 is recent enough to
# parse `edition = "2024"` in dependency Cargo.toml files.

register_toolchains("@rust_toolchains//:all")

# ── crates.io dependencies ──────────────────────────────────────────────────
# Cargo.toml is the source of truth: a workspace at the repo root
# lists the project's external Rust deps (used by tools/hvf-runner +
# the bare-metal kernel/uni/limine code). crate_universe reads the
# spliced workspace and generates `@crates//:foo` labels that
# rust_binary / rust_library targets consume. `bazel/crates-bridge`
# is a placeholder workspace member whose only job is to pull the
# bare-metal-only crates (bitflags, fdt, limine) into the lockfile,
# since the `#![no_std]` kernel/uni crates aren't cargo-aware
# themselves.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_config = "//:.cargo/config.toml",
    # Bazel-side cargo lockfile, distinct from the cargo-managed
    # Cargo.lock. Mirrors rules_rust's examples/crate_universe/
    # cargo_workspace pattern.
    cargo_lockfile = "//:Cargo.Bazel.lock",
    # JSON lockfile recording resolved download URLs + checksums.
    # With this present cargo-bazel can resolve everything offline
    # from the JSON without consulting cargo's local registry cache,
    # so the sparse vs git-protocol cache hash mismatch we used to
    # work around in scripts/setup-dev.sh is no longer an issue.
    # Refreshed via `CARGO_BAZEL_REPIN=true bazel sync --only=crates`.
    lockfile = "//:cargo-bazel-lock.json",
    manifests = [
        "//:Cargo.toml",
        "//tools/hvf-runner:Cargo.toml",
        "//bazel/crates-bridge:Cargo.toml",
    ],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-none",
        "x86_64-unknown-none",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")
