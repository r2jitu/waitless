module(
    name = "unikernel",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_rust", version = "0.56.0")

# Patch rules_rust to add aarch64-unknown-none to the platform registry.
# Without this, crate_universe marks crates as incompatible for our
# aarch64 bare-metal target. x86_64-unknown-none is already registered.
single_version_override(
    module_name = "rules_rust",
    patches = ["//bazel/patches:rules_rust_aarch64_none.patch"],
    patch_strip = 1,
)

register_toolchains(
    "//bazel/toolchain:unikernel_cc_toolchain_x86_64",
    "//bazel/toolchain:unikernel_cc_toolchain_aarch64",
    "//bazel/toolchain:cc_toolchain_aarch64_macos",
    "//bazel/toolchain:cc_toolchain_x86_64_linux",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-unknown-none",
        "aarch64-unknown-none",
        "x86_64-unknown-linux-musl",
    ],
    versions = ["1.86.0"],
)
use_repo(rust, "rust_toolchains")

# Pin host tools (cargo, rustc used during dep resolution) to 1.86.0 too.
# Default in rules_rust 0.56.0 is 1.83 which doesn't understand
# `edition = "2024"` in dependency Cargo.toml files (stabilised in 1.85).
rust_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host_tools.host_tools(version = "1.86.0", edition = "2024")
use_repo(rust_host_tools, "rust_host_tools")

register_toolchains("@rust_toolchains//:all")

# ── crates.io dependencies (annotation-based, no Cargo.toml needed) ──────────
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.spec(
    package = "bitflags",
    version = "2.9.1",
    default_features = False,
)

# Limine boot protocol bindings (no_std, only bitflags as runtime dep).
# Replaces the hand-written request/response structs in
# boot/limine_entry.rs and gets correct PHDR-friendly layout.
# Pin to 0.5.0 — 0.6.x (under different maintainership) needs nightly
# features (`ptr_metadata`) which we can't use on stable rustc.
crate.spec(
    package = "limine",
    version = "0.5.0",
    default_features = False,
)

# Flattened device tree parser (zero deps, no_std).
# Replaces the hand-written FDT walker in kernel/aarch64/fdt.rs.
crate.spec(
    package = "fdt",
    version = "0.1.5",
    default_features = False,
)

crate.from_specs(
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-none",
        "x86_64-unknown-none",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")
