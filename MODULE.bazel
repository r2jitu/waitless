module(
    name = "unikernel",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_rust", version = "0.56.0")

register_toolchains(
    "//bazel/toolchain:unikernel_cc_toolchain_x86_64",
    "//bazel/toolchain:unikernel_cc_toolchain_aarch64",
    "//bazel/toolchain:cc_toolchain_aarch64_macos",
    "//bazel/toolchain:cc_toolchain_x86_64_linux",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-unknown-none",
        "aarch64-unknown-none",
        "x86_64-unknown-linux-musl",
    ],
    versions = ["1.86.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# ── crates.io dependencies (annotation-based, no Cargo.toml needed) ──────────
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.spec(
    package = "bitflags",
    version = "2.9.1",
    default_features = False,
)

crate.from_specs(
    # Only list triples in rules_rust 0.56.0's triple_mappings.bzl.
    # aarch64-unknown-none is missing from rules_rust, but these triples
    # cover our constraint_values (aarch64 cpu matched via aarch64-apple-darwin,
    # x86_64 bare-metal via x86_64-unknown-none).
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-unknown-none",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")
