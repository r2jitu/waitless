module(
    name = "waitless",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_rust", version = "0.69.0")

# Use the autodetecting Python toolchain — just invokes whatever
# `/usr/bin/env python3` finds on the host. Avoids the toolchain-
# resolution dead-end we hit with the hermetic toolchain: it gets
# registered with @platforms//os:{linux,macos,...} constraints, so
# under --config=hvf (target platform = aarch64_waitless with
# os:none) Bazel can't find a matching toolchain even though the
# test itself runs on the host.
#
# The autodetecting toolchain has no `target_compatible_with`, so
# resolution succeeds regardless of the target platform, and the
# host's Python gets used at exec time — exactly what an integration
# test that spawns the guest needs.
register_toolchains("@bazel_tools//tools/python:autodetecting_toolchain")

# Register a hermetic Python 3.12 alongside the autodetecting
# toolchain. `pip.parse` (below) requires a `python.toolchain(...)`
# of the same version to be visible — it uses the bundled
# interpreter to evaluate wheel environment markers (`os_name`,
# `python_full_version`, etc.). The autodetecting toolchain stays
# first in the registry order, so py_test execution still uses the
# host `python3` and tests keep their direct access to the
# guest-spawn paths (HVF / QEMU launcher subprocesses), but
# pip-resolution gets the deterministic interpreter it needs.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = False,
    python_version = "3.12",
)

# Pip dependency hub. py_test targets that need a third-party
# Python package (aioquic for the h3 burst test) consume them as
# `@pip//aioquic`. `requirements.txt` is generated from
# `requirements.in` via `pip-compile --generate-hashes` — regen
# with `pip-compile --generate-hashes --output-file=requirements.txt requirements.in`
# when a dep changes.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pip",
    python_version = "3.12",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "pip")

# Patch rules_rust to add aarch64-unknown-none to the platform registry.
# Without this, crate_universe marks crates as incompatible for our
# aarch64 bare-metal target. x86_64-unknown-none is already registered.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//bazel/patches:rules_rust_aarch64_none.patch",
        # Drop the `.target` infix from custom `target_json` spec filenames
        # so the hard-float toolchain's rustc triple is a clean name.
        "//bazel/patches:rules_rust_target_json_name.patch",
    ],
)

register_toolchains(
    "//bazel/toolchain:waitless_cc_toolchain_x86_64",
    "//bazel/toolchain:waitless_cc_toolchain_aarch64",
    "//bazel/toolchain:cc_toolchain_aarch64_macos",
    "//bazel/toolchain:cc_toolchain_x86_64_linux",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    # `x86_64-unknown-none` is intentionally absent: the x86_64 unikernel is
    # built by the custom hard-float `@hardfloat_x86_64_none` toolchain below
    # (rust-lang/rust#116344). Its precompiled `rust-std` is soft-float, so
    # registering it here would only invite the wrong toolchain to resolve.
    extra_target_triples = [
        "aarch64-unknown-none",
        "x86_64-unknown-linux-musl",
    ],
    versions = ["1.93.1"],
)
use_repo(rust, "rust_toolchains")

# `@rust_host_tools` is the rules_rust host (== exec) rustc/cargo download,
# auto-created by rules_rust 0.69+ at the `rust.toolchain(versions=...)`
# version. The hard-float toolchain below reuses its `rustc` instead of a
# builtin `rust_toolchain`, so it is correct for whatever host fetched the
# repo. We only `use_repo` it -- no `host_tools(...)` tag (that conflicts
# with the default rules_rust already declares).
rust_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
use_repo(rust_host_tools, "rust_host_tools")

register_toolchains("@rust_toolchains//:all")

# ── x86_64 hard-float bare-metal toolchain ──────────────────────────────────
# Builds a hard-float `core`/`compiler_builtins`/`alloc` sysroot from pinned
# rust-src and emits a `rust_toolchain` targeting the custom
# `//bazel/toolchain:x86_64-waitless-none.json` spec. This replaces the soft-float
# builtin `x86_64-unknown-none` toolchain for the unikernel so the whole
# x86_64 build -- kernel and crypto -- has one consistent hard-float ABI and
# needs no `-Ctarget-feature` ABI toggle (rust-lang/rust#116344). See
# //bazel/buildstd:extensions.bzl for the full rationale.
hardfloat = use_extension("//bazel/buildstd:extensions.bzl", "hardfloat")
hardfloat.toolchain(target_json = "//bazel/toolchain:x86_64-waitless-none.json")
use_repo(hardfloat, "hardfloat_x86_64_none")

register_toolchains("@hardfloat_x86_64_none//:toolchain")

# ── crates.io dependencies ──────────────────────────────────────────────────
# Cargo.toml is the source of truth: a workspace at the repo root
# lists the project's external Rust deps (used by tools/hvf-runner +
# the bare-metal kernel/waitless/limine code). crate_universe reads the
# spliced workspace and generates `@crates//:foo` labels that
# rust_binary / rust_library targets consume. `bazel/crates-bridge`
# is a placeholder workspace member whose only job is to pull the
# bare-metal-only crates (bitflags, fdt, limine) into the lockfile,
# since the `#![no_std]` kernel/waitless crates aren't cargo-aware
# themselves.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_config = "//:.cargo/config.toml",
    # Bazel-side cargo lockfile, distinct from the cargo-managed
    # Cargo.lock. Mirrors rules_rust's examples/crate_universe/
    # cargo_workspace pattern. It pins versions + checksums in the
    # cargo lockfile format; crate_universe re-resolves the dependency
    # graph from it on every clean build.
    #
    # We deliberately do NOT also set crate_universe's own
    # `lockfile = "//:cargo-bazel-lock.json"` JSON cache. That file
    # carries a `checksum` computed over the Cargo manifest *labels*,
    # and those labels differ depending on whether waitless is the
    # root module (`//:Cargo.toml`) or a dependency of an external app
    # (`@@waitless+//:Cargo.toml`). A committed JSON lockfile can
    # therefore never match when an external app builds against
    # waitless: crate_universe would either hard-fail on the checksum
    # mismatch or — with `CARGO_BAZEL_REPIN` — rewrite the committed
    # file and corrupt it for waitless's own builds. `Cargo.Bazel.lock`
    # is context-independent, so it is the only lockfile we commit.
    cargo_lockfile = "//:Cargo.Bazel.lock",
    manifests = [
        "//:Cargo.toml",
        "//tools/hvf-runner:Cargo.toml",
        "//bazel/crates-bridge:Cargo.toml",
    ],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-none",
        "x86_64-unknown-none",
        "x86_64-unknown-linux-gnu",
    ],
)

# ── x86_64-v3 SIMD features for crypto ──────────────────────────────────────
#
# The float ABI is no longer a per-crate concern: the x86_64 unikernel is
# built by the custom hard-float `@hardfloat_x86_64_none` toolchain (SSE2
# baked into the target spec), so `__m128i` / pclmulqdq / SSE intrinsics
# have a register class everywhere and no `-Ctarget-feature` ABI toggle is
# needed. Previously each crypto crate carried
# `-Ctarget-feature=-soft-float,+sse,+sse2,...` to escape the soft-float
# `x86_64-unknown-none` target -- an ABI toggle rust-lang/rust#116344 is
# turning into a hard error. That is gone.
#
# What remains here is purely a *performance* baseline: the non-ABI
# x86_64-v3 SIMD features (AVX2/AES/PCLMUL/BMI2/FMA, Haswell 2013 -- what
# every cloud VM runs). These are not #116344-affected; enabling them via
# `-Ctarget-feature` is fine. They let LLVM use the wider instructions
# crate-wide and make `cfg(target_feature=...)` pick the SIMD path at
# compile time instead of via runtime `cpufeatures` dispatch.
#
# Scoped via `crate.annotation_select` to `x86_64-unknown-none` only --
# they are harmless no-ops on the aarch64/native builds but would flood
# those logs with "not a recognized feature" warnings. The native build
# (`x86_64-unknown-linux-gnu`) is already hard-float and runtime-dispatches
# fine, so it is intentionally not listed.
_X86_CRYPTO_FLAG = "-Ctarget-feature=+sse3,+ssse3,+sse4.1,+sse4.2,+avx,+avx2,+aes,+pclmulqdq,+fma,+bmi1,+bmi2"

[
    crate.annotation_select(
        crate = name,
        rustc_flags = [_X86_CRYPTO_FLAG],
        triples = ["x86_64-unknown-none"],
    )
    for name in (
        "aes",
        "aes-gcm",
        "ghash",
        "polyval",
        "p256",
        "primeorder",
        "elliptic-curve",
        "crypto-bigint",
        "curve25519-dalek",
    )
]

# `chacha20` annotations dropped along with the crate itself —
# `kernel::rng` was the last consumer (CSPRNG expander) and now
# uses an in-crate SHA-256 hash chain, so the chacha20 dep is
# gone from `Cargo.toml` + `crates-bridge`. Keeping the
# annotations would make crate_universe error out with
# "annotation on missing crate".

# curve25519-dalek also needs a build-script override to force the
# portable "serial" backend instead of the "simd" one that assumes
# AVX2 is on by default. (The target-feature flag is handled above.)
crate.annotation(
    build_script_env = {
        "CARGO_CFG_CURVE25519_DALEK_BACKEND": "serial",
    },
    crate = "curve25519-dalek",
)
use_repo(crate, "crates")
