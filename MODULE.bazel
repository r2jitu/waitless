module(
    name = "unikernel",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_python", version = "0.40.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_rust", version = "0.69.0")

# Use the autodetecting Python toolchain — just invokes whatever
# `/usr/bin/env python3` finds on the host. Avoids the toolchain-
# resolution dead-end we hit with the hermetic toolchain: it gets
# registered with @platforms//os:{linux,macos,...} constraints, so
# under --config=hvf (target platform = aarch64_unikernel with
# os:none) Bazel can't find a matching toolchain even though the
# test itself runs on the host.
#
# The autodetecting toolchain has no `target_compatible_with`, so
# resolution succeeds regardless of the target platform, and the
# host's Python gets used at exec time — exactly what an integration
# test that spawns the guest needs.
register_toolchains("@bazel_tools//tools/python:autodetecting_toolchain")

# Patch rules_rust to add aarch64-unknown-none to the platform registry.
# Without this, crate_universe marks crates as incompatible for our
# aarch64 bare-metal target. x86_64-unknown-none is already registered.
single_version_override(
    module_name = "rules_rust",
    patches = ["//bazel/patches:rules_rust_aarch64_none.patch"],
    patch_strip = 1,
)

register_toolchains(
    "//bazel/toolchain:unikernel_cc_toolchain_x86_64",
    "//bazel/toolchain:unikernel_cc_toolchain_aarch64",
    "//bazel/toolchain:cc_toolchain_aarch64_macos",
    "//bazel/toolchain:cc_toolchain_x86_64_linux",
)

# Register our custom host platforms (`aarch64_macos`, `x86_64_linux`,
# `aarch64_linux`) as execution platforms so Bazel 9's default test
# toolchain can resolve them. Without this, rust_tests whose target
# platform matches our host (carrying the custom `:native` constraint)
# fail toolchain resolution because the built-in `@platforms//host:host`
# exec platform lacks that constraint — which is why we previously set
# `incompatible_use_default_test_toolchain=false` in `.bazelrc`.
register_execution_platforms(
    "//bazel/platforms:aarch64_macos",
    "//bazel/platforms:x86_64_linux",
    "//bazel/platforms:aarch64_linux",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-unknown-none",
        "aarch64-unknown-none",
        "x86_64-unknown-linux-musl",
    ],
    versions = ["1.93.1"],
)
use_repo(rust, "rust_toolchains")

# rules_rust 0.69+ auto-creates a `rust_host_tools` repo whose
# version tracks `rust.toolchain(versions=...)` above, so an
# explicit `rust_host_tools.host_tools(...)` is no longer needed
# (and conflicts with the default). 1.86.0 is recent enough to
# parse `edition = "2024"` in dependency Cargo.toml files.

register_toolchains("@rust_toolchains//:all")

# ── crates.io dependencies ──────────────────────────────────────────────────
# Cargo.toml is the source of truth: a workspace at the repo root
# lists the project's external Rust deps (used by tools/hvf-runner +
# the bare-metal kernel/uni/limine code). crate_universe reads the
# spliced workspace and generates `@crates//:foo` labels that
# rust_binary / rust_library targets consume. `bazel/crates-bridge`
# is a placeholder workspace member whose only job is to pull the
# bare-metal-only crates (bitflags, fdt, limine) into the lockfile,
# since the `#![no_std]` kernel/uni crates aren't cargo-aware
# themselves.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_config = "//:.cargo/config.toml",
    # Bazel-side cargo lockfile, distinct from the cargo-managed
    # Cargo.lock. Mirrors rules_rust's examples/crate_universe/
    # cargo_workspace pattern.
    cargo_lockfile = "//:Cargo.Bazel.lock",
    # JSON lockfile recording resolved download URLs + checksums.
    # With this present cargo-bazel can resolve everything offline
    # from the JSON without consulting cargo's local registry cache,
    # so the sparse vs git-protocol cache hash mismatch we used to
    # work around in scripts/setup-dev.sh is no longer an issue.
    # Refreshed via `CARGO_BAZEL_REPIN=true bazel sync --only=crates`.
    lockfile = "//:cargo-bazel-lock.json",
    manifests = [
        "//:Cargo.toml",
        "//tools/hvf-runner:Cargo.toml",
        "//bazel/crates-bridge:Cargo.toml",
    ],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-none",
        "x86_64-unknown-none",
        "x86_64-unknown-linux-gnu",
    ],
)

# ── x86_64-unknown-none target-feature overrides for crypto ────────────────
#
# The stock `x86_64-unknown-none` target has
# `features: "-mmx,-sse,+soft-float"` baked in. That makes LLVM
# refuse to compile any crate that uses `__m128i` / pclmulqdq /
# SSE intrinsics, because there's no register class for 128-bit
# vector types under `+soft-float`, and LLVM bails with:
#     rustc-LLVM ERROR: Do not know how to split the result of
#     this operator!
# (rust-lang/rust#87642, #92760, #136544).
#
# Every RustCrypto AEAD auto-compiles both a SIMD path and a software
# path, dispatched at runtime by `cpufeatures`, so we can't just
# "runtime-select" our way out — both paths must compile.
#
# Fix: per-crate `rustc_flags` annotation that explicitly turns
# `-soft-float` off and turns SSE/AVX/AES/PCLMUL on. The kernel
# already enables SSE at boot (CR4.OSFXSR|OSXMMEXCPT in
# `kernel/limine_boot.S`) and our scheduler is cooperative — nothing
# preempts kernel code — so using SSE/AVX registers in the kernel
# is safe without any FXSAVE/XSAVE dance. x86_64-v3 baseline
# (Haswell, 2013) matches what every cloud VM runs today.
#
# Scoped via `crate.annotation_select` to the x86_64 triples only.
# Setting these flags unconditionally makes LLVM emit a warning for
# every feature on every non-x86 compilation ("'+sse2' is not a
# recognized feature for this target (ignoring feature)" × every
# flag × every affected crate), flooding the aarch64 build log.
#
# Crates listed: any crate in the TLS 1.3 transitive graph that
# either uses SIMD intrinsics directly or hits the LLVM bug via
# `u128` math.
_X86_CRYPTO_FLAG = "-Ctarget-feature=-soft-float,+sse,+sse2,+sse3,+ssse3,+sse4.1,+sse4.2,+avx,+avx2,+aes,+pclmul,+fma,+bmi1,+bmi2"

_X86_TRIPLES = [
    "x86_64-unknown-none",
    "x86_64-unknown-linux-gnu",
]

[
    crate.annotation_select(
        crate = name,
        triples = _X86_TRIPLES,
        rustc_flags = [_X86_CRYPTO_FLAG],
    )
    for name in (
        "aes",
        "aes-gcm",
        "ghash",
        "polyval",
        # p256 + its big-int transitive deps also do `u128` math that
        # trips the soft-float legalization bug on x86_64-unknown-none.
        # Same fix as the AEADs above.
        "p256",
        "primeorder",
        "elliptic-curve",
        "crypto-bigint",
        "chacha20",
        "chacha20poly1305",
        "poly1305",
        "curve25519-dalek",
    )
]

# chacha20 and poly1305 get an extra `--cfg=..._force_soft` — something
# in their x86 SIMD backends (not AVX2; SSE2 is also affected) produces
# incorrect ciphertext on x86_64-unknown-none targets. The RFC 8439
# known-answer test in apps/test_tls fails both ct_ok and tag_ok on
# x86_64 with the SIMD path enabled, and bypassing SIMD at the crate
# level makes it pass again. Both crates explicitly document
# `chacha20_force_soft` / `poly1305_force_soft` as the way to pick the
# portable constant-time software backend. Applied on all triples
# (non-x86 builds don't hit the SIMD path anyway; belt-and-suspenders).
crate.annotation(
    crate = "chacha20",
    rustc_flags = ["--cfg=chacha20_force_soft"],
)
crate.annotation(
    crate = "poly1305",
    rustc_flags = ["--cfg=poly1305_force_soft"],
)

# curve25519-dalek also needs a build-script override to force the
# portable "serial" backend instead of the "simd" one that assumes
# AVX2 is on by default. (The target-feature flag is handled above.)
crate.annotation(
    crate = "curve25519-dalek",
    build_script_env = {
        "CARGO_CFG_CURVE25519_DALEK_BACKEND": "serial",
    },
)

use_repo(crate, "crates")
