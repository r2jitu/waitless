load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/rules:rust.bzl", "UNIKERNEL_RUSTC_FLAGS")

package(default_visibility = ["//visibility:public"])

# util/atomic_fn — typed atomic function-pointer cell.
#
# Zero-dep leaf crate (only `core::`). Extracted from
# `kernel::sync::AtomicFn` so downstream callers that can't depend
# on `//kernel` (because doing so pulls in RustCrypto / talc /
# panic=abort chains that break rust_test's panic=unwind runtime)
# can still reach the same primitive.
#
# Consumers after Phase 7:
#   * //kernel: re-exports as `kernel::sync::AtomicFn` for compat.
#   * //net:protocol: drops its private `FnSlot` wrapper.
#   * //uni:uni (native backend): `IO_POLL` / `SERVICE` slots.
rust_library(
    name = "atomic_fn",
    srcs = ["lib.rs"],
    crate_name = "atomic_fn",
    crate_root = "lib.rs",
    rustc_flags = UNIKERNEL_RUSTC_FLAGS,
)

# panic=unwind variant of the same source, for `rust_test` targets
# that `crate = ":foo"` a library whose deps transitively include
# `atomic_fn`. Without this, the test binary is built
# `panic=unwind` but the library's deps are `panic=abort` and
# rustc refuses to link them ("crate `atomic_fn` requires panic
# strategy `abort` which is incompatible…"). Two library targets
# with the same `crate_name` but different `rustc_flags` give us
# per-consumer panic-strategy selection.
#
# Downstream `rust_test` targets depend on `:atomic_fn_unwind`
# directly (replacing `:atomic_fn` in their dep list); the
# production `rust_library` / unikernel-binary graph still uses
# `:atomic_fn`. See `//net:protocol_test`.
rust_library(
    name = "atomic_fn_unwind",
    srcs = ["lib.rs"],
    crate_features = ["std"],
    crate_name = "atomic_fn",
    crate_root = "lib.rs",
)

rust_test(
    name = "atomic_fn_test",
    crate = ":atomic_fn",
)
