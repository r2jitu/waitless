load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# Cross-platform per-worker primitives.
#
# `CurrentCore` is a ZST token whose existence proves the holder is
# running on a specific worker (core on bare-metal, thread on
# native). `PerCpu<T, N>` is the matching typed per-worker array;
# `T` provides its own interior mutability (`Atomic*`, `UnsafeCell`
# behind SPSC / owning-worker discipline). Both are used by
# `//kernel` for its per-core state, by `//uni-executor` for task
# arenas, and by `//backend-native` for per-worker timer storage.
#
# Backends (kernel, backend-native) publish a `static Runtime` with
# `current_worker` + `now_ticks` fn pointers via `register`; every
# caller above looks up hooks through `runtime()`.
rust_library(
    name = "uni-percpu",
    srcs = [
        "src/lib.rs",
        "src/once.rs",
        "src/timer.rs",
    ],
    crate_name = "uni_percpu",
)

rust_test(
    name = "once_test",
    size = "small",
    srcs = ["src/once.rs"],
    crate_root = "src/once.rs",
)

rust_test(
    name = "timer_test",
    size = "small",
    srcs = ["src/timer.rs"],
    crate_root = "src/timer.rs",
)
