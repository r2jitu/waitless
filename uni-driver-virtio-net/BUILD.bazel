load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# VirtIO ethernet driver. Depends on `//drivers:infra` (not the outer
# `//drivers`) so the umbrella can dispatch here without a cycle.
rust_library(
    name = "uni-driver-virtio-net",
    srcs = ["src/lib.rs"],
    crate_name = "uni_driver_virtio_net",
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        "//drivers:infra",
        "//kernel",
        "//net:checksum",
        "//uni-iobuf",
        "//uni-net:driver",
    ],
)
