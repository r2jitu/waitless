load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Shared async runtime — task arena + Waker + Sleep. Calls
# `uni_platform::now_ticks()` directly for time reads; no register/
# plug-in indirection. Future reactor hooks (P4 UDP, P5 TCP) that
# carry waker state will land here with their own mechanism.
rust_library(
    name = "uni-runtime",
    srcs = [
        "src/event.rs",
        "src/launcher.rs",
        "src/lib.rs",
        "src/net/mod.rs",
        "src/net/tcp.rs",
        "src/net/udp.rs",
        "src/select.rs",
        "src/sleep.rs",
        "src/task.rs",
    ],
    crate_name = "uni_runtime",
    deps = [
        "//net:types",
        "//uni-iobuf",
        "//uni-net:driver",
        "//uni-worker",
        "//uni-platform",
    ],
)
