load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# Bare-metal backend for `uni`. Sibling of `uni-native`, picked by
# `target_os` in `//uni`'s deps select. Owns the arch-specific idle
# path (WFI / hvf-yield / STI;HLT;CLI) plus glue onto `//kernel`.
rust_library(
    name = "uni-kernel",
    srcs = ["src/lib.rs"],
    crate_name = "uni_kernel",
    target_compatible_with = ["@platforms//os:none"],
    deps = [
        "//drivers",
        "//kernel",
    ],
)
