load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# TLS 1.3 server for HTTPS over uni_http.
#
# Owns the entire TLS-over-TCP server: the handshake state machine
# + the `uni_http::Tls` impl. The lower-level protocol primitives
# (`tls_crypto`, `tls_handshake`, `tls_record`, `tls`) live in
# //net so a future QUIC stack can share them. Apps that don't
# import this crate link zero TLS / crypto code — the trait
# boundary in `uni_http` is what makes the isolation work.
#
# To enable diagnostic tracing add `--cfg=tls_debug` to rustc_flags
# below. When unset, the trace module compiles to no-op stubs with
# zero runtime cost.
#
# The kernel dep is bare-metal-only: the `#[cfg(tls_debug)]` trace
# module uses `kernel::serial::puts` on `target_os="none"` and
# `libc::write` on hosted targets. The rest of the crate has no
# kernel dependency, so the same source compiles for native too
# and lets `//uni:uni` drive the full TLS stack on both paths.
#
rust_library(
    name = "uni-tls",
    srcs = [
        "src/lib.rs",
        "src/quic/conn.rs",
        "src/quic/inbox.rs",
        "src/quic/mod.rs",
        "src/quic/server.rs",
        "src/quic/tls.rs",
        "src/tcp.rs",
        "src/tcp/handlers.rs",
        "src/tcp/keys.rs",
        "src/tcp/profile.rs",
        "src/tcp/ticket.rs",
        "src/tcp/trace.rs",
    ],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    crate_features = select({
        "//bazel/rules:tests_need_std_on": ["std"],
        "//conditions:default": [],
    }),
    crate_name = "uni_tls",
    rustc_flags = [
        "--check-cfg=cfg(tls_debug)",
        "--check-cfg=cfg(test)",
        # `feature = "std"` is toggled by `tests_need_std_on` for
        # the `rust_test` build (see crate_features above).
        "--check-cfg=cfg(feature,values(\"std\"))",
    ],
    deps = [
        "//net:quic_crypto",
        "//net:quic_frame",
        "//net:quic_wire",
        "//net:tls",
        "//net:tls_crypto",
        "//net:tls_handshake",
        "//net:tls_record",
        "//uni",
        "//uni-http",
        "//uni-runtime",
        "@crates//:getrandom",
        "@crates//:hmac",
        "@crates//:p256",
        "@crates//:sha2",
    ] + select({
        "//bazel/platforms:native": [],
        "//conditions:default": ["//kernel"],
    }),
)

# Host-native unit tests for the in-crate `mod tests` blocks
# (currently `extract_p256_d_matches_known_shape` in `server.rs`
# and `ct_eq_32_basics` in `server/keys.rs`). Same `std` feature
# trick as `//net:tls_test`.
rust_test(
    name = "uni_tls_test",
    size = "small",
    crate = ":uni-tls",
)
