load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/rules:rust.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# TLS 1.3 protocol stack for HTTPS-over-TCP.
#
# After the //net:tls{,_crypto,_handshake,_record} merger, this
# crate owns the FULL TLS implementation: sans-io primitives
# (`schedule`, `aead`, `handshake`, `record`) plus the per-conn
# server state machine. //uni-quic depends on `schedule` / `aead`
# / `handshake` for its TLS-over-CRYPTO-frames driver; HTTPS apps
# use the higher-level `acceptor` / `listen` API.
#
# To enable diagnostic tracing add `--cfg=tls_debug` to rustc_flags
# below. When unset, the trace module compiles to no-op stubs with
# zero runtime cost.
#
# The kernel dep is bare-metal-only: the `#[cfg(tls_debug)]` trace
# module uses `kernel::serial::puts` on `target_os="none"` and
# `libc::write` on hosted targets.
rust_library(
    name = "uni-tls",
    srcs = [
        "src/lib.rs",
        # Sans-io TLS primitives (formerly //net:tls{,_crypto,_handshake,_record})
        "src/aead.rs",
        "src/handshake.rs",
        "src/record.rs",
        "src/schedule.rs",
        # TLS-over-TCP server state machine + helpers.
        "src/handlers.rs",
        "src/keys.rs",
        "src/profile.rs",
        "src/replay.rs",
        "src/server.rs",
        "src/ticket.rs",
        "src/trace.rs",
    ],
    compile_data = [
        "//apps/webserver/dev_certs:dev_cert.der",
        "//apps/webserver/dev_certs:dev_key.der",
    ],
    crate_name = "uni_tls",
    rustc_flags = [
        # `tls_debug` is the opt-in diagnostic-trace cfg. Declaring
        # any `--check-cfg` turns on cfg-checking for the whole
        # crate, which then also requires `test` to be declared —
        # the `#![cfg_attr(not(test), no_std)]` crate attribute and
        # the `#[cfg(test)]` modules both reference it.
        "--check-cfg=cfg(tls_debug)",
        "--check-cfg=cfg(test)",
    ] + select({
        # The aes-gcm AEAD path inlines `__m128i` intrinsics from
        # the `aes` + `polyval` crates into our own `aead.rs`
        # call sites. With `x86_64-unknown-none`'s default
        # `+soft-float`, LLVM has no register class for those
        # vector types and bails with "Do not know how to split
        # the result of this operator!". Apply the same
        # target-feature override the crypto crates already use
        # (cf. `_X86_CRYPTO_FLAG` in MODULE.bazel) to our crate
        # so the inlined SIMD compiles cleanly.
        "//bazel/platforms:x86_64": [
            "-Ctarget-feature=-soft-float,+sse,+sse2,+sse3,+ssse3,+sse4.1,+sse4.2,+avx,+avx2,+aes,+pclmulqdq,+fma,+bmi1,+bmi2",
        ],
        # aarch64-unknown-none defaults to +neon only; FEAT_AES
        # (which provides vmull_p64 / PMULL needed by our 8-way
        # batched GHASH) requires explicit `+aes`. Apple Silicon
        # M-series and every GCE/Ampere ARM host already support
        # it; we just need rustc to surface it as a target_feature
        # cfg so the SIMD path isn't dead-coded.
        "//bazel/platforms:aarch64": [
            "-Ctarget-feature=+neon,+aes",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//uni",
        "//uni-aes-gcm",
        "//uni-http",
        "//uni-iobuf",
        "//uni-worker",
        "@crates//:aes",
        "@crates//:aes-gcm",
        "@crates//:getrandom",
        "@crates//:hkdf",
        "@crates//:hmac",
        "@crates//:p256",
        "@crates//:sha2",
        "@crates//:x25519-dalek",
    ] + select({
        "//bazel/platforms:native": [],
        "//conditions:default": ["//kernel"],
    }),
)

# Host-native unit tests for in-crate `mod tests` blocks (handshake
# parsing, key schedule, AEAD round-trip, record-layer framing,
# ticket envelope, finished-key + ct_eq, etc.).
rust_test(
    name = "uni_tls_test",
    size = "small",
    crate = ":uni-tls",
)
