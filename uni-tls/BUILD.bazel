load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# TLS 1.3. Adapts `//net:tls_server` onto the `uni_http::TlsAdapter`
# boundary — apps that skip this crate link zero TLS / crypto code.
rust_library(
    name = "uni-tls",
    srcs = ["src/lib.rs"],
    crate_name = "uni_tls",
    deps = [
        "//net:tls_server",
        "//uni-http",
    ],
)
